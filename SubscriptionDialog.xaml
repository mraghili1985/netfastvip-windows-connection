<Window x:Class="SmartVpn.SubscriptionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="وضعیت اشتراک"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="./Fonts/#Vazirmatn, Vazirmatn, Segoe UI, Tahoma" FontSize="12.5"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>
        <Style x:Key="DlgLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="DlgBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="6,5"/>
        </Style>
        <Style x:Key="DlgBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- کارت اطلاعات -->
        <Style x:Key="InfoCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="14,12,14,14">
        <!-- عنوان -->
        <TextBlock Text="استعلام زنده وضعیت اشتراک از سرور" FontWeight="Bold" FontSize="13"
                   TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"
                   FlowDirection="RightToLeft" Margin="0,0,0,10"/>

        <!-- ورود -->
        <TextBlock Text="نام کاربری" Style="{StaticResource DlgLabel}" FlowDirection="RightToLeft"/>
        <TextBox x:Name="UserBox" Style="{StaticResource DlgBox}" FlowDirection="LeftToRight"/>
        <TextBlock Text="پسورد" Style="{StaticResource DlgLabel}" FlowDirection="RightToLeft"/>
        <PasswordBox x:Name="PassBox"
                     Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}"
                     BorderBrush="{DynamicResource LineBrush}" CaretBrush="{DynamicResource TextBrush}"
                     Padding="6,5" FlowDirection="LeftToRight"/>

        <Button x:Name="CheckBtn" Content="📊 استعلام وضعیت" IsDefault="True" Click="Check_Click"
                Style="{StaticResource DlgBtn}" Margin="0,12,0,0"
                FlowDirection="RightToLeft"/>

        <CheckBox x:Name="SaveCheck" IsChecked="True" Content="ذخیره یوزر/پس برای همه کانکشن‌های رسمی"
                  FontSize="11" Margin="2,8,0,0" FlowDirection="RightToLeft"
                  Foreground="{DynamicResource SubTextBrush}"/>

        <TextBlock x:Name="StatusText" Margin="0,8,0,0" FontSize="11.5" TextWrapping="Wrap"
                   Foreground="{DynamicResource SubTextBrush}" Visibility="Collapsed"
                   FlowDirection="RightToLeft"/>

        <!-- ===== نتیجه استعلام ===== -->
        <StackPanel x:Name="ResultPanel" Visibility="Collapsed" Margin="0,10,0,0">

            <!-- ردیف اول: چهار کارت افقی -->
            <UniformGrid Columns="4" Rows="1" Margin="0,0,0,6">
                <!-- وضعیت -->
                <Border Style="{StaticResource InfoCard}" Margin="0,0,4,0">
                    <StackPanel>
                        <TextBlock Text="وضعیت" Style="{StaticResource CardLabel}" FlowDirection="RightToLeft"/>
                        <TextBlock x:Name="StatusValue" Style="{StaticResource CardValue}"/>
                    </StackPanel>
                </Border>
                <!-- سرویس -->
                <Border Style="{StaticResource InfoCard}" Margin="2,0,2,0">
                    <StackPanel>
                        <TextBlock Text="سرویس" Style="{StaticResource CardLabel}" FlowDirection="RightToLeft"/>
                        <TextBlock x:Name="GroupValue" Style="{StaticResource CardValue}"/>
                    </StackPanel>
                </Border>
                <!-- انقضا -->
                <Border Style="{StaticResource InfoCard}" Margin="2,0,2,0">
                    <StackPanel>
                        <TextBlock Text="انقضا" Style="{StaticResource CardLabel}" FlowDirection="RightToLeft"/>
                        <TextBlock x:Name="ExpireValue" Style="{StaticResource CardValue}"/>
                    </StackPanel>
                </Border>
                <!-- زمان باقی -->
                <Border Style="{StaticResource InfoCard}" Margin="4,0,0,0">
                    <StackPanel>
                        <TextBlock Text="زمان باقی" Style="{StaticResource CardLabel}" FlowDirection="RightToLeft"/>
                        <TextBlock x:Name="RemainValue" Style="{StaticResource CardValue}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- بخش ترافیک -->
            <Border Style="{StaticResource InfoCard}" Margin="0,0,0,6">
                <StackPanel>
                    <!-- سربرگ حجم -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ترافیک" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" FlowDirection="RightToLeft"/>
                        <TextBlock Grid.Column="1" x:Name="TrafficSummaryText"
                                   FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"
                                   FlowDirection="LeftToRight"/>
                    </Grid>
                    <!-- Progress Bar -->
                    <Border CornerRadius="4" Background="{DynamicResource FieldBrush}" Height="8" Margin="0,0,0,5">
                        <Border x:Name="TrafficBar" CornerRadius="4" HorizontalAlignment="Left"
                                Height="8" Width="0" Background="#22C55E"/>
                    </Border>
                    <!-- زیر بار -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="UsageText" FontSize="10.5"
                                   Foreground="{DynamicResource SubTextBrush}" FlowDirection="RightToLeft"/>
                        <TextBlock Grid.Column="1" x:Name="RemainTrafficText" FontSize="10.5"
                                   Foreground="#22C55E" FlowDirection="LeftToRight"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ردیف دوم: اطلاعات حساب -->
            <Border Style="{StaticResource InfoCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- نام کاربری -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="نام کاربری" Style="{StaticResource CardLabel}" FlowDirection="RightToLeft"/>
                        <TextBlock x:Name="UsernameValue" Style="{StaticResource CardValue}" FontSize="11"/>
                    </StackPanel>
                    <!-- اولین ورود -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="اولین ورود" Style="{StaticResource CardLabel}" FlowDirection="RightToLeft"/>
                        <TextBlock x:Name="FirstLoginValue" Style="{StaticResource CardValue}" FontSize="11"/>
                    </StackPanel>
                    <!-- وضعیت اتصال -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="وضعیت اتصال" Style="{StaticResource CardLabel}" FlowDirection="RightToLeft"/>
                        <TextBlock x:Name="OnlineValue" Style="{StaticResource CardValue}" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>

        <!-- لینک خرید/تمدید -->
        <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="11"
                   Foreground="{DynamicResource SubTextBrush}" FlowDirection="RightToLeft">
            <Run Text="نیاز به تمدید دارید؟"/>
            <Hyperlink Click="Panel_Click" Foreground="#3B82F6" TextDecorations="{x:Null}">
                <Run Text="خرید / تمدید اشتراک"/>
            </Hyperlink>
        </TextBlock>
    </StackPanel>
</Window>
