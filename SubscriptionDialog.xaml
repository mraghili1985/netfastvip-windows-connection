<Window x:Class="SmartVpn.SubscriptionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="وضعیت اشتراک"
        Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FlowDirection="RightToLeft"
        FontFamily="./Fonts/#Vazirmatn, Vazirmatn, Segoe UI, Tahoma" FontSize="12.5"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>
        <!-- استایل‌های محلی — همه رنگ‌ها از براش‌های تمِ برنامه می‌آیند تا در تاریک/روشن درست دیده شوند -->
        <Style x:Key="DlgLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="DlgBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="6,5"/>
        </Style>
        <Style x:Key="DlgBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RowKey" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="RowVal" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16,12,16,14">
        <TextBlock Text="استعلام زنده وضعیت اشتراک از سرور" FontWeight="Bold" FontSize="13.5"
                   TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>

        <TextBlock Text="نام کاربری" Style="{StaticResource DlgLabel}"/>
        <TextBox x:Name="UserBox" Style="{StaticResource DlgBox}"/>
        <TextBlock Text="پسورد" Style="{StaticResource DlgLabel}"/>
        <PasswordBox x:Name="PassBox"
                     Background="{DynamicResource FieldBrush}"
                     Foreground="{DynamicResource TextBrush}"
                     BorderBrush="{DynamicResource LineBrush}"
                     CaretBrush="{DynamicResource TextBrush}"
                     Padding="6,5"/>

        <Button x:Name="CheckBtn" Content="📊 استعلام وضعیت" IsDefault="True" Click="Check_Click"
                Style="{StaticResource DlgBtn}" Margin="0,14,0,0"/>

        <!-- بعد از استعلامِ موفق، یوزر/پس روی همه کانکشن‌های رسمی ذخیره می‌شود -->
        <CheckBox x:Name="SaveCheck" Content="ذخیره این یوزر/پس برای همه کانکشن‌های رسمی"
                  FontSize="11.5" Margin="2,10,0,0"
                  Foreground="{DynamicResource SubTextBrush}"/>

        <TextBlock x:Name="StatusText" Margin="0,10,0,0" FontSize="11.5" TextWrapping="Wrap"
                   Foreground="{DynamicResource SubTextBrush}" Visibility="Collapsed"/>

        <Border x:Name="ResultPanel" Visibility="Collapsed" Margin="0,12,0,0"
                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12,10,12,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="وضعیت اشتراک" Style="{StaticResource RowKey}"/>
                <TextBlock Grid.Row="0" Grid.Column="2" x:Name="StatusValue" Style="{StaticResource RowVal}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="سرویس" Style="{StaticResource RowKey}"/>
                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="GroupValue" Style="{StaticResource RowVal}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="تاریخ انقضا" Style="{StaticResource RowKey}"/>
                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="ExpireValue" Style="{StaticResource RowVal}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="زمان باقی‌مانده" Style="{StaticResource RowKey}"/>
                <TextBlock Grid.Row="3" Grid.Column="2" x:Name="RemainValue" Style="{StaticResource RowVal}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="وضعیت اتصال" Style="{StaticResource RowKey}"/>
                <TextBlock Grid.Row="4" Grid.Column="2" x:Name="OnlineValue" Style="{StaticResource RowVal}"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="حجم کل دوره" Style="{StaticResource RowKey}"/>
                <TextBlock Grid.Row="5" Grid.Column="2" x:Name="TotalValue" Style="{StaticResource RowVal}"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="مصرف دوره" Style="{StaticResource RowKey}"/>
                <TextBlock Grid.Row="6" Grid.Column="2" x:Name="UsageValue" Style="{StaticResource RowVal}"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="حجم باقی‌مانده" Style="{StaticResource RowKey}"/>
                <TextBlock Grid.Row="7" Grid.Column="2" x:Name="LeftValue" Style="{StaticResource RowVal}"/>
            </Grid>
        </Border>

        <!-- لینک خرید/تمدید — همان PanelUrl از config.json -->
        <TextBlock HorizontalAlignment="Center" Margin="0,12,0,0" FontSize="11.5"
                   Foreground="{DynamicResource SubTextBrush}">
            <Run Text="نیاز به تمدید دارید؟"/>
            <Hyperlink Click="Panel_Click" Foreground="#3B82F6" TextDecorations="{x:Null}">
                <Run Text="خرید / تمدید اشتراک"/>
            </Hyperlink>
        </TextBlock>
    </StackPanel>
</Window>
