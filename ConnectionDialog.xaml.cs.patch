// ۱. فیلد _wgConf و _isAmnezia اضافه شه (کنار _ovpnInline)
private string _ovpnInline = "";
private string _wgConf    = "";
private bool   _isAmnezia = false;

// ۲. بارگذاری existing.WireGuardConf در constructor
_ovpnInline = existing.OvpnInline;
_wgConf     = existing.WireGuardConf;
if (_wgConf.Trim().Length > 0)
{
    _isAmnezia = DetectAmnezia(_wgConf);
    WgStatusText.Text = "کانفیگ: بارگذاری شد ✔";
    WgTypeText.Text   = _isAmnezia ? "نوع: AmneziaWG" : "نوع: WireGuard";
}

// ۳. UpdateFieldVisibility — فقط این متد عوض می‌شه
private void UpdateFieldVisibility()
{
    if (StandardPanel is null || WgPanel is null) return;
    var isWg = SelectedType == "wireguard";
    StandardPanel.Visibility = isWg ? Visibility.Collapsed : Visibility.Visible;
    WgPanel.Visibility       = isWg ? Visibility.Visible   : Visibility.Collapsed;
    // داخل StandardPanel:
    if (!isWg)
    {
        OvpnPanel.Visibility = SelectedType == "openvpn" ? Visibility.Visible : Visibility.Collapsed;
        PskPanel.Visibility  = SelectedType == "l2tp"    ? Visibility.Visible : Visibility.Collapsed;
    }
}

// ۴. ImportWgConf_Click
private void ImportWgConf_Click(object sender, RoutedEventArgs e)
{
    var ofd = new OpenFileDialog
    {
        Filter = "WireGuard / AmneziaWG config (*.conf)|*.conf|All files (*.*)|*.*",
        Title  = "انتخاب فایل .conf",
    };
    if (ofd.ShowDialog(this) != true) return;

    string conf;
    try   { conf = File.ReadAllText(ofd.FileName).Replace("\r\n", "\n"); }
    catch { MessageBox.Show(this, "فایل .conf خوانده نشد.", AppConfig.BrandName); return; }

    if (!conf.Contains("[Interface]") || !conf.Contains("[Peer]"))
    { MessageBox.Show(this, "فایل معتبر نیست (باید شامل [Interface] و [Peer] باشد).", AppConfig.BrandName); return; }

    _wgConf    = conf;
    _isAmnezia = DetectAmnezia(conf);

    if (NameBox.Text.Trim().Length == 0)
        NameBox.Text = Path.GetFileNameWithoutExtension(ofd.FileName);

    WgStatusText.Text = $"کانفیگ بارگذاری شد: {Path.GetFileName(ofd.FileName)} ✔";
    WgTypeText.Text   = _isAmnezia ? "نوع شناسایی‌شده: AmneziaWG" : "نوع شناسایی‌شده: WireGuard";
}

// ۵. helper: auto-detect AmneziaWG از روی فیلدهای اختصاصی
private static bool DetectAmnezia(string conf) =>
    conf.Contains("\nJc =") || conf.Contains("\nH1 =") ||
    conf.Contains("\nJmin =") || conf.Contains("# amw");

// ۶. Ok_Click — بخش WireGuard
var isWg = SelectedType == "wireguard";
if (isWg && _wgConf.Trim().Length == 0)
{ MessageBox.Show(this, "فایل .conf بارگذاری نشده.", AppConfig.BrandName); return; }

var p = new ConnectionProfile
{
    Name   = name,
    Type   = isWg ? (_isAmnezia ? "amneziawg" : "wireguard") : SelectedType,
    Server = isWg ? ParseWgEndpoint(_wgConf).host : server,
    Port   = isWg ? ParseWgEndpoint(_wgConf).port : port,
    Proto  = (ProtoCombo.SelectedItem as ComboBoxItem)?.Tag as string ?? "udp",
    Source = _existing?.Source ?? "custom",
    OvpnInline    = SelectedType == "openvpn" ? _ovpnInline : "",
    ServerOverride= SelectedType == "openvpn" ? OverrideBox.Text.Trim() : "",
    WireGuardConf = isWg ? _wgConf : "",
    Username = isWg ? "" : UserBox.Text.Trim(),
    Password = isWg ? "" : PassBox.Password,
    Psk      = isWg ? "" : PskBox.Password,
};

// ۷. ParseWgEndpoint (helper)
private static (string host, int port) ParseWgEndpoint(string conf)
{
    var inPeer = false;
    foreach (var line in conf.Split('\n'))
    {
        var t = line.Trim();
        if (t.Equals("[Peer]", StringComparison.OrdinalIgnoreCase)) { inPeer = true; continue; }
        if (t.StartsWith('[') && inPeer) break;
        if (inPeer && t.StartsWith("Endpoint", StringComparison.OrdinalIgnoreCase))
        {
            var val = t[(t.IndexOf('=') + 1)..].Trim();
            var lastColon = val.LastIndexOf(':');
            if (lastColon > 0)
            {
                var host = val[..lastColon];
                int.TryParse(val[(lastColon + 1)..], out var wgPort);
                return (host, wgPort);
            }
        }
    }
    return ("", 0);
}
