<Window x:Class="SmartVpn.CredentialsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نام کاربری و پسورد"
        Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FlowDirection="RightToLeft"
        FontFamily="./Fonts/#Inter, Inter, ./Fonts/#Vazirmatn, Vazirmatn, Segoe UI, Tahoma" FontSize="12.5"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>
        <!-- استایل‌های محلی — همه رنگ‌ها از براش‌های تمِ برنامه می‌آیند تا در تاریک/روشن درست دیده شوند -->
        <Style x:Key="DlgLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="DlgBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="6,5"/>
        </Style>
        <Style x:Key="DlgBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16,12,16,14">
        <TextBlock x:Name="PromptText" FontWeight="Bold" FontSize="13.5" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextBrush}"/>

        <StackPanel x:Name="CredsPanel">
            <TextBlock Text="نام کاربری" Style="{StaticResource DlgLabel}"/>
            <TextBox x:Name="UserBox" Style="{StaticResource DlgBox}"/>
            <TextBlock Text="پسورد" Style="{StaticResource DlgLabel}"/>
            <PasswordBox x:Name="PassBox"
                         Background="{DynamicResource FieldBrush}"
                         Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource LineBrush}"
                         CaretBrush="{DynamicResource TextBrush}"
                         Padding="6,5"/>
        </StackPanel>

        <StackPanel x:Name="PskPanel" Visibility="Collapsed">
            <TextBlock Text="کلید مشترک (PSK)" Style="{StaticResource DlgLabel}"/>
            <TextBox x:Name="PskBox" Style="{StaticResource DlgBox}"/>
        </StackPanel>

        <CheckBox x:Name="SaveCheck" IsChecked="True" Margin="0,12,0,0"
                  Foreground="{DynamicResource TextBrush}"
                  Content="ذخیره برای اتصال‌های بعدی"/>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="اتصال" IsDefault="True" Click="Ok_Click" Style="{StaticResource DlgBtn}"/>
            <Button Grid.Column="2" Content="انصراف" IsCancel="True" Style="{StaticResource DlgBtn}"/>
        </Grid>

        <!-- لینک خرید/تمدید — برای کاربری که همین‌جا متوجه می‌شود اشتراک ندارد -->
        <TextBlock HorizontalAlignment="Center" Margin="0,12,0,0" FontSize="11.5"
                   Foreground="{DynamicResource SubTextBrush}">
            <Run Text="اشتراک ندارید؟"/>
            <Hyperlink Click="Panel_Click" Foreground="#3B82F6" TextDecorations="{x:Null}">
                <Run Text="بررسی اشتراک - خرید - تمدید"/>
            </Hyperlink>
        </TextBlock>
    </StackPanel>
</Window>
