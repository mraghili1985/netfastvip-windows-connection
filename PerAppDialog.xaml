<Window x:Class="SmartVpn.PerAppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مدیریت برنامه‌ها"
        Width="380" Height="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FlowDirection="RightToLeft"
        FontFamily="./Fonts/#Vazirmatn, Vazirmatn, Segoe UI, Tahoma" FontSize="12.5"
        Background="{DynamicResource BgBrush}">
    <Grid Margin="14,12,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="PerAppTitleText" Text="مدیریت برنامه‌های تونل (Per-App)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" x:Name="PerAppHintText" Text="برنامه‌های زیر بر اساس حالت انتخابی شما تفکیک می‌شوند:" Foreground="{DynamicResource SubTextBrush}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
            <ListBox x:Name="AppList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="2">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Margin="0,2" Padding="8,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="🖥️" FontSize="11.5" Margin="0,0,6,0" VerticalAlignment="Center" Opacity="0.8"/>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11.5" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                </StackPanel>

                                <!-- کلید فعال / غیرفعال -->
                                <Button Grid.Column="1" Tag="{Binding}" Click="BtnToggleActive_Click"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="4,0" Padding="0" ToolTip="کلیک برای فعال یا غیرفعال کردن">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="4" Padding="7,2" BorderThickness="1"
                                                    Background="{Binding StatusBg}" BorderBrush="{Binding StatusBorder}">
                                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusFg}" FontSize="10.5" FontWeight="Bold"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- کلید حذف -->
                                <Button Grid.Column="2" Tag="{Binding}" Click="BtnRemove_Click"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="حذف از لیست" Margin="2,0,0,0" Padding="4,2">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent" CornerRadius="4" Padding="3">
                                                <TextBlock Text="🗑️" FontSize="12" Foreground="#EF4444" Opacity="0.85"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Button Grid.Row="3" x:Name="PerAppAddBtn" Content="➕ افزودن برنامه جدید (.exe)" Click="BtnAdd_Click" Height="34" Margin="0,10,0,0" Cursor="Hand"
                Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}"
                FontSize="11.5" FontWeight="SemiBold">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
