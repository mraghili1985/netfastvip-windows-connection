<Window x:Class="SmartVpn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:TextOptions="clr-namespace:System.Windows.Media;assembly=PresentationCore"
        Title="NETFASTVIP" Width="420" Height="790"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="./Fonts/#Vazirmatn, Vazirmatn, Segoe UI, Tahoma"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style x:Key="DrawerNavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0F172A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="2,14,2,6"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>

        <Style x:Key="ToolTile" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="6,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <LinearGradientBrush x:Key="DlAreaBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#553B82F6" Offset="0"/>
            <GradientStop Color="#003B82F6" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="UlAreaBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#5522C55E" Offset="0"/>
            <GradientStop Color="#0022C55E" Offset="1"/>
        </LinearGradientBrush>

        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="PowerScale" Storyboard.TargetProperty="ScaleX"
                              From="1" To="1.08" Duration="0:0:0.9"/>
            <DoubleAnimation Storyboard.TargetName="PowerScale" Storyboard.TargetProperty="ScaleY"
                              From="1" To="1.08" Duration="0:0:0.9"/>
        </Storyboard>
        <Storyboard x:Key="SpinStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="PowerGlyphRotate" Storyboard.TargetProperty="Angle"
                              From="0" To="360" Duration="0:0:1"/>
        </Storyboard>
        <Storyboard x:Key="SubRefreshSpinStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SubRefreshRotate" Storyboard.TargetProperty="Angle"
                              From="0" To="360" Duration="0:0:0.8"/>
        </Storyboard>
        <Storyboard x:Key="HotspotPulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="HotspotHeaderScale" Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.12" Duration="0:0:0.8"/>
            <DoubleAnimation Storyboard.TargetName="HotspotHeaderScale" Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.12" Duration="0:0:0.8"/>
        </Storyboard>
    </Window.Resources>

    <Border x:Name="WindowSurface" Margin="0"
            Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
            CornerRadius="14" ClipToBounds="True">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="31"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- نوار عنوان داخلی؛ چون بعضی نسخه‌های ویندوز رنگ Native TitleBar را نادیده می‌گیرند،
             کنترل بستن و کمینه‌سازی را خود برنامه در اختیار می‌گیرد. -->
        <Border x:Name="AppTitleBar" Grid.Row="0" Height="31"
                CornerRadius="11,11,0,0" ClipToBounds="True"
                Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="AppTitleBar_MouseLeftButtonDown">
            <Grid FlowDirection="LeftToRight">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,9,0" FlowDirection="LeftToRight">
                    <TextBlock Text="NETFASTVIP" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource SubTextBrush}"
                               VerticalAlignment="Center"/>
                    <Image Source="/app.ico" Width="16" Height="16" Margin="7,0,0,0"
                           Stretch="Uniform" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                    <Button x:Name="TitleCloseButton" Width="38" Height="31"
                            Content="×" FontSize="16" Padding="0"
                            Background="Transparent" Foreground="{DynamicResource SubTextBrush}"
                            BorderThickness="0" Cursor="Hand" ToolTip="بستن"
                            Click="TitleCloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="11,0,0,0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="TitleMinimizeButton" Width="38" Height="31"
                            Content="—" FontSize="14" Padding="0"
                            Background="Transparent" Foreground="{DynamicResource SubTextBrush}"
                            BorderThickness="0" Cursor="Hand" ToolTip="کمینه‌سازی"
                            Click="TitleMinimizeButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale"/>
        </Grid.LayoutTransform>
        <!-- ================= NORMAL MODE ================= -->
        <Grid x:Name="RootGrid" Margin="14,10,14,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Bar: Hamburger + Dashboard title -->
                <RowDefinition Height="*"/>    <!-- Content Panels -->
            </Grid.RowDefinitions>

            <!-- Top Header with Hamburger -->
            <Grid Grid.Row="0" Margin="2,0,2,10">
                <Button x:Name="HamburgerBtn" HorizontalAlignment="Left" Width="38" Height="38" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="HamburgerBtn_Click" ToolTip="منوی اصلی">
                    <Path Data="M4 6h16M4 12h16M4 18h16" Stroke="{DynamicResource TextBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="20" Height="20"/>
                </Button>
                <TextBlock Text="NETFASTVIP DASHBOARD" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,8,0"/>
            </Grid>

            <!-- Hidden stubs to keep C# references safe -->
            <StackPanel Visibility="Collapsed">
                <StackPanel x:Name="HeaderBrandPanel"/>
                <StackPanel x:Name="HeaderPagePanel"/>
                <TextBlock x:Name="HeaderTitleText"/>
                <TextBlock x:Name="BrandTitleText"/>
                <Button x:Name="HeaderPowerBtn"/>
                <Button x:Name="HeaderLogBtn"/>
                <Button x:Name="HeaderHotspotBtn"/>
                <Button x:Name="HeaderToolsBtn"/>
                <Button x:Name="HeaderSettingsBtn"/>
                <TextBlock x:Name="HotspotHeaderIcon"/>
                <Button Visibility="Collapsed">
                    <Button.Effect><DropShadowEffect x:Name="HotspotHeaderGlow"/></Button.Effect>
                    <Button.RenderTransform><ScaleTransform x:Name="HotspotHeaderScale"/></Button.RenderTransform>
                </Button>
            </StackPanel>

            <!-- ================= HOME ================= -->
            <Grid Grid.Row="1" x:Name="HomePanel">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="HomeTransform"/>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Active Connection Card -->
                    <RowDefinition Height="Auto"/> <!-- Segmented Control (VPN / Xray) -->
                    <RowDefinition Height="Auto"/> <!-- Connections Header -->
                    <RowDefinition Height="*"/>    <!-- Connections List -->
                    <RowDefinition Height="Auto"/> <!-- Subscription Summary Card -->
                </Grid.RowDefinitions>

                <!-- Compact connection info card -->
                <Border Grid.Row="0" Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="14,10" ClipToBounds="True">
                    <StackPanel>
                        <!-- Top: power left, connection summary right -->
                        <Grid FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="82"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Button x:Name="PowerBtn" Width="60" Height="60"
                                        Background="#334155" Cursor="Hand" Click="Power_Click"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Button.RenderTransform>
                                        <ScaleTransform x:Name="PowerScale" ScaleX="1" ScaleY="1"/>
                                    </Button.RenderTransform>
                                    <Button.Effect>
                                        <DropShadowEffect Color="#22C55E" BlurRadius="18" ShadowDepth="0" Opacity="0.35"/>
                                    </Button.Effect>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>
                                                <Ellipse Fill="#172131" Stroke="#1F3F3A" StrokeThickness="4"/>
                                                <Ellipse Margin="6" Fill="{TemplateBinding Background}"/>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Path x:Name="PowerGlyph" Width="24" Height="24" Stretch="Uniform"
                                          Data="M 12,2.5 L 12,11.5 M 7.05,5.6 A 8.5,8.5 0 1 0 16.95,5.6"
                                          Stroke="#F8FAFC" StrokeThickness="2.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="PowerGlyphRotate" Angle="0"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </Button>
                                <TextBlock x:Name="PowerHintText" Visibility="Collapsed" Text="Click to Connect" FontSize="10" Margin="0,5,0,0"
                                           Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" x:Name="ActiveConnSummaryPanel" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#64748B" Visibility="Collapsed"
                                             VerticalAlignment="Center" Margin="0,0,0,0"/>
                                    <TextBlock x:Name="StatusText" Text="آماده اتصال" Visibility="Collapsed"/>
                                </StackPanel>
                                <TextBlock x:Name="ActiveConnText" Text="—" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,0"
                                           Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                                    <TextBlock x:Name="ServerSubText" Text="" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" FlowDirection="LeftToRight"/>
                                </StackPanel>
                                <TextBlock x:Name="GeoIpText" Text="—" FontSize="10.5" Margin="0,4,0,0"
                                           Foreground="{DynamicResource SubTextBrush}" FlowDirection="LeftToRight"
                                           HorizontalAlignment="Right"/>
                                <TextBlock x:Name="DurationText" Text="00:00:00" FontSize="11" FontWeight="Bold" Margin="0,5,0,0"
                                           Foreground="#A855F7" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Margin="0,8,0,7" Background="{DynamicResource LineBrush}" Opacity="0.75"/>

                        <Button x:Name="MoreInfoBtn" Click="MoreInfoToggle_Click" Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource SubTextBrush}" Padding="0" Margin="0,5,0,0"
                                Cursor="Hand" HorizontalAlignment="Right" HorizontalContentAlignment="Right" Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                                <TextBlock x:Name="MoreInfoText" Text="Details" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SubTextBrush}" Margin="0,0,4,0"/>
                                <TextBlock x:Name="MoreInfoArrow" Text="⌄" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource SubTextBrush}" Margin="0,-1,0,0"/>
                            </StackPanel>
                        </Button>

                        <Border x:Name="MoreInfoPanel" Visibility="Collapsed" Padding="0,7,0,0">
                            <StackPanel>
                                <Border Background="{DynamicResource BgBrush}" CornerRadius="7"
                                        Padding="4" ClipToBounds="True" Margin="0,0,0,10">
                                    <Grid Height="58">
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Opacity="0.35"/>
                                        <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Opacity="0.35"/>
                                        <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Opacity="0.35"/>
                                        <Canvas x:Name="GraphCanvas" Grid.RowSpan="4" FlowDirection="LeftToRight">
                                            <Polygon x:Name="DlArea" Fill="{StaticResource DlAreaBrush}"/>
                                            <Polygon x:Name="UlArea" Fill="{StaticResource UlAreaBrush}"/>
                                            <Polyline x:Name="DlLine" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8"/>
                                            <Polyline x:Name="UlLine" Stroke="#22C55E" StrokeThickness="1.5"/>
                                        </Canvas>
                                        <Border Grid.RowSpan="4" HorizontalAlignment="Left" VerticalAlignment="Bottom" CornerRadius="4" Padding="4,1"
                                                Background="#CC030A16" Margin="1,0,0,1">
                                            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                                                <TextBlock x:Name="DlSpeedText" Text="↓ 0 B/s" FontSize="9" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="UlSpeedText" Text="↑ 0 B/s" FontSize="9" FontWeight="Bold" Foreground="#22C55E"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            <UniformGrid Columns="2" Rows="3" FlowDirection="LeftToRight">
                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="9,7" Margin="0,0,5,5">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Ping" FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                                        <TextBlock Grid.Column="1" x:Name="PingText" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="#22C55E" FlowDirection="LeftToRight"/>
                                    </Grid>
                                </Border>
                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="9,7" Margin="5,0,0,5">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Session" FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                                        <TextBlock Grid.Column="1" x:Name="SessionTrafficText" Text="0 B" FontSize="11" FontWeight="SemiBold" Foreground="#3B82F6" FlowDirection="LeftToRight"/>
                                    </Grid>
                                </Border>
                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="9,7" Margin="0,5,5,5">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Tunnel IP" FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                                        <TextBlock Grid.Column="1" x:Name="PrivateIpText" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" FlowDirection="LeftToRight"
                                                   Cursor="Hand" ToolTip="برای کپی کلیک کنید" MouseLeftButtonDown="CopyIpText_Click"/>
                                    </Grid>
                                </Border>
                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="9,7" Margin="5,5,0,5">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Server IP" FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                                        <TextBlock Grid.Column="1" x:Name="ServerIpText" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" FlowDirection="LeftToRight"
                                                   Cursor="Hand" ToolTip="برای کپی کلیک کنید" MouseLeftButtonDown="CopyIpText_Click"/>
                                    </Grid>
                                </Border>
                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="9,7" Margin="0,5,5,0">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="YouLbl" Text="User" FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                                        <TextBlock Grid.Column="1" x:Name="YouText" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" FlowDirection="LeftToRight"/>
                                    </Grid>
                                </Border>
                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="9,7" Margin="5,5,0,0">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="ProtocolLbl" Text="Protocol" FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                                        <TextBlock Grid.Column="1" x:Name="ProtocolText" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" FlowDirection="LeftToRight"/>
                                    </Grid>
                                </Border>
                            </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Segmented Control for VPN / Xray -->
                <Border Grid.Row="1" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="3" Margin="2,12,2,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="HomeSwitchToVpnBtn" Content="VPN (سنتی)" Click="SwitchToVpnBtn_Click" Background="#3B82F6" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="0,8" FontSize="12.5" FontWeight="SemiBold" Style="{StaticResource ActionBtn}"/>
                        <Button Grid.Column="1" x:Name="HomeSwitchToXrayBtn" Content="Xray (پروکسی)" Click="SwitchToXrayBtn_Click" Background="Transparent" Foreground="{DynamicResource SubTextBrush}" BorderThickness="0" Cursor="Hand" Padding="0,8" FontSize="12.5" FontWeight="SemiBold" Style="{StaticResource ActionBtn}"/>
                    </Grid>
                </Border>

                <!-- Connections header -->
                <Grid Grid.Row="2" Margin="2,4,2,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="ConnSectionLabel" Text="کانکشن‌ها" FontWeight="Bold" FontSize="13"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">

                        <Button x:Name="AddBtn" Content="＋ Add" Style="{StaticResource ActionBtn}" FontSize="10.5" FontWeight="Bold"
                                Padding="9,3" Margin="0,0,8,0" Foreground="White" Background="#3B82F6" BorderBrush="#3B82F6"
                                ToolTip="افزودن کانکشن جدید" Click="Add_Click"/>
                        <Button x:Name="FilterDropdownBtn" Style="{StaticResource ActionBtn}" FontSize="10.5" Padding="9,3" Click="FilterDropdownBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="FilterDropdownLabel" Text="همه" FontSize="10.5"/>
                                <TextBlock Text=" ⌄" FontSize="10" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Connections list -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ConnList" Margin="0,4,0,10"/>
                </ScrollViewer>

                <!-- کارت خلاصه اشتراک -->
                <Border Grid.Row="4" x:Name="SubSummaryCard"
                        Background="{DynamicResource RowCardBrush}" BorderBrush="{DynamicResource RowLineBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="9,7" Margin="2,8,2,2">
                    <StackPanel>
                        <Grid FlowDirection="LeftToRight" Cursor="Hand" ToolTip="مشاهده / استعلام وضعیت اشتراک" MouseLeftButtonUp="SubSummaryCard_Click">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" x:Name="SubRefreshBtn" Width="28" Height="28" Padding="0"
                                    VerticalAlignment="Center" Style="{StaticResource ActionBtn}" Visibility="Collapsed"
                                    ToolTip="بروزرسانی وضعیت اشتراک" Click="SubRefreshBtn_Click">
                                <TextBlock Text="🔄" FontSize="12" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform x:Name="SubRefreshRotate" Angle="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Button>

                            <StackPanel Grid.Column="1" x:Name="SubSummaryPanel" VerticalAlignment="Center" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock x:Name="SubSectionLabel" Text="🎫 اشتراک من" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Border x:Name="SubActiveBadge" Background="Transparent"
                                            Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="SubActiveDot" Width="5" Height="5" Fill="#22C55E"
                                                     VerticalAlignment="Center" Margin="0,0,3,0"/>
                                            <TextBlock x:Name="SubActiveText" Text="فعال" FontSize="8.5" FontWeight="Normal"
                                                       Foreground="{DynamicResource SubTextBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="SubEmptyText" Text="برای مشاهده وضعیت اشتراک کلیک کنید" FontSize="9.5"
                                           Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0"
                                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>

                        <Border x:Name="SubDetailPanel" Visibility="Collapsed" Padding="0,8,0,0">
                            <StackPanel FlowDirection="LeftToRight">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock x:Name="SubTimeLbl" Text="⏳ زمان باقی‌مانده" FontSize="9"
                                                   Foreground="{DynamicResource SubTextBrush}"
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="SubTimeLeftText" Text="—" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}" Margin="0,2,0,0"
                                                   FlowDirection="LeftToRight" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock x:Name="SubDataLbl" Text="📦 حجم باقی‌مانده" FontSize="9"
                                                   Foreground="{DynamicResource SubTextBrush}"
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="SubDataLeftText" Text="—" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}" Margin="0,2,0,0"
                                                   FlowDirection="LeftToRight" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="SubUpdatedText" Text="—" FontSize="8.5" Margin="0,7,0,0"
                                           Foreground="{DynamicResource SubTextBrush}"
                                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

                                    <!-- ================= XRAY CORE PANEL ================= -->
            <Grid Grid.Row="1" x:Name="XrayPanel" Visibility="Collapsed" Margin="2,0">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="XrayTransform"/>
                </Grid.RenderTransform>
                <Grid.Resources>
                    <Style x:Key="TopBarIcon" TargetType="Button">
                        <Setter Property="Background" Value="#1E293B"/>
                        <Setter Property="Foreground" Value="#94A3B8"/>
                        <Setter Property="Width" Value="32"/>
                        <Setter Property="Height" Value="32"/>
                        <Setter Property="Margin" Value="0,0,8,0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontFamily="Segoe UI Symbol"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style x:Key="PowerButton" TargetType="Button">
                        <Setter Property="Background" Value="#1E293B"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="35" Width="70" Height="70" BorderThickness="4" BorderBrush="#0F172A">
                                        <TextBlock Text="⏻" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style x:Key="ProxyCard" TargetType="ListBoxItem">
                        <Setter Property="Background" Value="#151E32"/>
                        <Setter Property="BorderBrush" Value="#1E293B"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1E293B"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#1E3A8A"/>
                                            <Setter Property="BorderBrush" Value="#3B82F6"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Grid.Resources>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Active Connection Card -->
                    <RowDefinition Height="Auto"/> <!-- Segmented Control -->
                    <RowDefinition Height="Auto"/> <!-- Section Title & Actions -->
                    <RowDefinition Height="*"/>    <!-- Server List & Groups -->
                    <RowDefinition Height="Auto"/> <!-- Subscription Footer -->
                </Grid.RowDefinitions>

                <!-- 1. Active Connection Card (Unified with Home) -->
                <Border Grid.Row="0" Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="14,10" ClipToBounds="True">
                    <StackPanel>
                        <Grid FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="82"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Button x:Name="XrayBtnPower" Width="60" Height="60"
                                        Background="#334155" Cursor="Hand" Click="XrayBtnPower_Click"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Button.RenderTransform>
                                        <ScaleTransform x:Name="XrayPowerScale" ScaleX="1" ScaleY="1"/>
                                    </Button.RenderTransform>
                                    <Button.Effect>
                                        <DropShadowEffect Color="#22C55E" BlurRadius="18" ShadowDepth="0" Opacity="0.35"/>
                                    </Button.Effect>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>
                                                <Ellipse Fill="#172131" Stroke="#1F3F3A" StrokeThickness="4"/>
                                                <Ellipse Margin="6" Fill="{TemplateBinding Background}"/>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Path x:Name="XrayPowerGlyph" Width="24" Height="24" Stretch="Uniform"
                                          Data="M 12,2.5 L 12,11.5 M 7.05,5.6 A 8.5,8.5 0 1 0 16.95,5.6"
                                          Stroke="#F8FAFC" StrokeThickness="2.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="XrayPowerGlyphRotate" Angle="0"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </Button>
                                <TextBlock x:Name="XrayPowerHintText" Visibility="Collapsed" Text="Click to Connect" FontSize="10" Margin="0,5,0,0"
                                           Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" x:Name="XrayActiveConnSummaryPanel" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Ellipse x:Name="XrayStatusDot" Width="9" Height="9" Fill="#64748B" Visibility="Collapsed"
                                             VerticalAlignment="Center" Margin="0,0,0,0"/>
                                    <TextBlock x:Name="XrayStatusText" Text="آماده اتصال" Visibility="Collapsed"/>
                                </StackPanel>
                                <TextBlock x:Name="XrayTxtActiveName" Text="یک کانکشن انتخاب کنید" FontSize="13" FontWeight="Bold" Margin="0,0,0,0"
                                           Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                                    <TextBlock x:Name="XrayTxtActiveProtocol" Text="" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" FlowDirection="LeftToRight"/>
                                </StackPanel>
                                <TextBlock x:Name="XrayTxtActiveGeoIP" Text="—" FontSize="10.5" Margin="0,4,0,0"
                                           Foreground="{DynamicResource SubTextBrush}" FlowDirection="LeftToRight"
                                           HorizontalAlignment="Right"/>
                                <TextBlock x:Name="XrayTxtDuration" Text="00:00:00" FontSize="11" FontWeight="Bold" Margin="0,5,0,0"
                                           Foreground="#A855F7" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Margin="0,8,0,7" Background="{DynamicResource LineBrush}" Opacity="0.75"/>

                        <Button x:Name="XrayMoreInfoBtn" Visibility="Visible" Click="XrayMoreInfoToggle_Click" Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource SubTextBrush}" Padding="0" Margin="0,5,0,0"
                                Cursor="Hand" HorizontalAlignment="Right" HorizontalContentAlignment="Right" Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="XrayMoreInfoText" Text="جزئیات اتصال" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SubTextBrush}" Margin="0,0,4,0"/>
                                <TextBlock x:Name="XrayMoreInfoArrow" Text="⌄" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource SubTextBrush}" Margin="0,-1,0,0"/>
                            </StackPanel>
                        </Button>

                        <Border x:Name="XrayMoreInfoPanel" Visibility="Collapsed" Padding="0,7,0,0">
                            <StackPanel>
                                <Border Background="{DynamicResource BgBrush}" CornerRadius="7"
                                        Padding="4" ClipToBounds="True" Margin="0,0,0,10">
                                    <Grid Height="58">
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Opacity="0.35"/>
                                        <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Opacity="0.35"/>
                                        <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Opacity="0.35"/>
                                        <Canvas x:Name="XrayGraphCanvas" Grid.RowSpan="4" FlowDirection="LeftToRight">
                                            <Polygon x:Name="XrayDlArea" Fill="{StaticResource DlAreaBrush}"/>
                                            <Polygon x:Name="XrayUlArea" Fill="{StaticResource UlAreaBrush}"/>
                                            <Polyline x:Name="XrayDlLine" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8"/>
                                            <Polyline x:Name="XrayUlLine" Stroke="#22C55E" StrokeThickness="1.5"/>
                                        </Canvas>
                                        <Border Grid.RowSpan="4" HorizontalAlignment="Left" VerticalAlignment="Bottom" CornerRadius="4" Padding="4,1"
                                                Background="#CC030A16" Margin="1,0,0,1">
                                            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                                                <TextBlock x:Name="XrayDlSpeedText" Text="↓ 0 B/s" FontSize="9" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="XrayUlSpeedText" Text="↑ 0 B/s" FontSize="9" FontWeight="Bold" Foreground="#22C55E"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <UniformGrid Columns="2" Rows="3" FlowDirection="LeftToRight">
                                    <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="9,7" Margin="0,0,5,5">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Ping" FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                                            <TextBlock Grid.Column="1" x:Name="XrayPingText" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="#22C55E" FlowDirection="LeftToRight"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="9,7" Margin="5,0,0,5">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Session" FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                                            <TextBlock Grid.Column="1" x:Name="XraySessionTrafficText" Text="0 B" FontSize="11" FontWeight="SemiBold" Foreground="#3B82F6" FlowDirection="LeftToRight"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="9,7" Margin="0,5,5,5">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Tunnel IP" FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                                            <TextBlock Grid.Column="1" x:Name="XrayPrivateIpText" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" FlowDirection="LeftToRight"
                                                       Cursor="Hand" ToolTip="برای کپی کلیک کنید" MouseLeftButtonDown="CopyIpText_Click"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="9,7" Margin="5,5,0,5">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Server IP" FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                                            <TextBlock Grid.Column="1" x:Name="XrayServerIpText" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" FlowDirection="LeftToRight"
                                                       Cursor="Hand" ToolTip="برای کپی کلیک کنید" MouseLeftButtonDown="CopyIpText_Click"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="9,7" Margin="0,5,5,0">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" x:Name="XrayYouLbl" Text="User" FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                                            <TextBlock Grid.Column="1" x:Name="XrayYouText" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" FlowDirection="LeftToRight"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="9,7" Margin="5,5,0,0">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" x:Name="XrayProtocolLbl" Text="Protocol" FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                                            <TextBlock Grid.Column="1" x:Name="XrayProtocolText" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" FlowDirection="LeftToRight"/>
                                        </Grid>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 2. Segmented Control for VPN / Xray -->
                <Border Grid.Row="1" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="3" Margin="2,12,2,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="XraySwitchToVpnBtn" Content="VPN (سنتی)" Click="SwitchToVpnBtn_Click" Background="Transparent" Foreground="{DynamicResource SubTextBrush}" BorderThickness="0" Cursor="Hand" Padding="0,8" FontSize="12.5" FontWeight="SemiBold" Style="{StaticResource ActionBtn}"/>
                        <Button Grid.Column="1" x:Name="XraySwitchToXrayBtn" Content="Xray (پروکسی)" Click="SwitchToXrayBtn_Click" Background="#3B82F6" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="0,8" FontSize="12.5" FontWeight="SemiBold" Style="{StaticResource ActionBtn}"/>
                    </Grid>
                </Border>

                <!-- Section title & Action Toolbar -->
                <Grid Grid.Row="2" Margin="2,4,2,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="XrayConnSectionLabel" Text="کانکشن‌ها" FontWeight="Bold" FontSize="13"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="XrayAddSubBtn" Content="＋ Add Subscription" Style="{StaticResource ActionBtn}" FontSize="10.5" FontWeight="Bold"
                                Padding="9,3" Margin="0,0,8,0" Foreground="White" Background="#3B82F6" BorderBrush="#3B82F6"
                                ToolTip="افزودن لینک سابسکریپشن جدید" Click="XrayAddSub_Click"/>
                        <Button x:Name="XrayUpdateSubBtn" Style="{StaticResource ActionBtn}" FontSize="10.5" Padding="9,3" Margin="0,0,8,0"
                                ToolTip="بروزرسانی وضعیت اشتراک و سرورها" Click="XrayUpdateSub_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" FontSize="10.5"/>
                                <TextBlock x:Name="XrayUpdateSubLabel" Text=" بروزرسانی" FontSize="10.5" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="XrayPingAllBtn" Style="{StaticResource ActionBtn}" FontSize="10.5" Padding="9,3" Margin="0,0,8,0"
                                ToolTip="تست پینگ همه سرورها" Click="XrayPingAll_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" FontSize="10.5"/>
                                <TextBlock x:Name="XrayPingAllLabel" Text=" پینگ همه" FontSize="10.5" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="XrayClearServersBtn" Style="{StaticResource ActionBtn}" FontSize="10.5" Padding="9,3"
                                ToolTip="حذف سرورها" Click="XrayClearServers_Click">
                            <TextBlock Text="🗑️" FontSize="10.5"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 3. Connections & Subscription Groups list -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="XrayConnList" Margin="0,4,0,10"/>
                </ScrollViewer>

                <!-- Hidden ListBox for legacy/fallback references if needed -->
                <ListBox x:Name="XrayProxyList" Visibility="Collapsed"/>

                <!-- 4. کارت خلاصه اشتراک Xray (طراحی کاملاً یکپارچه با تب وی‌پی‌ان) -->
                <Border Grid.Row="4" x:Name="XraySubSummaryCard"
                        Background="{DynamicResource RowCardBrush}" BorderBrush="{DynamicResource RowLineBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="9,7" Margin="2,8,2,2">
                    <StackPanel>
                        <Grid FlowDirection="LeftToRight" Cursor="Hand" ToolTip="مشاهده / استعلام وضعیت اشتراک" MouseLeftButtonUp="XraySubSummaryCard_Click">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" x:Name="XraySubRefreshBtn" Width="28" Height="28" Padding="0"
                                    VerticalAlignment="Center" Style="{StaticResource ActionBtn}"
                                    ToolTip="بروزرسانی وضعیت اشتراک" Click="XrayUpdateSub_Click">
                                <TextBlock Text="🔄" FontSize="12" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform x:Name="XraySubRefreshRotate" Angle="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Button>

                            <StackPanel Grid.Column="1" x:Name="XraySubSummaryPanel" VerticalAlignment="Center" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock x:Name="XraySubSectionLabel" Text="🎫 اشتراک من" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Border x:Name="XraySubActiveBadge" Background="Transparent"
                                            Margin="0,0,6,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="XraySubActiveDot" Width="5" Height="5" Fill="#22C55E"
                                                     VerticalAlignment="Center" Margin="0,0,3,0"/>
                                            <TextBlock x:Name="XraySubActiveText" Text="فعال" FontSize="8.5" FontWeight="Normal"
                                                       Foreground="{DynamicResource SubTextBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="XraySubEmptyText" Text="برای مشاهده وضعیت اشتراک کلیک کنید" FontSize="9.5"
                                           Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0"
                                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>

                        <Border x:Name="XraySubDetailPanel" Visibility="Visible" Padding="0,8,0,0">
                            <StackPanel FlowDirection="LeftToRight">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock x:Name="XraySubTimeLbl" Text="⏳ زمان باقی‌مانده" FontSize="9"
                                                   Foreground="{DynamicResource SubTextBrush}"
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="XraySubTimeLeftText" Text="—" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}" Margin="0,2,0,0"
                                                   FlowDirection="LeftToRight" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock x:Name="XraySubDataLbl" Text="📦 حجم باقی‌مانده" FontSize="9"
                                                   Foreground="{DynamicResource SubTextBrush}"
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="XraySubDataLeftText" Text="—" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}" Margin="0,2,0,0"
                                                   FlowDirection="LeftToRight" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="XraySubUpdatedText" Text="—" FontSize="8.5" Margin="0,7,0,0"
                                           Foreground="{DynamicResource SubTextBrush}"
                                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= TOOLBOX + LOG ================= -->
            <DockPanel Grid.Row="1" x:Name="ToolboxPanel" Visibility="Collapsed"
                       Margin="2,0" LastChildFill="True">
                <DockPanel.RenderTransform>
                    <TranslateTransform x:Name="ToolsTransform"/>
                </DockPanel.RenderTransform>
                    <TextBlock DockPanel.Dock="Top" x:Name="ToolboxTitle" Text="🧰 جعبه‌ابزار و عیب‌یابی شبکه" Style="{StaticResource SectionTitle}"/>
                    
                    <Button DockPanel.Dock="Top" x:Name="SpeedTestBtn" Style="{StaticResource ToolTile}" Click="SpeedTest_Click"
                            Margin="3,3,3,1" Padding="6,9"
                            ToolTip="اندازه‌گیری پینگ، جیتر و سرعت دانلود/آپلود">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚀" FontSize="15" Foreground="#22C55E" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SpeedTestLbl" Text="تست سرعت اتصال" FontSize="11.5" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                    </Button>

                    <UniformGrid DockPanel.Dock="Top" Columns="2" Rows="3">
                        <Button x:Name="RenewIpBtn" Style="{StaticResource ToolTile}" Click="RenewIp_Click"
                                ToolTip="وقتی شبکه وصل است ولی اینترنت ندارید">
                            <StackPanel>
                                <TextBlock Text="🔄" FontSize="15" HorizontalAlignment="Center" Foreground="#3B82F6"/>
                                <TextBlock x:Name="RenewIpLbl" Text="تمدید IP" FontSize="10.5" Margin="0,3,0,0" HorizontalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="FlushDnsBtn" Style="{StaticResource ToolTile}" Click="FlushDns_Click"
                                ToolTip="وقتی بعد از تغییر VPN سایت‌ها باز نمی‌شوند">
                            <StackPanel>
                                <TextBlock Text="🧹" FontSize="15" HorizontalAlignment="Center" Foreground="#F59E0B"/>
                                <TextBlock x:Name="FlushDnsLbl" Text="پاک‌سازی DNS" FontSize="10.5" Margin="0,3,0,0" HorizontalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ProxyOffBtn" Style="{StaticResource ToolTile}" Click="ProxyOff_Click"
                                ToolTip="وقتی پراکسی قدیمی، مرورگر را خراب کرده است">
                            <StackPanel>
                                <TextBlock Text="🚫" FontSize="15" HorizontalAlignment="Center" Foreground="#6366F1"/>
                                <TextBlock x:Name="DisableProxyLbl" Text="غیرفعال‌کردن پراکسی" FontSize="10.5" Margin="0,3,0,0" HorizontalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="KillProcBtn" Style="{StaticResource ToolTile}" Click="KillProc_Click"
                                ToolTip="وقتی اتصال قبلی گیر کرده و قطع نمی‌شود">
                            <StackPanel>
                                <TextBlock Text="⛔" FontSize="15" HorizontalAlignment="Center" Foreground="#EF4444"/>
                                <TextBlock x:Name="KillProcLbl" Text="بستن پروسه‌های گیرکرده" FontSize="10.5" Margin="0,3,0,0" HorizontalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="DnsLeakTestBtn" Style="{StaticResource ToolTile}" Click="DnsLeakTest_Click"
                                ToolTip="بررسی اینکه DNS شما هم از داخل تانل رد می‌شود یا نشت دارد">
                            <StackPanel>
                                <TextBlock Text="🧪" FontSize="15" HorizontalAlignment="Center" Foreground="#14B8A6"/>
                                <TextBlock x:Name="DnsLeakLbl" Text="تست نشتی DNS" FontSize="10.5" Margin="0,3,0,0" HorizontalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ResetAdapterBtn" Style="{StaticResource ToolTile}" Click="ResetAdapter_Click"
                                ToolTip="غیرفعال و فعال‌کردن کارت شبکه">
                            <StackPanel>
                                <TextBlock Text="🔁" FontSize="15" HorizontalAlignment="Center" Foreground="#F43F5E"/>
                                <TextBlock x:Name="ResetAdapterLbl" Text="ریست آداپتور" FontSize="10.5" Margin="0,3,0,0" HorizontalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <TextBlock DockPanel.Dock="Top" x:Name="PingTraceLbl" Text="🏓 پینگ / Traceroute" Style="{StaticResource SectionTitle}"/>
                    <TextBox DockPanel.Dock="Top" x:Name="ToolTargetBox" Height="30" Margin="0,0,0,6"
                             FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="12"
                             VerticalContentAlignment="Center"
                             Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                             ToolTip="هدف دلخواه (IP یا دامنه)"/>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="PingToggleBtn" Content="🏓 شروع پینگ"
                                Style="{StaticResource ActionBtn}" Click="PingToggle_Click"/>
                        <Button Grid.Column="2" x:Name="TracerouteToggleBtn" Content="🛰 شروع Traceroute"
                                Style="{StaticResource ActionBtn}" Click="TracerouteToggle_Click"/>
                    </Grid>

                    <Grid DockPanel.Dock="Top" Margin="0,10,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="LogSectionLbl" Text="📜 گزارش" Style="{StaticResource SectionTitle}" Margin="0"/>
                        <Button Grid.Column="1" x:Name="ClearLogBtn" Content="🗑 پاک‌سازی" Style="{StaticResource ActionBtn}" Padding="8,4" Click="ClearLog_Click"/>
                    </Grid>
                    <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" Margin="0,0,0,4"
                             VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight"
                             FontFamily="Consolas" FontSize="11"
                             Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"/>
            </DockPanel>

            <!-- ================= SETTINGS ================= -->
            <ScrollViewer Grid.Row="1" x:Name="SettingsPanel" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <ScrollViewer.RenderTransform>
                    <TranslateTransform x:Name="SettingsTransform"/>
                </ScrollViewer.RenderTransform>
                <StackPanel Margin="2,0">
                    <Expander x:Name="AppearanceExpander" Header="🎨 ظاهر برنامه" IsExpanded="True"
                              Margin="0,4,0,6" Padding="8" Foreground="{DynamicResource TextBrush}"
                              Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
                              BorderThickness="1">
                        <StackPanel Margin="2,8,2,2">
                            <TextBlock x:Name="LangLabel" Text="زبان برنامه" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="LangFaRb" GroupName="Language" Content="فارسی" Margin="0,0,14,0" Checked="LangRb_Click"/>
                                <RadioButton x:Name="LangEnRb" GroupName="Language" Content="English" Checked="LangRb_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="ThemeLabel" Text="تم برنامه" Foreground="{DynamicResource SubTextBrush}" Margin="0,12,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ThemeDarkRb" GroupName="Theme" Content="تیره" Margin="0,0,14,0" Checked="ThemeRb_Click"/>
                                <RadioButton x:Name="ThemeLightRb" GroupName="Theme" Content="روشن" Margin="0,0,14,0" Checked="ThemeRb_Click"/>
                                <RadioButton x:Name="ThemeSystemRb" GroupName="Theme" Content="سیستم" Checked="ThemeRb_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="BehaviorExpander" Header="⚙ رفتار اتصال" Margin="0,0,0,6" Padding="8"
                              Foreground="{DynamicResource TextBrush}" Background="{DynamicResource CardBrush}"
                              BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                        <StackPanel Margin="2,8,2,2">
                            <CheckBox x:Name="SmartToggle" Content="اتصال هوشمند (امتحان خودکار همه کانکشن‌ها)"
                                      Checked="SmartToggle_Changed" Unchecked="SmartToggle_Changed"/>
                            <CheckBox x:Name="TrayToggle" Content="مخفی‌شدن در کنار ساعت به‌جای بستن"
                                      Checked="TrayToggle_Changed" Unchecked="TrayToggle_Changed" Margin="0,5,0,0"/>
                            <CheckBox x:Name="KillSwitchToggle" Content="Kill Switch" Margin="0,5,0,0"
                                      Checked="KillSwitchToggle_Changed" Unchecked="KillSwitchToggle_Changed"/>
                            <CheckBox x:Name="StartupToggle" Content="اجرای خودکار با ویندوز"
                                      Checked="StartupToggle_Changed" Unchecked="StartupToggle_Changed" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="IdleExpander" Header="⏱ قطع خودکار در بی‌استفادگی" Margin="0,0,0,6" Padding="8"
                              Foreground="{DynamicResource TextBrush}" Background="{DynamicResource CardBrush}"
                              BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                        <StackPanel Margin="2,8,2,2">
                            <RadioButton x:Name="IdleOffRb" GroupName="IdleMode" Content="همیشه متصل" Checked="IdleRb_Checked"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <RadioButton x:Name="IdleOnRb" GroupName="IdleMode" Content="قطع بعد از" VerticalAlignment="Center" Checked="IdleRb_Checked"/>
                                <TextBox x:Name="IdleMinutesBox" Width="52" Height="26" Margin="8,0,6,0"
                                         FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="12"
                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                         Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                         LostFocus="IdleMinutes_LostFocus"/>
                                <TextBlock x:Name="IdleMinutesLabel" Text="دقیقه بی‌استفادگی" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="SplitExpander" Header="تونل برنامه‌ها — Per-App (مخصوص Xray / پروکسی)" Margin="0,0,0,6" Padding="8"
                              Foreground="{DynamicResource TextBrush}" Background="{DynamicResource CardBrush}"
                              BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                        <StackPanel Margin="2,8,2,2">
                            <RadioButton x:Name="StOffRb" GroupName="StMode" Tag="off"
                                         Content="تونل کل سیستم (همه برنامه‌ها)" Checked="StMode_Checked"/>
                            <RadioButton x:Name="StAllowRb" GroupName="StMode" Tag="allow"
                                         Content="فقط برنامه‌های لیست (Allow)" Checked="StMode_Checked" Margin="0,5,0,0"/>
                            <RadioButton x:Name="StDenyRb" GroupName="StMode" Tag="deny"
                                         Content="همه به جز برنامه‌های لیست (Bypass)" Checked="StMode_Checked" Margin="0,5,0,0"/>
                            <Button x:Name="BtnManagePerApp" Content="⚙️ مدیریت لیست برنامه‌ها" Click="BtnManagePerApp_Click"
                                    Margin="0,10,0,2" Padding="0,8" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="DnsExpander" Header="🌐 DNS" Margin="0,0,0,6" Padding="8"
                              Foreground="{DynamicResource TextBrush}" Background="{DynamicResource CardBrush}"
                              BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                        <StackPanel Margin="2,8,2,2">
                            <RadioButton x:Name="DnsAutoRb" GroupName="DnsMode" Tag="auto" Content="خودکار" Checked="DnsRb_Checked"/>
                            <RadioButton x:Name="DnsCfRb" GroupName="DnsMode" Tag="cloudflare" Content="Cloudflare — 1.1.1.1" Checked="DnsRb_Checked" Margin="0,5,0,0"/>
                            <RadioButton x:Name="DnsGoogleRb" GroupName="DnsMode" Tag="google" Content="Google — 8.8.8.8" Checked="DnsRb_Checked" Margin="0,5,0,0"/>
                            <RadioButton x:Name="DnsAdguardRb" GroupName="DnsMode" Tag="adguard" Content="AdGuard — 94.140.14.14 (مسدودساز تبلیغات)" Checked="DnsRb_Checked" Margin="0,5,0,0"/>
                            <RadioButton x:Name="DnsAdguardFamilyRb" GroupName="DnsMode" Tag="adguard_family" Content="AdGuard Family — 94.140.14.15 (امنیت خانواده)" Checked="DnsRb_Checked" Margin="0,5,0,0"/>
                            <RadioButton x:Name="DnsCustomRb" GroupName="DnsMode" Tag="custom" Content="دلخواه" Checked="DnsRb_Checked" Margin="0,5,0,0"/>
                            <Grid Margin="0,8,0,2" FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="DnsPrimaryBox" Height="30" FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Center"
                                         Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" LostFocus="DnsBox_LostFocus"/>
                                <TextBox Grid.Column="2" x:Name="DnsSecondaryBox" Height="30" FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Center"
                                         Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" LostFocus="DnsBox_LostFocus"/>
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="PackageExpander" Header="📦 پکیج و پیکربندی" Margin="0,0,0,6" Padding="8"
                              Foreground="{DynamicResource TextBrush}" Background="{DynamicResource CardBrush}"
                              BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                        <StackPanel Margin="2,8,2,2">
                            <Button x:Name="UpdateBaseBtn" Content="🔧 به‌روزرسانی base.ovpn از فایل" Style="{StaticResource ActionBtn}" Margin="0,4" Click="UpdateBase_Click"/>
                            <Button x:Name="ImportBtn" Content="📥 ایمپورت پکیج / فایل ovpn" Style="{StaticResource ActionBtn}" Margin="0,4" Click="Import_Click"/>
                            <Button x:Name="ExportBtn" Content="📤 اکسپورت / بک‌اپ کانکشن‌ها" Style="{StaticResource ActionBtn}" Margin="0,4" Click="Export_Click"/>
                            <Button x:Name="AboutBtn" Content="ℹ درباره برنامه و اشتراک" Style="{StaticResource ActionBtn}" Margin="0,14,0,6" Click="About_Click"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= CONNECTION LOG ================= -->
            <Grid Grid.Row="1" x:Name="ConnLogPanel" Visibility="Collapsed" Margin="2,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ConnLogTransform"/>
                </Grid.RenderTransform>
                <Grid Grid.Row="0" Margin="0,10,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="ConnLogSectionLbl" Text="📶 گزارش کانکشن‌ها" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="ClearConnLogBtn" Content="🗑 پاکسازی" Style="{StaticResource ActionBtn}" Padding="8,4" Click="ClearConnLog_Click"/>
                </Grid>
                <TextBox Grid.Row="1" x:Name="ConnLogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalAlignment="Stretch" Margin="0,0,0,4" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"/>
            </Grid>

            <!-- ================= HOTSPOT PANEL ================= -->
            <ScrollViewer Grid.Row="1" x:Name="HotspotPanel" Visibility="Collapsed"
                          Background="{DynamicResource BgBrush}"
                          VerticalScrollBarVisibility="Auto">
                <ScrollViewer.RenderTransform>
                    <TranslateTransform x:Name="HotspotTransform"/>
                </ScrollViewer.RenderTransform>
                <StackPanel Margin="2,0">
                    <TextBlock Text="VPN WIFI-Direct" Style="{StaticResource SectionTitle}" Margin="0,0,0,15"/>

                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" x:Name="HsVpnLabel" Text="کانکشن VPN فعال:" Foreground="{DynamicResource SubTextBrush}" FontSize="11"/>
                            <TextBlock Grid.Row="0" x:Name="HsVpnConnectionText" Text="در حال بررسی..." Foreground="{DynamicResource TextBrush}" FontSize="12.5" FontWeight="Bold" FontFamily="Consolas" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="2" x:Name="HsAdapterLabel" Text="کارت شبکه اینترنت:" Foreground="{DynamicResource SubTextBrush}" FontSize="11"/>
                            <TextBlock Grid.Row="2" x:Name="HsSourceText" Text="در حال بررسی..." Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="Bold" FontFamily="Consolas" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <UniformGrid Columns="3" Margin="0,0,0,15">
                        <Button x:Name="BtnHsStart" Content="روشن کردن" Style="{StaticResource ActionBtn}"
                                Background="#3B82F6" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="12" Height="42" Margin="0,0,3,0" Click="BtnHsStart_Click"/>

                        <Button x:Name="BtnHsStop" Content="توقف" Style="{StaticResource ActionBtn}"
                                Background="#EF4444" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="12" Height="42" Margin="3,0,3,0" IsEnabled="False" Click="BtnHsStop_Click"/>

                        <Button x:Name="BtnHsRestart" Content="راه‌اندازی مجدد" Style="{StaticResource ActionBtn}"
                                Background="#F59E0B" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="12" Height="42" Margin="3,0,0,0" IsEnabled="False" Click="BtnHsRestart_Click"/>
                    </UniformGrid>

                    <TextBlock x:Name="HsStatusText" Text="منتظر اتصال پایدار VPN..." Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,15" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="HsManualHint" Visibility="Collapsed" Foreground="{DynamicResource SubTextBrush}" FontSize="11.5" Margin="0,-5,0,5" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap">
                        <Run Text="کارت شبکه وای‌فای دایرکت معمولاً با نام "/>
                        <Run Text="Local Area Connection*" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                        <Run Text=" و یک عدد (مثل 10 یا 11) ساخته می‌شود."/>
                    </TextBlock>
                    <Button x:Name="BtnOpenNcpa" Content="باز کردن تنظیمات شبکه ویندوز (ncpa.cpl) 🔗" Visibility="Collapsed" Background="Transparent" Foreground="#3B82F6" BorderThickness="0" Cursor="Hand" Margin="0,0,0,15" Click="BtnOpenNcpa_Click" FontWeight="Bold" FontSize="12"/>
                    <Border x:Name="HsInfoContainer" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,15" Visibility="Collapsed">
                        <Grid FlowDirection="LeftToRight">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="SSID:" Foreground="{DynamicResource SubTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="HsSsidText" Text="-" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="Bold" FontFamily="Consolas" FlowDirection="LeftToRight" HorizontalAlignment="Left" TextAlignment="Left"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="PASS:" Foreground="{DynamicResource SubTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="HsPassText" Text="-" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="Bold" FontFamily="Consolas" FlowDirection="LeftToRight" HorizontalAlignment="Left" TextAlignment="Left"/>
                        </Grid>
                    </Border>

                    <Border x:Name="HsQrContainer" Background="White" CornerRadius="10" Padding="12" Visibility="Collapsed" HorizontalAlignment="Center">
                        <StackPanel>
                            <TextBlock x:Name="QrScanLbl" Text="📱 اسکن برای اتصال سریع" Foreground="#0F172A" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                            <Image x:Name="HsQrImage" Width="130" Height="130" Stretch="Uniform"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="HsClientsContainer" Visibility="Collapsed"
                            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,12,0,0"
                            Cursor="Hand" MouseEnter="HsClientsContainer_MouseEnter" MouseLeave="HsClientsContainer_MouseLeave">
                        <Grid>
                            <TextBlock x:Name="HsClientsCountText" Text="دستگاه‌های متصل: ۰"
                                       Foreground="{DynamicResource TextBrush}" FontSize="11.5"
                                       HorizontalAlignment="Center"/>
                            <Popup x:Name="HsClientsPopup" PlacementTarget="{Binding ElementName=HsClientsContainer}"
                                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="8" Width="300">
                                    <TextBox x:Name="HsClientsTextBox" IsReadOnly="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" MaxHeight="130"
                                             Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}"
                                             BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                             FontFamily="Consolas" FontSize="11" Padding="6"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            </Grid>

        <!-- ================= MINI WIDGET ================= -->
        <Border x:Name="MiniWidget" Visibility="Collapsed"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                CornerRadius="12" Padding="10,8" Margin="8">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="MiniAlwaysOnTopMenuItem" Header="همیشه بالا" IsCheckable="True" Click="MiniAlwaysOnTop_Click"/>
                </ContextMenu>
            </Border.ContextMenu>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="MiniPowerBtn" Width="44" Height="44" Padding="0"
                        Background="#334155" Cursor="Hand" Click="Power_Click"
                        ToolTip="روشن/خاموش اتصال" VerticalAlignment="Center">
                    <Button.Effect>
                        <DropShadowEffect x:Name="MiniPowerGlow" Color="#22C55E"
                                          BlurRadius="12" ShadowDepth="0" Opacity="0"/>
                    </Button.Effect>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="22">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Path Width="20" Height="20" Stretch="Uniform"
                          Data="M 12,2.5 L 12,11.5 M 7.05,5.6 A 8.5,8.5 0 1 0 16.95,5.6"
                          Stroke="#F8FAFC" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>

                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="MiniStatusDot" Width="7" Height="7" Fill="#64748B"
                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="MiniStatusText" Text="آماده اتصال" FontSize="12.5" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock x:Name="MiniConnectionText" Text="—" FontSize="10"
                               Foreground="{DynamicResource SubTextBrush}" FlowDirection="LeftToRight"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    <TextBlock x:Name="MiniSpeedText" Text="↓ 0 B/s   ↑ 0 B/s" FontSize="10.5"
                               Foreground="{DynamicResource SubTextBrush}" FlowDirection="LeftToRight" Margin="0,3,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" x:Name="MiniRestoreBtn" Width="42" Height="42" Padding="0"
                        Background="{DynamicResource AccentBrush}" Cursor="Hand" Click="MiniRestoreBtn_Click"
                        ToolTip="بازگشت به حالت عادی" VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="⤢" FontSize="19" Foreground="#F8FAFC"/>
                </Button>
            </Grid>
        </Border>

        </Grid>
    
        <!-- DRAWER OVERLAY -->
        <Grid x:Name="DrawerOverlay" Grid.RowSpan="2" Background="#80000000" Visibility="Collapsed" Panel.ZIndex="999" MouseLeftButtonDown="DrawerOverlay_MouseLeftButtonDown">
            <Border x:Name="DrawerMenuPanel" HorizontalAlignment="Left" Width="260" Background="#0B1121" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" MouseLeftButtonDown="DrawerMenuPanel_MouseLeftButtonDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="20,20,20,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DrawerTitleText" Grid.Column="0" Text="منوی اصلی" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="DrawerClose_Click">
                            <Path Data="M18 6L6 18M6 6l12 12" Stroke="#94A3B8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="14" Height="14"/>
                        </Button>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="10,20,10,10">
                        <Button Style="{StaticResource DrawerNavBtn}" Click="HotspotNavHome_Click">
                            <TextBlock x:Name="DrawerNavHomeText" Text="🏠 داشبورد اصلی" Foreground="{DynamicResource TextBrush}" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource DrawerNavBtn}" Margin="0,5,0,0" Click="HotspotNavXray_Click">
                            <TextBlock x:Name="DrawerNavXrayText" Text="🚀 سرویس Xray" Foreground="{DynamicResource TextBrush}" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource DrawerNavBtn}" Margin="0,5,0,0" Click="HotspotNavLogs_Click">
                            <TextBlock x:Name="DrawerNavLogsText" Text="📄 لاگ اتصال" Foreground="{DynamicResource TextBrush}" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource DrawerNavBtn}" Margin="0,5,0,0" Click="OpenHotspotWindow_Click">
                            <TextBlock x:Name="DrawerNavHotspotText" Text="🛜 مدیریت Hotspot" Foreground="{DynamicResource TextBrush}" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource DrawerNavBtn}" Margin="0,5,0,0" Click="HotspotNavTools_Click">
                            <TextBlock x:Name="DrawerNavToolsText" Text="🧰 جعبه ابزار" Foreground="{DynamicResource TextBrush}" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource DrawerNavBtn}" Margin="0,5,0,0" Click="HotspotNavSettings_Click">
                            <TextBlock x:Name="DrawerNavSettingsText" Text="⚙ تنظیمات" Foreground="{DynamicResource TextBrush}" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- IN-APP SUB INPUT MODAL OVERLAY -->
        <Grid x:Name="XraySubOverlay" Grid.RowSpan="2" Background="#B0000000" Visibility="Collapsed" Panel.ZIndex="998" MouseLeftButtonDown="XraySubOverlay_MouseLeftButtonDown">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="350" MaxWidth="370"
                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="18,16" MouseLeftButtonDown="XraySubModal_MouseLeftButtonDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#000000" Opacity="0.7"/>
                </Border.Effect>
                <StackPanel x:Name="XraySubModalStack">
                    <!-- Title Bar -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="XraySubTitleText" Grid.Column="0" Text="🔗 افزودن لینک اشتراک Xray" Foreground="{DynamicResource TextBrush}" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="XraySubCancel_Click">
                            <Path Data="M18 6L6 18M6 6l12 12" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="12" Height="12"/>
                        </Button>
                    </Grid>

                    <TextBlock x:Name="XraySubNameHintText" Text="نام گروه / اشتراک (اختیاری):"
                               Foreground="{DynamicResource SubTextBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBox x:Name="XraySubNameInput" Height="32" Padding="8,5" Margin="0,0,0,10"
                             Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" FontSize="11.5"
                             VerticalContentAlignment="Center"/>

                    <TextBlock x:Name="XraySubHintText" Text="لینک سابسکریپشن یا کانکشن خود را وارد نمایید:"
                               Foreground="{DynamicResource SubTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>

                    <!-- Input Box with Paste Button -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="XraySubUrlInput" Grid.Column="0" Height="34" Padding="8,6" FlowDirection="LeftToRight"
                                 Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" FontSize="11.5"
                                 VerticalContentAlignment="Center" KeyDown="XraySubUrlInput_KeyDown"/>
                        <Button Grid.Column="1" x:Name="XraySubPasteBtn" Content="📋 چسباندن" Style="{StaticResource ActionBtn}"
                                Padding="10,0" Height="34" Margin="6,0,0,0" FontSize="11"
                                Background="{DynamicResource HoverBrush}" Foreground="{DynamicResource TextBrush}"
                                Click="XraySubPaste_Click" ToolTip="چسباندن از کلیپ‌بورد"/>
                    </Grid>

                    <!-- Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="XraySubSubmitBtn" Content="ثبت و دریافت" Style="{StaticResource ActionBtn}"
                                Background="#3B82F6" Foreground="White" BorderThickness="0" Height="34"
                                FontSize="12" FontWeight="SemiBold" Margin="0,0,5,0" Click="XraySubSubmit_Click"/>
                        <Button Grid.Column="1" x:Name="XraySubCancelBtn" Content="انصراف" Style="{StaticResource ActionBtn}"
                                Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource SubTextBrush}"
                                BorderThickness="1" BorderBrush="{DynamicResource LineBrush}" Height="34"
                                FontSize="12" Margin="5,0,0,0" Click="XraySubCancel_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- IN-APP SHARE MODAL OVERLAY -->
        <Grid x:Name="XrayShareOverlay" Grid.RowSpan="2" Background="#B0000000" Visibility="Collapsed" Panel.ZIndex="998" MouseLeftButtonDown="XrayShareOverlay_MouseLeftButtonDown">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="330" MaxWidth="360"
                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="18,16" MouseLeftButtonDown="XrayShareModal_MouseLeftButtonDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#000000" Opacity="0.7"/>
                </Border.Effect>
                <StackPanel x:Name="XrayShareModalStack">
                    <!-- Title Bar -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="XrayShareTitleText" Grid.Column="0" Text="📱 اشتراک‌گذاری کانکشن" Foreground="{DynamicResource TextBrush}" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="XrayShareClose_Click">
                            <Path Data="M18 6L6 18M6 6l12 12" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="12" Height="12"/>
                        </Button>
                    </Grid>

                    <!-- Server summary badge -->
                    <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <Border Background="#1E293B" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                    <TextBlock x:Name="XrayShareProtoBadge" Text="VLESS" FontSize="9" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                </Border>
                                <TextBlock x:Name="XrayShareAliasText" Text="Server Name" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="210"/>
                            </StackPanel>
                            <TextBlock x:Name="XrayShareAddressText" Text="1.2.3.4:443" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" FlowDirection="LeftToRight"/>
                        </StackPanel>
                    </Border>

                    <!-- QR Code Container -->
                    <Border Background="White" CornerRadius="10" Padding="10" Margin="0,0,0,12" HorizontalAlignment="Center">
                        <Image x:Name="XrayShareQrImage" Width="160" Height="160" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>

                    <TextBlock x:Name="XrayShareHintText" Text="اسکن با دوربین یا اپ‌های موبایل (v2rayNG, Streisand, sing-box...)"
                               Foreground="{DynamicResource SubTextBrush}" FontSize="10.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,12"/>

                    <!-- Action buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="XrayShareCopyBtn" Content="📋 کپی لینک کانکشن" Style="{StaticResource ActionBtn}"
                                Background="#3B82F6" Foreground="White" BorderThickness="0" Height="34"
                                FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0" Click="XrayShareCopyBtn_Click"/>
                        <Button Grid.Column="1" x:Name="XrayShareCloseBtn" Content="بستن" Style="{StaticResource ActionBtn}"
                                Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource SubTextBrush}"
                                BorderThickness="1" BorderBrush="{DynamicResource LineBrush}" Height="34" Padding="14,0"
                                FontSize="12" Click="XrayShareClose_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- IN-APP MESSAGE MODAL OVERLAY -->
        <Grid x:Name="InAppMessageOverlay" Grid.RowSpan="2" Background="#B0000000" Visibility="Collapsed" Panel.ZIndex="1000" MouseLeftButtonDown="InAppMsgOverlay_Dismiss">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="330" MaxWidth="360"
                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="20,18" MouseLeftButtonDown="InAppMsgBox_MouseLeftButtonDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#000000" Opacity="0.7"/>
                </Border.Effect>
                <StackPanel x:Name="InAppMessageModalStack">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock x:Name="InAppMsgIcon" Text="ℹ" FontSize="18" Foreground="#3B82F6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="InAppMsgTitle" Text="پیام سیستم" Foreground="{DynamicResource TextBrush}" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="InAppMsgText" Text="پیام" Foreground="{DynamicResource SubTextBrush}" FontSize="12" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <Button x:Name="InAppMsgOkBtn" Content="باشه" Style="{StaticResource ActionBtn}" Background="#3B82F6" Foreground="White" BorderThickness="0" Height="34" Width="100" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Click="InAppMsgOverlay_Dismiss"/>
                </StackPanel>
            </Border>
        </Grid>

</Grid>
    </Border>
</Window>














