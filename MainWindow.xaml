                                                    <TextBlock x:Name="XraySubActiveText" Text="Active" FontWeight="SemiBold" FontSize="9.5" Foreground="#22C55E"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="XraySubEmptyText" Text="Click to load subscription status" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource SubTextBrush}" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" x:Name="XraySubDetailPanel">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <StackPanel Margin="0,0,20,0">
                                                <TextBlock x:Name="XraySubTimeLbl" Text="Expires" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                                                <TextBlock x:Name="XraySubTimeLeftText" Text="—" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
