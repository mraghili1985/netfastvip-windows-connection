<Window x:Class="SmartVpn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:TextOptions="clr-namespace:System.Windows.Media;assembly=PresentationCore"
        Title="NETFASTVIP" Width="880" Height="580"
        FlowDirection="LeftToRight"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI, Segoe UI Variable, Tahoma, ./Fonts/#Vazirmatn, Vazirmatn"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True" PreviewDragOver="Window_PreviewDragOver" DragOver="Window_DragOver" PreviewDrop="Window_PreviewDrop" Drop="Window_Drop"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34"
                      CornerRadius="12"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Button Styles -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryGlowBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Tab Button Style -->
        <Style x:Key="SidebarTabBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DrawerNavBtn" TargetType="Button" BasedOn="{StaticResource SidebarTabBtn}"/>

        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="2,14,2,6"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>

        <Style x:Key="ToolTile" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <LinearGradientBrush x:Key="DlAreaBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4038BDF8" Offset="0"/>
            <GradientStop Color="#0038BDF8" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="UlAreaBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4022C55E" Offset="0"/>
            <GradientStop Color="#0022C55E" Offset="1"/>
        </LinearGradientBrush>

        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="PowerScale" Storyboard.TargetProperty="ScaleX"
                              From="1" To="1.06" Duration="0:0:0.9"/>
            <DoubleAnimation Storyboard.TargetName="PowerScale" Storyboard.TargetProperty="ScaleY"
                              From="1" To="1.06" Duration="0:0:0.9"/>
        </Storyboard>
        <Storyboard x:Key="SpinStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="PowerGlyphRotate" Storyboard.TargetProperty="Angle"
                              From="0" To="360" Duration="0:0:1"/>
        </Storyboard>
        <Storyboard x:Key="SubRefreshSpinStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SubRefreshRotate" Storyboard.TargetProperty="Angle"
                              From="0" To="360" Duration="0:0:0.8"/>
        </Storyboard>
        <Storyboard x:Key="HotspotPulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="HotspotHeaderScale" Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.12" Duration="0:0:0.8"/>
            <DoubleAnimation Storyboard.TargetName="HotspotHeaderScale" Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.12" Duration="0:0:0.8"/>
        </Storyboard>
    </Window.Resources>

    <!-- Main Window Root Surface -->
    <Border x:Name="WindowSurface" Margin="0"
            Background="{DynamicResource BgBrush}"
            BorderThickness="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleBarRow" Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Minimalist Windows 11 Title Bar -->
            <Border x:Name="AppTitleBar" Grid.Row="0" Height="34"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="AppTitleBar_MouseLeftButtonDown">
                <Grid FlowDirection="LeftToRight">
                    <!-- Left: Brand Logo & Title -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Path Data="M12 2L3 7v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-9-5z"
                              Fill="{DynamicResource AccentBrush}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="NETFASTVIP" FontSize="11.5" FontWeight="Bold"
                                   Foreground="{DynamicResource SubTextBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: Window Caption Controls -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="TitleMinimizeButton" Width="44" Height="34"
                                Content="—" FontSize="13" Padding="0"
                                Background="Transparent" Foreground="{DynamicResource SubTextBrush}"
                                BorderThickness="0" Cursor="Hand" ToolTip="کمینه‌سازی"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="TitleMinimizeButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="TitleMaximizeButton" Width="44" Height="34"
                                Content="▢" FontSize="12" Padding="0"
                                Background="Transparent" Foreground="{DynamicResource SubTextBrush}"
                                BorderThickness="0" Cursor="Hand" ToolTip="بزرگ‌نمایی"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="TitleMaximizeButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="TitleCloseButton" Width="46" Height="34"
                                Content="✕" FontSize="14" Padding="0"
                                Background="Transparent" Foreground="{DynamicResource SubTextBrush}"
                                BorderThickness="0" Cursor="Hand" ToolTip="بستن"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="TitleCloseButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#DC2626"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main App Body: Sidebar + Main Content Stage -->
            <Grid Grid.Row="1">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="RootScale"/>
                </Grid.LayoutTransform>

                <Grid x:Name="RootGrid" AllowDrop="True" PreviewDragOver="Window_PreviewDragOver" DragOver="Window_DragOver" PreviewDrop="Window_PreviewDrop" Drop="Window_Drop">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/> <!-- Left Sidebar -->
                        <ColumnDefinition Width="*"/>   <!-- Main Content Canvas -->
                    </Grid.ColumnDefinitions>

                    <!-- ================= VERTICAL SIDEBAR ================= -->
                    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                            BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Brand -->
                                <RowDefinition Height="*"/>    <!-- Navigation Tabs -->
                                <RowDefinition Height="Auto"/> <!-- Footer / Version -->
                            </Grid.RowDefinitions>

                            <!-- Brand Shield Header -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="18,18,14,14">
                                <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                                    <Path Data="M12 2L3 7v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-9-5z"
                                          Fill="{DynamicResource AccentBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="NETFASTVIP" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Fluent Shield" FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Navigation Tabs -->
                            <StackPanel Grid.Row="1" Margin="10,10,10,10">
                                <!-- Dashboard Tab (Default Active) -->
                                <Button x:Name="NavDashboardBtn" Style="{StaticResource SidebarTabBtn}" Background="{DynamicResource CardHoverBrush}" Click="SidebarNavDashboard_Click">
                                    <Grid>
                                        <Border x:Name="NavDashboardIndicator" Width="3" Height="22" HorizontalAlignment="Left"
                                                Background="{DynamicResource AccentBrush}" CornerRadius="1.5" Visibility="Visible"/>
                                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="⌂" FontSize="18" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Width="24"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="NavDashboardText" Text="داشبورد" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock x:Name="SidebarNavDashboardSubtext" Text="آماده" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- VPN Core Tab -->
                                <Button x:Name="NavVpnCoreBtn" Style="{StaticResource SidebarTabBtn}" Click="SidebarNavVpnCore_Click">
                                    <Grid>
                                        <Border x:Name="NavVpnCoreIndicator" Width="3" Height="22" HorizontalAlignment="Left"
                                                Background="{DynamicResource AccentBrush}" CornerRadius="1.5" Visibility="Collapsed"/>
                                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="🛡️" FontSize="14" VerticalAlignment="Center" Width="24"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="NavVpnCoreText" Text="VPN Core" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock Text="WireGuard / OVPN" FontSize="9" Foreground="{DynamicResource SubTextBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Xray Core Tab -->
                                <Button x:Name="NavXrayCoreBtn" Style="{StaticResource SidebarTabBtn}" Click="SidebarNavXrayCore_Click">
                                    <Grid>
                                        <Border x:Name="NavXrayCoreIndicator" Width="3" Height="22" HorizontalAlignment="Left"
                                                Background="{DynamicResource AccentBrush}" CornerRadius="1.5" Visibility="Collapsed"/>
                                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="⚡" FontSize="15" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Width="24"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="NavXrayCoreText" Text="Xray Core" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock Text="sing-box / VLESS" FontSize="9" Foreground="{DynamicResource SubTextBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Legacy stub for compilation safety -->
                                <Button x:Name="NavServersBtn" Visibility="Collapsed"/>
                                <Border x:Name="NavServersIndicator" Visibility="Collapsed"/>

                                <!-- Hotspot Tab -->
                                <Button x:Name="NavHotspotBtn" Style="{StaticResource SidebarTabBtn}" Click="SidebarNavHotspot_Click">
                                    <Grid>
                                        <Border x:Name="NavHotspotIndicator" Width="3" Height="22" HorizontalAlignment="Left"
                                                Background="{DynamicResource AccentBrush}" CornerRadius="1.5" Visibility="Collapsed"/>
                                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="📶" FontSize="15" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Width="24"/>
                                            <TextBlock x:Name="NavHotspotText" Text="هات‌اسپات" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Settings Tab -->
                                <Button x:Name="NavSettingsBtn" Style="{StaticResource SidebarTabBtn}" Click="SidebarNavSettings_Click">
                                    <Grid>
                                        <Border x:Name="NavSettingsIndicator" Width="3" Height="22" HorizontalAlignment="Left"
                                                Background="{DynamicResource AccentBrush}" CornerRadius="1.5" Visibility="Collapsed"/>
                                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="⚙" FontSize="15" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Width="24"/>
                                            <TextBlock x:Name="NavSettingsText" Text="تنظیمات" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Tools Tab -->
                                <Button x:Name="NavToolsBtn" Style="{StaticResource SidebarTabBtn}" Click="SidebarNavTools_Click">
                                    <Grid>
                                        <Border x:Name="NavToolsIndicator" Width="3" Height="22" HorizontalAlignment="Left"
                                                Background="{DynamicResource AccentBrush}" CornerRadius="1.5" Visibility="Collapsed"/>
                                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="🧰" FontSize="15" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Width="24"/>
                                            <TextBlock x:Name="NavToolsText" Text="ابزارهای شبکه" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Connection Logs Tab -->
                                <Button x:Name="NavLogsBtn" Style="{StaticResource SidebarTabBtn}" Click="SidebarNavLogs_Click">
                                    <Grid>
                                        <Border x:Name="NavLogsIndicator" Width="3" Height="22" HorizontalAlignment="Left"
                                                Background="{DynamicResource AccentBrush}" CornerRadius="1.5" Visibility="Collapsed"/>
                                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="📜" FontSize="15" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Width="24"/>
                                            <TextBlock x:Name="NavLogsText" Text="لاگ کانکشن‌ها" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <!-- Sidebar Footer -->
                            <Border Grid.Row="2" Margin="12,0,12,14" Padding="10,8" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="v2.5 Fluent Mica" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}"/>
                                        <TextBlock Text="Engine: sing-box / Core" FontSize="9" Foreground="#64748B"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ================= MAIN CONTENT AREA ================= -->
                    <Grid Grid.Column="1" Margin="22,18,22,18">

                        <!-- Hidden stubs to keep C# references 100% safe -->
                        <StackPanel Visibility="Collapsed">
                            <Button x:Name="HamburgerBtn" Click="HamburgerBtn_Click"/>
                            <StackPanel x:Name="HeaderBrandPanel"/>
                            <StackPanel x:Name="HeaderPagePanel"/>
                            <TextBlock x:Name="HeaderTitleText"/>
                            <TextBlock x:Name="BrandTitleText"/>
                            <Button x:Name="HeaderPowerBtn"/>
                            <Button x:Name="HeaderLogBtn"/>
                            <Button x:Name="HeaderHotspotBtn"/>
                            <Button x:Name="HeaderToolsBtn"/>
                            <Button x:Name="HeaderSettingsBtn"/>
                            <TextBlock x:Name="HotspotHeaderIcon"/>
                            <Button Visibility="Collapsed">
                                <Button.Effect><DropShadowEffect x:Name="HotspotHeaderGlow"/></Button.Effect>
                                <Button.RenderTransform><ScaleTransform x:Name="HotspotHeaderScale"/></Button.RenderTransform>
                            </Button>
                        </StackPanel>

                        <!-- ================= 1. DASHBOARD VIEW (CONCEPT 2 HIGH FIDELITY) ================= -->
                        <!-- ================= 1. DASHBOARD VIEW (CONNECTED TO REAL PROGRAM) ================= -->
                        <Grid x:Name="HomePanel" Visibility="Visible">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="HomeTransform"/>
                            </Grid.RenderTransform>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340"/> <!-- Left Hero & Telemetry -->
                                <ColumnDefinition Width="*"/>   <!-- Right Controls & Real Server List -->
                            </Grid.ColumnDefinitions>

                            <!-- ================= LEFT COLUMN: HERO CARD + TELEMETRY + DETAILS ================= -->
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Top">

                                <!-- Hero Active Server Card with Sapphire Ambient Glow -->
                                <Border Background="{DynamicResource GlassBrush}"
                                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                                        CornerRadius="16" Padding="18,16" ClipToBounds="True">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#38BDF8" BlurRadius="28" ShadowDepth="0" Opacity="0.32"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <!-- Top Row: Location/Protocol Badge + Server Name + Status Pill -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Dynamic Location/Protocol Badge -->
                                            <Border x:Name="ActiveServerBadge" Grid.Column="0" Width="44" Height="44" CornerRadius="12"
                                                    Background="#1A253C" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                                                    Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border CornerRadius="6" ClipToBounds="True" Width="28" Height="20">
                                                        <Image x:Name="ActiveServerBadgeImg" Width="28" Height="20" Stretch="UniformToFill" Visibility="Collapsed"/>
                                                    </Border>
                                                    <TextBlock x:Name="ActiveServerBadgeText" Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- Active Server Title, Subtitle, & Status -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="ActiveConnText" Text="یک کانکشن انتخاب کنید" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="ServerSubText" Text="—" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                <Border x:Name="GeoIpPill" Background="#1838BDF8" BorderBrush="#3038BDF8" BorderThickness="1" CornerRadius="8" Padding="7,3" Margin="0,5,0,0" HorizontalAlignment="Left" MaxWidth="210">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock x:Name="GeoIpText" Text="آماده اتصال" FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock x:Name="StatusText" Visibility="Collapsed"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Card Footer: Duration -->
                                        <Grid Margin="0,18,0,0">
                                            <TextBlock x:Name="DurationLbl" Text="مدت زمان اتصال" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="DurationText" Text="00:00:00" FontSize="16" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Telemetry & Live Status Details -->
                                <StackPanel Margin="0,14,0,0">
                                    <!-- 1. Real Speed & Latency Row -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="CurrentSpeedLbl" Text="سرعت لحظه‌ای" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock x:Name="DlSpeedText" Text="↓ 0 B/s" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock x:Name="UlSpeedText" Text="↑ 0 B/s" FontSize="11" Foreground="#22C55E" Margin="10,0,0,2" VerticalAlignment="Bottom"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="LatencyLbl" Text="تاخیر / پینگ" FontSize="11" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right"/>
                                            <TextBlock x:Name="PingText" Text="—" FontSize="16" FontWeight="Bold" Foreground="#22C55E" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 2. Session Data Used -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="SessionTrafficLbl" Text="حجم مصرفی سشن" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                                            <TextBlock x:Name="SessionTrafficText" Text="0 B" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 3. Connection Status Details (Tunnel IP, Server IP, Protocol, User) -->
                                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="8,8" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Tunnel IP -->
                                            <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                                                    BorderThickness="1" CornerRadius="8" Padding="8,5" Margin="0,0,3,3" Cursor="Hand" ToolTip="برای کپی کلیک کنید" MouseLeftButtonDown="CopyIpText_Click">
                                                <StackPanel>
                                                    <TextBlock x:Name="TunnelIpLbl" Text="🌐 آی‌پی تونل" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}"/>
                                                    <TextBlock x:Name="PrivateIpText" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Server IP -->
                                            <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                                                    BorderThickness="1" CornerRadius="8" Padding="8,5" Margin="3,0,0,3" Cursor="Hand" ToolTip="برای کپی کلیک کنید" MouseLeftButtonDown="CopyIpText_Click">
                                                <StackPanel>
                                                    <TextBlock x:Name="ServerIpLbl" Text="🖥️ آی‌پی سرور" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}"/>
                                                    <TextBlock x:Name="ServerIpText" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Protocol -->
                                            <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                                                    BorderThickness="1" CornerRadius="8" Padding="8,5" Margin="0,3,3,0">
                                                <StackPanel>
                                                    <TextBlock x:Name="ProtocolLbl" Text="🔒 پروتکل" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}"/>
                                                    <TextBlock x:Name="ProtocolText" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- User -->
                                            <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                                                    BorderThickness="1" CornerRadius="8" Padding="8,5" Margin="3,3,0,0">
                                                <StackPanel>
                                                    <TextBlock x:Name="YouLbl" Text="👤 نام کاربری" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}"/>
                                                    <TextBlock x:Name="YouText" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- 4. Live Bandwidth Graph -->
                                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="8,6" Margin="0,0,0,0">
                                        <StackPanel>
                                            <TextBlock x:Name="LiveTrafficGraphLbl" Text="📈 نمودار زنده ترافیک" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}" Margin="2,0,0,4"/>
                                            <Canvas x:Name="GraphCanvas" Height="36" ClipToBounds="True">
                                                <Polygon x:Name="DlArea" Fill="{StaticResource DlAreaBrush}"/>
                                                <Polygon x:Name="UlArea" Fill="{StaticResource UlAreaBrush}"/>
                                                <Polyline x:Name="DlLine" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"/>
                                                <Polyline x:Name="UlLine" Stroke="#22C55E" StrokeThickness="1.2"/>
                                            </Canvas>
                                        </StackPanel>
                                    </Border>

                                    <!-- Compatibility Anchors for Legacy Handlers -->
                                    <Button x:Name="MoreInfoBtn" Visibility="Collapsed" Click="MoreInfoToggle_Click">
                                        <StackPanel><TextBlock x:Name="MoreInfoText"/><TextBlock x:Name="MoreInfoArrow"/></StackPanel>
                                    </Button>
                                    <Border x:Name="MoreInfoPanel" Visibility="Collapsed"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- ================= RIGHT COLUMN: CONNECTION CONTROL & SELECTED TARGET ================= -->
                            <Grid Grid.Column="1" Margin="8,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Connection Control Capsule Card -->
                                    <RowDefinition Height="*"/>    <!-- Selected Server Target & Quick Switch Card -->
                                    <RowDefinition Height="Auto"/> <!-- Real Subscription Card (SubSummaryCard) -->
                                </Grid.RowDefinitions>

                                <!-- 1. Connection Control Card -->
                                <Border Grid.Row="0" Background="{DynamicResource GlassBrush}"
                                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                                        CornerRadius="16" Padding="14,14" Margin="0,0,0,10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="ConnControlLbl" Text="کنترل اتصال" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                                        <!-- Capsule Toggle Switch Button -->
                                        <Button x:Name="PowerBtn" Width="144" Height="50" Cursor="Hand" Click="Power_Click"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Button.RenderTransform>
                                                <ScaleTransform x:Name="PowerScale" ScaleX="1" ScaleY="1"/>
                                            </Button.RenderTransform>
                                            <Button.Effect>
                                                <DropShadowEffect Color="#22C55E" BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
                                            </Button.Effect>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="CapsuleBorder" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource GlassBorderBrush}"
                                                            BorderThickness="1" CornerRadius="25" Padding="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid Width="136" Height="42">
                                                <!-- Status Label "ON" / "OFF" -->
                                                <TextBlock x:Name="PowerStateText" Text="OFF" FontSize="15" FontWeight="Bold"
                                                           Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0"/>

                                                <!-- Glowing Circular Knob with Ring -->
                                                <Border Width="36" Height="36" HorizontalAlignment="Right" CornerRadius="18"
                                                        Background="#0B1120" BorderBrush="#F59E0B" BorderThickness="2.5" Margin="0,0,3,0">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#F59E0B" BlurRadius="14" ShadowDepth="0" Opacity="0.85"/>
                                                    </Border.Effect>
                                                    <Grid>
                                                        <!-- Power Glyph inside Knob -->
                                                        <Path x:Name="PowerGlyph" Width="17" Height="17" Stretch="Uniform"
                                                              Data="M 12,2.5 L 12,11.5 M 7.05,5.6 A 8.5,8.5 0 1 0 16.95,5.6"
                                                              Stroke="#F8FAFC" StrokeThickness="2"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              RenderTransformOrigin="0.5,0.5">
                                                            <Path.RenderTransform>
                                                                <RotateTransform x:Name="PowerGlyphRotate" Angle="0"/>
                                                            </Path.RenderTransform>
                                                        </Path>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Button>

                                        <TextBlock x:Name="PowerHintText" Text="روشن/خاموش اتصال" FontSize="11"
                                                   Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- 2. Recent & Favorite Connections Card (Top 3 Recent Connections) -->
                                <Border Grid.Row="1" Background="{DynamicResource GlassBrush}"
                                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                                        CornerRadius="16" Padding="14,11" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Card Header -->
                                        <Grid Grid.Row="0">
                                            <StackPanel>
                                                <TextBlock x:Name="RecentCardTitle" Text="⭐ سرورهای منتخب و اخیر" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock x:Name="RecentCardSubtitle" Text="اتصال سریع با یک کلیک به آخرین کانکشن‌ها" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Up to 3 Recent Connections List -->
                                        <StackPanel Grid.Row="1" x:Name="RecentServersList" Margin="0,5,0,5" VerticalAlignment="Center"/>

                                        <!-- Quick Navigation Buttons to Core Panels -->
                                        <Grid Grid.Row="2" Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" x:Name="HomeSwitchToVpnBtn" Content="🛡️ سرورهای VPN Core"
                                                    Click="SidebarNavVpnCore_Click" Style="{StaticResource ActionBtn}"
                                                    FontSize="10.5" FontWeight="SemiBold" Margin="0,0,4,0" Padding="6,6"/>
                                            <Button Grid.Column="1" x:Name="HomeSwitchToXrayBtn" Content="⚡ سرورهای Xray Core"
                                                    Click="SidebarNavXrayCore_Click" Style="{StaticResource ActionBtn}"
                                                    FontSize="10.5" FontWeight="SemiBold" Margin="4,0,0,0" Padding="6,6"/>
                                        </Grid>

                                        <!-- Hidden Stubs for compilation safety -->
                                        <StackPanel Visibility="Collapsed">
                                            <Image x:Name="TargetConnBadgeImg"/>
                                            <TextBlock x:Name="TargetConnBadgeText"/>
                                            <TextBlock x:Name="TargetConnNameText"/>
                                            <TextBlock x:Name="TargetConnSubText"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 3. Dual Subscription Cards: Stacked Equal-Sized Boxes -->
                                <StackPanel Grid.Row="2" Margin="0,0,0,0">
                                    <!-- 3.1 VPN Core Subscription Card -->
                                    <Border x:Name="SubSummaryCard"
                                            Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                                            BorderThickness="1" CornerRadius="13" Padding="12,8" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonUp="SubSummaryCard_Click">
                                        <Grid FlowDirection="LeftToRight">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" x:Name="SubRefreshBtn" Width="26" Height="26" Padding="0" Style="{StaticResource ActionBtn}" Margin="0,0,8,0" Click="SubRefreshBtn_Click" ToolTip="بروزرسانی اشتراک VPN">
                                                <TextBlock Text="🔄" FontSize="11" RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform><RotateTransform x:Name="SubRefreshRotate"/></TextBlock.RenderTransform>
                                                </TextBlock>
                                            </Button>

                                            <StackPanel Grid.Column="1" x:Name="SubSummaryPanel" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="SubSectionLabel" Text="🛡️ اشتراک VPN Core" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                                    <Border x:Name="SubActiveBadge" Background="#2022C55E" CornerRadius="6" Padding="5,1" Margin="6,0,0,0" Visibility="Collapsed">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse x:Name="SubActiveDot" Width="5" Height="5" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                            <TextBlock x:Name="SubActiveText" Text="فعال" FontSize="8.5" Foreground="#22C55E"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock x:Name="SubEmptyText" Text="برای مشاهده وضعیت اشتراک کلیک کنید" FontSize="9" Foreground="{DynamicResource SubTextBrush}" Margin="0,1,0,0"/>
                                            </StackPanel>

                                            <Border Grid.Column="2" x:Name="SubDetailPanel" Visibility="Collapsed" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel Margin="0,0,10,0">
                                                        <TextBlock x:Name="SubTimeLbl" Text="زمان باقی‌مانده" FontSize="8" Foreground="{DynamicResource SubTextBrush}"/>
                                                        <TextBlock x:Name="SubTimeLeftText" Text="—" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock x:Name="SubDataLbl" Text="حجم باقی‌مانده" FontSize="8" Foreground="{DynamicResource SubTextBrush}"/>
                                                        <TextBlock x:Name="SubDataLeftText" Text="—" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="SubUpdatedText" Text="" Visibility="Collapsed"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- 3.2 Xray Core Subscription Card -->
                                    <Border x:Name="HomeXraySubCard"
                                            Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                                            BorderThickness="1" CornerRadius="13" Padding="12,8" Margin="0,0,0,0" Cursor="Hand" MouseLeftButtonUp="HomeXraySubCard_Click">
                                        <Grid FlowDirection="LeftToRight">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" x:Name="HomeXraySubRefreshBtn" Width="26" Height="26" Padding="0" Style="{StaticResource ActionBtn}" Margin="0,0,8,0" Click="HomeXraySubRefreshBtn_Click" ToolTip="بروزرسانی اشتراک Xray">
                                                <TextBlock Text="🔄" FontSize="11" RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform><RotateTransform x:Name="HomeXraySubRefreshRotate"/></TextBlock.RenderTransform>
                                                </TextBlock>
                                            </Button>

                                            <StackPanel Grid.Column="1" x:Name="HomeXraySubSummaryPanel" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="HomeXraySubSectionLabel" Text="⚡ اشتراک Xray Core" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                                    <Border x:Name="HomeXraySubActiveBadge" Background="#2022C55E" CornerRadius="6" Padding="5,1" Margin="6,0,0,0" Visibility="Collapsed">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse x:Name="HomeXraySubActiveDot" Width="5" Height="5" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                            <TextBlock x:Name="HomeXraySubActiveText" Text="فعال" FontSize="8.5" Foreground="#22C55E"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock x:Name="HomeXraySubEmptyText" Text="برای مشاهده وضعیت اشتراک کلیک کنید" FontSize="9" Foreground="{DynamicResource SubTextBrush}" Margin="0,1,0,0"/>
                                            </StackPanel>

                                            <Border Grid.Column="2" x:Name="HomeXraySubDetailPanel" Visibility="Collapsed" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel Margin="0,0,10,0">
                                                        <TextBlock x:Name="HomeXraySubTimeLbl" Text="زمان باقی‌مانده" FontSize="8" Foreground="{DynamicResource SubTextBrush}"/>
                                                        <TextBlock x:Name="HomeXraySubTimeLeftText" Text="—" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock x:Name="HomeXraySubDataLbl" Text="حجم باقی‌مانده" FontSize="8" Foreground="{DynamicResource SubTextBrush}"/>
                                                        <TextBlock x:Name="HomeXraySubDataLeftText" Text="—" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Hidden Stubs (any remaining items) -->
                            <StackPanel Visibility="Collapsed">
                                <StackPanel x:Name="ActiveConnSummaryPanel"/>
                                <TextBlock x:Name="ConnSectionLabel"/>
                            </StackPanel>
                        </Grid>

                        <!-- ================= 2. VPN CORE PANEL (WIREGUARD, OPENVPN, RAS) ================= -->
                        <Grid x:Name="VpnPanel" Visibility="Collapsed">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="VpnTransform"/>
                            </Grid.RenderTransform>

                            <!-- VIEW 1: Connections List (Default) -->
                            <Grid x:Name="VpnListView" Visibility="Visible">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Action Toolbar -->
                                    <RowDefinition Height="*"/>    <!-- Server List -->
                                </Grid.RowDefinitions>

                                <!-- Toolbar with Title, Prominent Add (+), Filter, Import, Export -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🛡️ VPN Core" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Prominent '+' Action Button -->
                                        <Button x:Name="AddBtn" Style="{StaticResource PrimaryActionBtn}" Click="Add_Click" Margin="0,0,6,0" Width="38" Height="34" Padding="0" ToolTip="افزودن کانکشن جدید (Add Connection)">
                                            <TextBlock Text="＋" FontSize="20" FontWeight="Bold" Margin="0,-2,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                        <Button x:Name="VpnAddUrlBtn" Style="{StaticResource ActionBtn}" Click="VpnAddUrl_Click" Margin="0,0,6,0" ToolTip="دریافت کانکشن OpenVPN از لینک (Add from URL)">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🌐" FontSize="11"/>
                                                <TextBlock Text=" Add URL" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="VpnPingAllBtn" Style="{StaticResource ActionBtn}" Click="VpnPingAll_Click" Margin="0,0,6,0" ToolTip="Ping All Servers">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚡" FontSize="11"/>
                                                <TextBlock Text=" Ping All" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="FilterDropdownBtn" Style="{StaticResource ActionBtn}" Click="FilterDropdownBtn_Click" Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="FilterDropdownLabel" Text="همه" FontSize="11"/>
                                                <TextBlock Text=" ⌄" FontSize="10" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Content="📁 Import" Style="{StaticResource ActionBtn}" Click="Import_Click" Margin="0,0,6,0"/>
                                        <Button Content="💾 Export" Style="{StaticResource ActionBtn}" Click="Export_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Full-Height Scrollable Connections List (ConnList) -->
                                <Border Grid.Row="1" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                                        BorderThickness="1" CornerRadius="14" Padding="8,8">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="ConnList"/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>

                            <!-- VIEW 2: In-place Add / Edit Connection Form -->
                            <Grid x:Name="VpnEditView" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Header with Back Button & Quick Actions -->
                                    <RowDefinition Height="*"/>    <!-- Scrollable Form Container -->
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" x:Name="VpnEditBackBtn" Style="{StaticResource ActionBtn}" Padding="10,6" Click="ConnFormCancel_Click" Margin="0,0,12,0" ToolTip="بازگشت به لیست کانکشن‌ها">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="←" FontSize="14" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="بازگشت" FontSize="11.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="VpnEditTitleText" Text="افزودن کانکشن جدید" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock x:Name="VpnEditSubtitleText" Text="مشخصات و پارامترهای اتصال VPN را وارد نمایید" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"/>
                                    </StackPanel>

                                    <!-- Top Save / Cancel Quick Actions -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button x:Name="ConnFormTopSaveBtn" Content="💾 ذخیره" Style="{StaticResource PrimaryActionBtn}" Padding="14,6" Click="ConnFormSave_Click" Margin="0,0,6,0"/>
                                        <Button x:Name="ConnFormTopCancelBtn" Content="انصراف" Style="{StaticResource ActionBtn}" Padding="12,6" Click="ConnFormCancel_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Scrollable Form Body -->
                                <Border Grid.Row="1" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                                        BorderThickness="1" CornerRadius="14" Padding="16,14">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="0,0,10,0">

                                            <!-- 1. General Info: Name & Protocol Type -->
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="2*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="نام کانکشن *" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                    <TextBox x:Name="ConnFormNameBox" Height="34" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="10,0" VerticalContentAlignment="Center" FontSize="12.5"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="نوع پروتکل *" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                    <ComboBox x:Name="ConnFormTypeCombo" Height="34" SelectionChanged="ConnFormType_Changed">
                                                        <ComboBoxItem Content="OpenVPN" Tag="openvpn"/>
                                                        <ComboBoxItem Content="WireGuard / AmneziaWG" Tag="wireguard"/>
                                                        <ComboBoxItem Content="L2TP/IPsec" Tag="l2tp"/>
                                                        <ComboBoxItem Content="SSTP" Tag="sstp"/>
                                                        <ComboBoxItem Content="IKEv2" Tag="ikev2"/>
                                                        <ComboBoxItem Content="PPTP" Tag="pptp"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>

                                            <!-- 2. Standard Panel (OpenVPN, L2TP, SSTP, IKEv2, PPTP) -->
                                            <StackPanel x:Name="ConnFormStandardPanel">

                                                <!-- Server Address & Port -->
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="1*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="آدرس سرور (Server Address) *" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                        <TextBox x:Name="ConnFormServerBox" Height="34" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="12" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="10,0" VerticalContentAlignment="Center"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="پورت (اختیاری)" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                        <TextBox x:Name="ConnFormPortBox" Height="34" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="12" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="10,0" VerticalContentAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- OpenVPN Extras (Proto, Override, File Import) -->
                                                <StackPanel x:Name="ConnFormOvpnPanel" Margin="0,0,0,12">
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1*"/>
                                                            <ColumnDefinition Width="12"/>
                                                            <ColumnDefinition Width="2*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="پروتکل OpenVPN" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                            <ComboBox x:Name="ConnFormProtoCombo" Height="34" SelectedIndex="0">
                                                                <ComboBoxItem Content="UDP" Tag="udp"/>
                                                                <ComboBoxItem Content="TCP" Tag="tcp"/>
                                                            </ComboBox>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Server Override (اختیاری)" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                            <TextBox x:Name="ConnFormOverrideBox" Height="34" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="12" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="10,0" VerticalContentAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,4,0,0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="0" x:Name="ConnFormImportOvpnBtn" Content="📂 انتخاب فایل .ovpn" Style="{StaticResource ActionBtn}" Padding="12,6" Click="ConnFormImportOvpn_Click"/>
                                                            <Button Grid.Column="1" x:Name="ConnFormDownloadOvpnUrlBtn" Content="🌐 دریافت از لینک URL" Style="{StaticResource ActionBtn}" Padding="12,6" Margin="8,0,0,0" Click="ConnFormDownloadOvpnUrl_Click"/>
                                                            <TextBlock Grid.Column="2" x:Name="ConnFormOvpnStatusText" Text="" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Credentials: Username & Password -->
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="1*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="نام کاربری (Username)" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                        <TextBox x:Name="ConnFormUserBox" Height="34" FlowDirection="LeftToRight" FontSize="12" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="10,0" VerticalContentAlignment="Center"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="رمز عبور (Password)" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                        <PasswordBox x:Name="ConnFormPassBox" Height="34" FlowDirection="LeftToRight" FontSize="12" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="10,0" VerticalContentAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- L2TP PSK -->
                                                <StackPanel x:Name="ConnFormPskPanel" Margin="0,0,0,12" Visibility="Collapsed">
                                                    <TextBlock Text="کلید مشترک (Pre-shared Key / PSK)" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                    <TextBox x:Name="ConnFormPskBox" Height="34" FlowDirection="LeftToRight" FontSize="12" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="10,0" VerticalContentAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- 3. WireGuard / AmneziaWG Panel -->
                                            <StackPanel x:Name="ConnFormWgPanel" Visibility="Collapsed" Margin="0,0,0,12">

                                                <!-- Import .conf button -->
                                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button Grid.Column="0" x:Name="ConnFormImportWgBtn" Content="📂 ایمپورت از فایل .conf (اختیاری)" Style="{StaticResource ActionBtn}" Padding="12,6" Click="ConnFormImportWgConf_Click"/>
                                                        <TextBlock Grid.Column="1" x:Name="ConnFormWgStatusText" Text="یا فیلدهای زیر را دستی تکمیل کنید" FontSize="11" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </Border>

                                                <!-- [Interface] -->
                                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,12">
                                                    <StackPanel>
                                                        <TextBlock Text="─── Interface ───" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                                                        <TextBlock Text="Private Key *" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                        <TextBox x:Name="ConnFormWgPrivateKeyBox" Height="34" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="8,0" VerticalContentAlignment="Center"/>

                                                        <Grid Margin="0,8,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="8"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="8"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="Address * (e.g. 10.0.0.2/32)" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                                <TextBox x:Name="ConnFormWgAddressBox" Height="32" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="8,0" VerticalContentAlignment="Center"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="DNS (اختیاری)" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                                <TextBox x:Name="ConnFormWgDnsBox" Height="32" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="8,0" VerticalContentAlignment="Center"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="4">
                                                                <TextBlock Text="MTU (اختیاری)" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                                <TextBox x:Name="ConnFormWgMtuBox" Height="32" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="8,0" VerticalContentAlignment="Center"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- [Peer] -->
                                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,12">
                                                    <StackPanel>
                                                        <TextBlock Text="─── Peer ───" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="2*"/>
                                                                <ColumnDefinition Width="8"/>
                                                                <ColumnDefinition Width="1*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="Public Key *" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                                <TextBox x:Name="ConnFormWgPublicKeyBox" Height="32" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="8,0" VerticalContentAlignment="Center"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="Endpoint * (host:port)" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                                <TextBox x:Name="ConnFormWgEndpointBox" Height="32" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="8,0" VerticalContentAlignment="Center"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="1*"/>
                                                                <ColumnDefinition Width="8"/>
                                                                <ColumnDefinition Width="1*"/>
                                                                <ColumnDefinition Width="8"/>
                                                                <ColumnDefinition Width="1*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="Preshared Key (اختیاری)" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                                <TextBox x:Name="ConnFormWgPresharedKeyBox" Height="32" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="8,0" VerticalContentAlignment="Center"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="Allowed IPs" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                                <TextBox x:Name="ConnFormWgAllowedIPsBox" Text="0.0.0.0/0" Height="32" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="8,0" VerticalContentAlignment="Center"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="4">
                                                                <TextBlock Text="Keepalive (ثانیه)" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                                <TextBox x:Name="ConnFormWgKeepaliveBox" Height="32" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="8,0" VerticalContentAlignment="Center"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- AmneziaWG Obfuscation Checkbox & Card -->
                                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,12">
                                                    <StackPanel>
                                                        <CheckBox x:Name="ConnFormAwgCheckBox" FontSize="12" Checked="ConnFormAwgCheckBox_Changed" Unchecked="ConnFormAwgCheckBox_Changed">
                                                            <TextBlock>
                                                                <Run Text="AmneziaWG Obfuscation" FontWeight="SemiBold"/>
                                                                <Run Text=" — پارامترهای ضد فیلترینگ پیشرفته (Jc, S, H)" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"/>
                                                            </TextBlock>
                                                        </CheckBox>

                                                        <StackPanel x:Name="ConnFormAwgPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                                            <TextBlock Text="─── پارامترهای Junk و Obfuscation ───" FontSize="11" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                                                            <!-- Jc / Jmin / Jmax -->
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0"><TextBlock Text="Jc" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/><TextBox x:Name="ConnFormAwgJcBox" Height="30" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="6,0" VerticalContentAlignment="Center"/></StackPanel>
                                                                <StackPanel Grid.Column="2"><TextBlock Text="Jmin" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/><TextBox x:Name="ConnFormAwgJminBox" Height="30" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="6,0" VerticalContentAlignment="Center"/></StackPanel>
                                                                <StackPanel Grid.Column="4"><TextBlock Text="Jmax" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/><TextBox x:Name="ConnFormAwgJmaxBox" Height="30" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="6,0" VerticalContentAlignment="Center"/></StackPanel>
                                                            </Grid>

                                                            <!-- S1 / S2 / S3 / S4 -->
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0"><TextBlock Text="S1" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/><TextBox x:Name="ConnFormAwgS1Box" Height="30" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="6,0" VerticalContentAlignment="Center"/></StackPanel>
                                                                <StackPanel Grid.Column="2"><TextBlock Text="S2" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/><TextBox x:Name="ConnFormAwgS2Box" Height="30" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="6,0" VerticalContentAlignment="Center"/></StackPanel>
                                                                <StackPanel Grid.Column="4"><TextBlock Text="S3" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/><TextBox x:Name="ConnFormAwgS3Box" Height="30" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="6,0" VerticalContentAlignment="Center"/></StackPanel>
                                                                <StackPanel Grid.Column="6"><TextBlock Text="S4" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/><TextBox x:Name="ConnFormAwgS4Box" Height="30" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="6,0" VerticalContentAlignment="Center"/></StackPanel>
                                                            </Grid>

                                                            <!-- H1 / H2 / H3 / H4 -->
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0"><TextBlock Text="H1" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/><TextBox x:Name="ConnFormAwgH1Box" Height="30" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="6,0" VerticalContentAlignment="Center"/></StackPanel>
                                                                <StackPanel Grid.Column="2"><TextBlock Text="H2" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/><TextBox x:Name="ConnFormAwgH2Box" Height="30" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="6,0" VerticalContentAlignment="Center"/></StackPanel>
                                                                <StackPanel Grid.Column="4"><TextBlock Text="H3" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/><TextBox x:Name="ConnFormAwgH3Box" Height="30" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="6,0" VerticalContentAlignment="Center"/></StackPanel>
                                                                <StackPanel Grid.Column="6"><TextBlock Text="H4" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/><TextBox x:Name="ConnFormAwgH4Box" Height="30" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="6,0" VerticalContentAlignment="Center"/></StackPanel>
                                                            </Grid>

                                                            <TextBlock Text="پارامترهای اضافی (اختیاری)" Style="{StaticResource SectionTitle}" Margin="0,4,0,2"/>
                                                            <TextBox x:Name="ConnFormAwgExtraBox" Height="50" TextWrapping="Wrap" AcceptsReturn="True" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="8,4"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <!-- Bottom Save / Cancel Action Buttons -->
                                            <Grid Margin="0,8,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="💾 ذخیره کانکشن (Save)" Style="{StaticResource PrimaryActionBtn}" Height="38" FontSize="12.5" FontWeight="SemiBold" Click="ConnFormSave_Click"/>
                                                <Button Grid.Column="2" Content="انصراف (Cancel)" Style="{StaticResource ActionBtn}" Height="38" FontSize="12" Click="ConnFormCancel_Click"/>
                                            </Grid>

                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- ================= 2. SERVERS PANEL (XRAY & VPN CONNECTIONS) ================= -->
                        <Grid x:Name="XrayPanel" Visibility="Collapsed">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="XrayTransform"/>
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Action Toolbar -->
                                <RowDefinition Height="*"/>    <!-- Server List -->
                                <RowDefinition Height="Auto"/> <!-- Subscription Card -->
                            </Grid.RowDefinitions>

                            <!-- Toolbar with Add Subscription, Ping All, Refresh, Clear -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="XrayConnSectionLabel" Text="⚡ Xray Core" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                    <!-- Hidden Mode Switcher Stubs for code-behind compatibility -->
                                    <Button x:Name="XraySwitchToVpnBtn" Click="SwitchToVpnBtn_Click" Visibility="Collapsed"/>
                                    <Button x:Name="XraySwitchToXrayBtn" Click="SwitchToXrayBtn_Click" Visibility="Collapsed"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="XrayAddSubBtn" Content="＋ Add Subscription" Style="{StaticResource PrimaryActionBtn}" Click="XrayAddSub_Click" Margin="0,0,6,0"/>
                                    <Button x:Name="XrayUpdateSubBtn" Style="{StaticResource ActionBtn}" Click="XrayUpdateSub_Click" Margin="0,0,6,0" ToolTip="Update All">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔄" FontSize="11"/>
                                            <TextBlock x:Name="XrayUpdateSubLabel" Text=" Update" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="XrayPingAllBtn" Style="{StaticResource ActionBtn}" Click="XrayPingAll_Click" Margin="0,0,6,0" ToolTip="Ping All Servers">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡" FontSize="11"/>
                                            <TextBlock x:Name="XrayPingAllLabel" Text=" Ping All" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="XrayClearServersBtn" Content="🗑" Style="{StaticResource ActionBtn}" Click="XrayClearServers_Click" ToolTip="Clear Servers"/>
                                </StackPanel>
                            </Grid>

                            <!-- Connections and Subscription Groups List -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="XrayConnList" Margin="0,0,0,10"/>
                            </ScrollViewer>
                            <ListBox x:Name="XrayProxyList" Visibility="Collapsed"/>

                            <!-- Subscription Card -->
                            <Border Grid.Row="2" x:Name="XraySubSummaryCard" Background="{DynamicResource GlassBrush}"
                                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="XraySubRefreshBtn" Width="32" Height="32" Style="{StaticResource ActionBtn}" Padding="0" Click="XrayUpdateSub_Click" Margin="0,0,10,0">
                                        <TextBlock Text="🔄" FontSize="13" RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform><RotateTransform x:Name="XraySubRefreshRotate"/></TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Button>
                                    <StackPanel Grid.Column="1" x:Name="XraySubSummaryPanel" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="XraySubSectionLabel" Text="My Subscription" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                            <Border x:Name="XraySubActiveBadge" Background="#2022C55E" CornerRadius="6" Padding="6,1" Margin="8,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse x:Name="XraySubActiveDot" Width="5" Height="5" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock x:Name="XraySubActiveText" Text="Active" FontSize="9.5" Foreground="#22C55E"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="XraySubEmptyText" Text="Click to load subscription status" FontSize="11" Foreground="{DynamicResource SubTextBrush}" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" x:Name="XraySubDetailPanel">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <StackPanel Margin="0,0,20,0">
                                                <TextBlock x:Name="XraySubTimeLbl" Text="Expires" FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                                                <TextBlock x:Name="XraySubTimeLeftText" Text="—" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock x:Name="XraySubDataLbl" Text="Data Left" FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                                                <TextBlock x:Name="XraySubDataLeftText" Text="—" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                            </StackPanel>
                                            <TextBlock x:Name="XraySubUpdatedText" Text="" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Hidden Xray Power & Telemetry Stubs -->
                            <StackPanel Visibility="Collapsed">
                                <Button x:Name="XrayBtnPower" Click="XrayBtnPower_Click">
                                    <Button.RenderTransform><ScaleTransform x:Name="XrayPowerScale"/></Button.RenderTransform>
                                    <Path x:Name="XrayPowerGlyph" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform><RotateTransform x:Name="XrayPowerGlyphRotate"/></Path.RenderTransform>
                                    </Path>
                                </Button>
                                <TextBlock x:Name="XrayPowerHintText"/>
                                <StackPanel x:Name="XrayActiveConnSummaryPanel"/>
                                <Ellipse x:Name="XrayStatusDot"/>
                                <TextBlock x:Name="XrayStatusText"/>
                                <TextBlock x:Name="XrayTxtActiveName"/>
                                <TextBlock x:Name="XrayTxtActiveProtocol"/>
                                <TextBlock x:Name="XrayTxtActiveGeoIP"/>
                                <TextBlock x:Name="XrayTxtDuration"/>
                                <Button x:Name="XrayMoreInfoBtn" Click="XrayMoreInfoToggle_Click"/>
                                <TextBlock x:Name="XrayMoreInfoText"/>
                                <TextBlock x:Name="XrayMoreInfoArrow"/>
                                <Border x:Name="XrayMoreInfoPanel"/>
                                <Canvas x:Name="XrayGraphCanvas">
                                    <Polygon x:Name="XrayDlArea"/>
                                    <Polygon x:Name="XrayUlArea"/>
                                    <Polyline x:Name="XrayDlLine"/>
                                    <Polyline x:Name="XrayUlLine"/>
                                </Canvas>
                                <TextBlock x:Name="XrayDlSpeedText"/>
                                <TextBlock x:Name="XrayUlSpeedText"/>
                                <TextBlock x:Name="XrayPingText"/>
                                <TextBlock x:Name="XraySessionTrafficText"/>
                                <TextBlock x:Name="XrayPrivateIpText" MouseLeftButtonDown="CopyIpText_Click"/>
                                <TextBlock x:Name="XrayServerIpText" MouseLeftButtonDown="CopyIpText_Click"/>
                                <TextBlock x:Name="XrayYouLbl"/>
                                <TextBlock x:Name="XrayYouText"/>
                                <TextBlock x:Name="XrayProtocolLbl"/>
                                <TextBlock x:Name="XrayProtocolText"/>
                            </StackPanel>
                        </Grid>

                        <!-- ================= 3. HOTSPOT PANEL ================= -->
                        <ScrollViewer Grid.Row="1" x:Name="HotspotPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.RenderTransform>
                                <TranslateTransform x:Name="HotspotTransform"/>
                            </ScrollViewer.RenderTransform>
                            <StackPanel Margin="2,0">
                                <TextBlock Text="VPN WiFi-Direct &amp; Hotspot" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,15"/>

                                <Border Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,15">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" x:Name="HsVpnLabel" Text="Active VPN Connection:" Foreground="{DynamicResource SubTextBrush}" FontSize="11.5"/>
                                        <TextBlock Grid.Row="0" x:Name="HsVpnConnectionText" Text="Checking..." Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Row="2" x:Name="HsAdapterLabel" Text="Internet NIC Adapter:" Foreground="{DynamicResource SubTextBrush}" FontSize="11.5"/>
                                        <TextBlock Grid.Row="2" x:Name="HsSourceText" Text="Checking..." Foreground="{DynamicResource TextBrush}" FontSize="12.5" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>

                                <UniformGrid Columns="3" Margin="0,0,0,15">
                                    <Button x:Name="BtnHsStart" Content="Start Hotspot" Style="{StaticResource PrimaryActionBtn}" Height="42" Margin="0,0,4,0" Click="BtnHsStart_Click"/>
                                    <Button x:Name="BtnHsStop" Content="Stop" Style="{StaticResource ActionBtn}" Height="42" Margin="4,0,4,0" IsEnabled="False" Click="BtnHsStop_Click"/>
                                    <Button x:Name="BtnHsRestart" Content="Restart" Style="{StaticResource ActionBtn}" Height="42" Margin="4,0,0,0" IsEnabled="False" Click="BtnHsRestart_Click"/>
                                </UniformGrid>

                                <TextBlock x:Name="HsStatusText" Text="Waiting for VPN connection..." Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="HsManualHint" Visibility="Collapsed" Foreground="{DynamicResource SubTextBrush}" FontSize="11.5" Margin="0,-5,0,5" HorizontalAlignment="Center">
                                    <Run Text="Wi-Fi Direct NIC usually named Local Area Connection*"/>
                                </TextBlock>
                                <Button x:Name="BtnOpenNcpa" Content="Open Network Connections (ncpa.cpl) 🔗" Visibility="Collapsed" Background="Transparent" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" Cursor="Hand" Margin="0,0,0,15" Click="BtnOpenNcpa_Click" FontWeight="Bold" FontSize="12"/>

                                <Border x:Name="HsInfoContainer" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,15" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="SSID:" Foreground="{DynamicResource SubTextBrush}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="HsSsidText" Text="-" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Bold" FontFamily="Consolas"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="PASS:" Foreground="{DynamicResource SubTextBrush}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="HsPassText" Text="-" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Bold" FontFamily="Consolas"/>
                                    </Grid>
                                </Border>

                                <Border x:Name="HsQrContainer" Background="White" CornerRadius="12" Padding="14" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock x:Name="QrScanLbl" Text="📱 Scan to Connect Fast" Foreground="#0F172A" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                                        <Image x:Name="HsQrImage" Width="130" Height="130" Stretch="Uniform"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="HsClientsContainer" Visibility="Collapsed" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10"
                                        Cursor="Hand" MouseEnter="HsClientsContainer_MouseEnter" MouseLeave="HsClientsContainer_MouseLeave">
                                    <Grid>
                                        <TextBlock x:Name="HsClientsCountText" Text="Connected Devices: 0" Foreground="{DynamicResource TextBrush}" FontSize="12" HorizontalAlignment="Center"/>
                                        <Popup x:Name="HsClientsPopup" PlacementTarget="{Binding ElementName=HsClientsContainer}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Width="300">
                                                <TextBox x:Name="HsClientsTextBox" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="130" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" FontFamily="Consolas" FontSize="11" Padding="6"/>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ================= 4. TOOLBOX PANEL ================= -->
                        <Grid x:Name="ToolboxPanel" Visibility="Collapsed">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="ToolsTransform"/>
                            </Grid.RenderTransform>

                            <!-- VIEW 1: REGULAR TOOLBOX HOME VIEW -->
                            <DockPanel x:Name="ToolboxHomeView" LastChildFill="True" Visibility="Visible">
                                <TextBlock DockPanel.Dock="Top" x:Name="ToolboxTitle" Text="🧰 Network Toolbox &amp; Diagnostics" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>
                                
                                <Button DockPanel.Dock="Top" x:Name="SpeedTestBtn" Style="{StaticResource ToolTile}" Click="SpeedTest_Click" Margin="0,0,0,10" Padding="12,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🚀" FontSize="16" Foreground="#22C55E" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SpeedTestLbl" Text="Run Connection Speed Test" FontSize="13" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                                    </StackPanel>
                                </Button>

                                <UniformGrid DockPanel.Dock="Top" Columns="3" Rows="2" Margin="0,0,0,10">
                                    <Button x:Name="RenewIpBtn" Style="{StaticResource ToolTile}" Click="RenewIp_Click">
                                        <StackPanel><TextBlock Text="🔄" FontSize="16" HorizontalAlignment="Center"/><TextBlock x:Name="RenewIpLbl" Text="Renew IP" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel>
                                    </Button>
                                    <Button x:Name="FlushDnsBtn" Style="{StaticResource ToolTile}" Click="FlushDns_Click">
                                        <StackPanel><TextBlock Text="🧹" FontSize="16" HorizontalAlignment="Center"/><TextBlock x:Name="FlushDnsLbl" Text="Flush DNS" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel>
                                    </Button>
                                    <Button x:Name="ProxyOffBtn" Style="{StaticResource ToolTile}" Click="ProxyOff_Click">
                                        <StackPanel><TextBlock Text="🚫" FontSize="16" HorizontalAlignment="Center"/><TextBlock x:Name="DisableProxyLbl" Text="Disable Proxy" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel>
                                    </Button>
                                    <Button x:Name="KillProcBtn" Style="{StaticResource ToolTile}" Click="KillProc_Click">
                                        <StackPanel><TextBlock Text="⛔" FontSize="16" HorizontalAlignment="Center"/><TextBlock x:Name="KillProcLbl" Text="Kill Frozen Procs" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel>
                                    </Button>
                                    <Button x:Name="DnsLeakTestBtn" Style="{StaticResource ToolTile}" Click="DnsLeakTest_Click">
                                        <StackPanel><TextBlock Text="🧪" FontSize="16" HorizontalAlignment="Center"/><TextBlock x:Name="DnsLeakLbl" Text="DNS Leak Test" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel>
                                    </Button>
                                    <Button x:Name="ResetAdapterBtn" Style="{StaticResource ToolTile}" Click="ResetAdapter_Click">
                                        <StackPanel><TextBlock Text="🔁" FontSize="16" HorizontalAlignment="Center"/><TextBlock x:Name="ResetAdapterLbl" Text="Reset Adapter" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel>
                                    </Button>
                                </UniformGrid>

                                <TextBlock DockPanel.Dock="Top" x:Name="PingTraceLbl" Text="🏓 Ping &amp; Traceroute" Style="{StaticResource SectionTitle}"/>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="ToolTargetBox" Height="34" FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Center" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="8,0"/>
                                    <Button Grid.Column="2" x:Name="PingToggleBtn" Content="🏓 Start Ping" Style="{StaticResource ActionBtn}" Click="PingToggle_Click"/>
                                    <Button Grid.Column="4" x:Name="TracerouteToggleBtn" Content="🛰 Traceroute" Style="{StaticResource ActionBtn}" Click="TracerouteToggle_Click"/>
                                </Grid>

                                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBlock x:Name="LogSectionLbl" Text="📡 لاگ ابزارها و پینگ/تریس (Diagnostics Log)" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="CopyLogBtn" Content="📋 کپی لاگ" Style="{StaticResource ActionBtn}" Margin="0,0,6,0" Padding="8,3" Click="CopyLog_Click"/>
                                        <Button x:Name="OpenLogFileBtn" Content="📂 فایل لاگ" Style="{StaticResource ActionBtn}" Margin="0,0,6,0" Padding="8,3" Click="OpenLogFile_Click"/>
                                        <Button x:Name="ClearLogBtn" Content="🗑 پاک‌سازی" Style="{StaticResource ActionBtn}" Padding="8,3" Click="ClearLog_Click"/>
                                    </StackPanel>
                                </Grid>
                                <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="8"/>
                            </DockPanel>

                            <!-- VIEW 2: IN-PLACE SPEED TEST VIEW (COMPACT FIT-TO-PAGE) -->
                            <DockPanel x:Name="ToolboxSpeedTestView" Visibility="Collapsed" LastChildFill="True">
                                <!-- Top Bar with Back Button, Title, and Engine Selector -->
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="SpeedTestBackBtn" Style="{StaticResource ActionBtn}" Padding="8,4" Click="SpeedTestBack_Click" Margin="0,0,10,0" ToolTip="بازگشت به ابزارها">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="←" FontSize="13" FontWeight="Bold" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="بازگشت" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="🚀 تست سرعت اتصال" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="سنجش زنده پینگ، جیتر، سرعت دانلود و آپلود" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="موتور:" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="SpeedEngineCombo" MinWidth="135" Height="26" FontSize="10.5" VerticalAlignment="Center" SelectionChanged="SpeedEngineCombo_SelectionChanged">
                                            <ComboBoxItem Content="Speedtest.net (Ookla)"/>
                                            <ComboBoxItem Content="Cloudflare"/>
                                            <ComboBoxItem Content="M-Lab (NDT7)"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="0">
                                        <!-- Dual Telemetry Cards: Client IP/Loc & Server IP/Loc -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Card 1: Your Client IP & Location -->
                                            <Border Grid.Column="0" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                                                    BorderThickness="1" CornerRadius="10" Padding="10,6" Cursor="Hand" ToolTip="موقعیت و آی‌پی شما (برای بروزرسانی کلیک کنید)" MouseLeftButtonUp="SpeedClientCard_Click">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="7" Background="#183B82F6" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <Ellipse x:Name="SpeedViaDot" Width="8" Height="8" Fill="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📍 اتصال: " FontSize="9" Foreground="{DynamicResource SubTextBrush}"/>
                                                            <TextBlock x:Name="SpeedViaText" Text="Direct Internet" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <TextBlock x:Name="SpeedClientIpText" Text="در حال شناسایی..." FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,1,0,0" FontFamily="Consolas"/>
                                                        <TextBlock x:Name="SpeedClientLocText" Text="—" FontSize="9" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Card 2: Test Server Target IP & Location -->
                                            <Border Grid.Column="2" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                                                    BorderThickness="1" CornerRadius="10" Padding="10,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="7" Background="#1822C55E" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="🎯" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="سرور مقصد تست (Test Server)" FontSize="9" Foreground="{DynamicResource SubTextBrush}"/>
                                                        <TextBlock x:Name="SpeedServerNameText" Text="در حال انتخاب سرور..." FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock x:Name="SpeedServerLocText" Text="—" FontSize="9" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <!-- Vector Speedometer Gauge Card -->
                                        <Border Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                                                BorderThickness="1" CornerRadius="12" Padding="8,6" Margin="0,0,0,6">
                                            <StackPanel>
                                                <Viewbox Width="165" Height="80" FlowDirection="LeftToRight" HorizontalAlignment="Center">
                                                    <Canvas Width="200" Height="116">
                                                        <Path Data="M 20,100 A 80,80 0 0 1 180,100" Stroke="{DynamicResource LineBrush}"
                                                              StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                        <Path x:Name="SpeedGaugeValueArc" Data="M 20,100 A 80,80 0 0 1 180,100" Stroke="{DynamicResource AccentBrush}"
                                                              StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              StrokeDashArray="0 1000"/>
                                                        <TextBlock Canvas.Left="10" Canvas.Top="103" Text="0" FontSize="8" Foreground="#64748B"/>
                                                        <TextBlock Canvas.Left="29" Canvas.Top="42" Text="12" FontSize="8" Foreground="#64748B"/>
                                                        <TextBlock Canvas.Left="94" Canvas.Top="7" Text="25" FontSize="8" Foreground="#64748B"/>
                                                        <TextBlock Canvas.Left="160" Canvas.Top="42" Text="38" FontSize="8" Foreground="#64748B"/>
                                                        <TextBlock Canvas.Left="177" Canvas.Top="103" Text="50+" FontSize="8" Foreground="#64748B"/>
                                                        <Line x:Name="SpeedNeedle" X1="100" Y1="100" X2="100" Y2="36"
                                                              Stroke="#F8FAFC" StrokeThickness="3"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                                            <Line.RenderTransform>
                                                                <RotateTransform x:Name="SpeedNeedleRotate" CenterX="100" CenterY="100" Angle="-90"/>
                                                            </Line.RenderTransform>
                                                        </Line>
                                                        <Ellipse Canvas.Left="93" Canvas.Top="93" Width="14" Height="14" Fill="{DynamicResource AccentBrush}"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Center" Margin="0,1,0,0">
                                                    <TextBlock x:Name="SpeedGaugeArrow" Text="" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,1" Visibility="Collapsed"/>
                                                    <TextBlock x:Name="SpeedGaugeNumText" Text="0.0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                                    <TextBlock Text="Mbps" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Bottom" Margin="5,0,0,3"/>
                                                </StackPanel>
                                                <TextBlock x:Name="SpeedPhaseText" Text="آماده شروع تست" FontSize="11" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- 4 Metric Cards -->
                                        <UniformGrid Columns="4" Margin="0,0,0,6">
                                            <Border Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4,4" Margin="0,0,3,0">
                                                <StackPanel>
                                                    <TextBlock Text="پینگ" FontSize="9" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="SpeedPingVal" Text="—" FontSize="12.5" FontWeight="Bold" FlowDirection="LeftToRight" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,1,0,1"/>
                                                    <Border x:Name="SpeedPingChip" CornerRadius="4" Padding="5,1" HorizontalAlignment="Center" Visibility="Collapsed" Background="#2622C55E">
                                                        <TextBlock x:Name="SpeedPingChipText" Text="" FontSize="8" FontWeight="Bold" Foreground="#22C55E"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4,4" Margin="2,0,2,0">
                                                <StackPanel>
                                                    <TextBlock Text="جیتر" FontSize="9" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="SpeedJitterVal" Text="—" FontSize="12.5" FontWeight="Bold" FlowDirection="LeftToRight" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,1,0,1"/>
                                                    <Border x:Name="SpeedJitterChip" CornerRadius="4" Padding="5,1" HorizontalAlignment="Center" Visibility="Collapsed" Background="#2622C55E">
                                                        <TextBlock x:Name="SpeedJitterChipText" Text="" FontSize="8" FontWeight="Bold" Foreground="#22C55E"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4,4" Margin="2,0,2,0">
                                                <StackPanel>
                                                    <TextBlock Text="دانلود" FontSize="9" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="SpeedDlVal" Text="—" FontSize="12.5" FontWeight="Bold" FlowDirection="LeftToRight" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,1,0,1"/>
                                                    <Border x:Name="SpeedDlChip" CornerRadius="4" Padding="5,1" HorizontalAlignment="Center" Visibility="Collapsed" Background="#2622C55E">
                                                        <TextBlock x:Name="SpeedDlChipText" Text="" FontSize="8" FontWeight="Bold" Foreground="#22C55E"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4,4" Margin="3,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="آپلود" FontSize="9" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="SpeedUlVal" Text="—" FontSize="12.5" FontWeight="Bold" FlowDirection="LeftToRight" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,1,0,1"/>
                                                    <Border x:Name="SpeedUlChip" CornerRadius="4" Padding="5,1" HorizontalAlignment="Center" Visibility="Collapsed" Background="#2622C55E">
                                                        <TextBlock x:Name="SpeedUlChipText" Text="" FontSize="8" FontWeight="Bold" Foreground="#22C55E"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <!-- Progress bar -->
                                        <Border x:Name="SpeedProgressTrack" Height="4" CornerRadius="2" Background="{DynamicResource FieldBrush}" Margin="0,0,0,6">
                                            <Border x:Name="SpeedProgressFill" Width="0" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource AccentBrush}"/>
                                        </Border>

                                        <!-- Action buttons -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" x:Name="SpeedBtnAll" Content="⚡ تست کامل (Full Test)" Style="{StaticResource PrimaryActionBtn}" Height="32" FontSize="11" FontWeight="SemiBold" Click="SpeedAll_Click"/>
                                            <Button Grid.Column="2" x:Name="SpeedBtnDl" Content="⬇ فقط دانلود" Style="{StaticResource ActionBtn}" Height="32" FontSize="10.5" Click="SpeedDl_Click"/>
                                            <Button Grid.Column="4" x:Name="SpeedBtnUl" Content="⬆ فقط آپلود" Style="{StaticResource ActionBtn}" Height="32" FontSize="10.5" Click="SpeedUl_Click"/>
                                            <Button Grid.Column="6" x:Name="SpeedBtnStop" Content="⏹ توقف" Style="{StaticResource ActionBtn}" Height="32" FontSize="10.5" Padding="12,0" Click="SpeedStop_Click"/>
                                        </Grid>

                                        <TextBlock x:Name="SpeedWarnText" Text="⚠️ هر فاز حداکثر تا ۱۰ ثانیه اجرا می‌شود و از حجم اشتراک استفاده می‌کند." FontSize="9" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>

                        <!-- ================= 5. SETTINGS PANEL ================= -->
                        <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.RenderTransform>
                                <TranslateTransform x:Name="SettingsTransform"/>
                            </ScrollViewer.RenderTransform>
                            <StackPanel Margin="2,0">
                                <TextBlock Text="Settings &amp; Configuration" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14"/>

                                <Expander x:Name="AppearanceExpander" Header="🎨 Appearance &amp; Language" IsExpanded="True" Margin="0,0,0,10" Padding="10" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                                    <StackPanel Margin="4,10,4,4">
                                        <TextBlock x:Name="LangLabel" Text="Language" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="LangFaRb" GroupName="Language" Content="فارسی" Margin="0,0,16,0" Checked="LangRb_Click"/>
                                            <RadioButton x:Name="LangEnRb" GroupName="Language" Content="English" Checked="LangRb_Click"/>
                                        </StackPanel>
                                        <TextBlock x:Name="ThemeLabel" Text="Theme" Foreground="{DynamicResource SubTextBrush}" Margin="0,14,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="ThemeDarkRb" GroupName="Theme" Content="Dark" Margin="0,0,16,0" Checked="ThemeRb_Click"/>
                                            <RadioButton x:Name="ThemeLightRb" GroupName="Theme" Content="Light" Margin="0,0,16,0" Checked="ThemeRb_Click"/>
                                            <RadioButton x:Name="ThemeSystemRb" GroupName="Theme" Content="System" Checked="ThemeRb_Click"/>
                                        </StackPanel>
                                        <TextBlock x:Name="FontLabel" Text="Application font" Foreground="{DynamicResource SubTextBrush}" Margin="0,14,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="FontSegoeRb" GroupName="FontChoice" Content="Segoe UI (ویندوز)" Margin="0,0,16,0" IsChecked="True" Checked="FontRb_Click"/>
                                            <RadioButton x:Name="FontVazirRb" GroupName="FontChoice" Content="Vazirmatn (وزیرمتن)" Checked="FontRb_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>

                                <Expander x:Name="BehaviorExpander" Header="⚙ Connection Behavior" Margin="0,0,0,10" Padding="10" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                                    <StackPanel Margin="4,10,4,4">
                                        <CheckBox x:Name="SmartToggle" Content="Smart Connect (Auto try all servers)" Checked="SmartToggle_Changed" Unchecked="SmartToggle_Changed"/>
                                        <CheckBox x:Name="TrayToggle" Content="Minimize to tray instead of closing" Checked="TrayToggle_Changed" Unchecked="TrayToggle_Changed" Margin="0,6,0,0"/>
                                        <CheckBox x:Name="KillSwitchToggle" Content="Kill Switch (Block internet if VPN drops)" Checked="KillSwitchToggle_Changed" Unchecked="KillSwitchToggle_Changed" Margin="0,6,0,0"/>
                                        <CheckBox x:Name="StartupToggle" Content="Start with Windows" Checked="StartupToggle_Changed" Unchecked="StartupToggle_Changed" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Expander>

                                <Expander x:Name="IdleExpander" Header="⏱ Idle Auto-Disconnect" Margin="0,0,0,10" Padding="10" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                                    <StackPanel Margin="4,10,4,4">
                                        <RadioButton x:Name="IdleOffRb" GroupName="IdleMode" Content="Always Connected" Checked="IdleRb_Checked"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <RadioButton x:Name="IdleOnRb" GroupName="IdleMode" Content="Disconnect after" VerticalAlignment="Center" Checked="IdleRb_Checked"/>
                                            <TextBox x:Name="IdleMinutesBox" Width="52" Height="28" Margin="10,0,8,0" FontFamily="Consolas" FontSize="12" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" LostFocus="IdleMinutes_LostFocus"/>
                                            <TextBlock x:Name="IdleMinutesLabel" Text="minutes idle" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>

                                <Expander x:Name="SplitExpander" Header="🔀 Per-App Split Tunneling (Xray / Proxy)" Margin="0,0,0,10" Padding="10" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                                    <StackPanel Margin="4,10,4,4">
                                        <RadioButton x:Name="StOffRb" GroupName="StMode" Tag="off" Content="Tunnel Entire System" Checked="StMode_Checked"/>
                                        <RadioButton x:Name="StAllowRb" GroupName="StMode" Tag="allow" Content="Only selected apps (Allow list)" Checked="StMode_Checked" Margin="0,6,0,0"/>
                                        <RadioButton x:Name="StDenyRb" GroupName="StMode" Tag="deny" Content="Bypass selected apps" Checked="StMode_Checked" Margin="0,6,0,0"/>
                                        <Button x:Name="BtnManagePerApp" Content="⚙️ Manage App List" Click="BtnManagePerApp_Click" Style="{StaticResource ActionBtn}" Margin="0,10,0,2"/>
                                    </StackPanel>
                                </Expander>

                                <Expander x:Name="DnsExpander" Header="🌐 DNS Servers" Margin="0,0,0,10" Padding="10" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                                    <StackPanel Margin="4,10,4,4">
                                        <RadioButton x:Name="DnsAutoRb" GroupName="DnsMode" Tag="auto" Content="Automatic" Checked="DnsRb_Checked"/>
                                        <RadioButton x:Name="DnsCfRb" GroupName="DnsMode" Tag="cloudflare" Content="Cloudflare — 1.1.1.1" Checked="DnsRb_Checked" Margin="0,5,0,0"/>
                                        <RadioButton x:Name="DnsGoogleRb" GroupName="DnsMode" Tag="google" Content="Google — 8.8.8.8" Checked="DnsRb_Checked" Margin="0,5,0,0"/>
                                        <RadioButton x:Name="DnsAdguardRb" GroupName="DnsMode" Tag="adguard" Content="AdGuard — Ad Blocking" Checked="DnsRb_Checked" Margin="0,5,0,0"/>
                                        <RadioButton x:Name="DnsAdguardFamilyRb" GroupName="DnsMode" Tag="adguard_family" Content="AdGuard Family" Checked="DnsRb_Checked" Margin="0,5,0,0"/>
                                        <RadioButton x:Name="DnsCustomRb" GroupName="DnsMode" Tag="custom" Content="Custom DNS" Checked="DnsRb_Checked" Margin="0,5,0,0"/>
                                        <Grid Margin="0,8,0,2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="DnsPrimaryBox" Height="30" FontFamily="Consolas" FontSize="12" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" LostFocus="DnsBox_LostFocus"/>
                                            <TextBox Grid.Column="2" x:Name="DnsSecondaryBox" Height="30" FontFamily="Consolas" FontSize="12" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" LostFocus="DnsBox_LostFocus"/>
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <Expander x:Name="PackageExpander" Header="📦 Package &amp; About" Margin="0,0,0,10" Padding="10" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                                    <StackPanel Margin="4,10,4,4">
                                        <Button x:Name="UpdateBaseBtn" Content="🔧 Update base.ovpn" Style="{StaticResource ActionBtn}" Margin="0,4" Click="UpdateBase_Click"/>
                                        <Button x:Name="ImportBtn" Content="📥 Import OVPN / Package" Style="{StaticResource ActionBtn}" Margin="0,4" Click="Import_Click"/>
                                        <Button x:Name="ExportBtn" Content="📤 Export Connections" Style="{StaticResource ActionBtn}" Margin="0,4" Click="Export_Click"/>
                                        <Button x:Name="AboutBtn" Content="ℹ About &amp; Support" Style="{StaticResource ActionBtn}" Margin="0,10,0,4" Click="About_Click"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ================= 6. CONNECTION LOGS PANEL ================= -->
                        <Grid x:Name="ConnLogPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="ConnLogTransform"/>
                            </Grid.RenderTransform>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock x:Name="ConnLogSectionLbl" Text="📶 لاگ سیستم و کانکشن‌ها" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="CopyConnLogBtn" Content="📋 کپی لاگ" Style="{StaticResource ActionBtn}" Margin="0,0,6,0" Padding="8,3" Click="CopyConnLog_Click"/>
                                    <Button x:Name="OpenConnLogFileBtn" Content="📂 فایل لاگ" Style="{StaticResource ActionBtn}" Margin="0,0,6,0" Padding="8,3" Click="OpenLogFile_Click"/>
                                    <Button x:Name="ClearConnLogBtn" Content="🗑 پاک‌سازی" Style="{StaticResource ActionBtn}" Padding="8,3" Click="ClearConnLog_Click"/>
                                </StackPanel>
                            </Grid>
                            <TextBox Grid.Row="1" x:Name="ConnLogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="8"/>
                        </Grid>

                    </Grid>
                </Grid>

                <!-- ================= MINI WIDGET ================= -->
                <Border x:Name="MiniWidget" Visibility="Collapsed" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="8">
                    <Border.ContextMenu>
                        <ContextMenu><MenuItem x:Name="MiniAlwaysOnTopMenuItem" Header="Always on Top" IsCheckable="True" Click="MiniAlwaysOnTop_Click"/></ContextMenu>
                    </Border.ContextMenu>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="MiniPowerBtn" Width="44" Height="44" Background="#334155" Cursor="Hand" Click="Power_Click">
                            <Button.Effect><DropShadowEffect x:Name="MiniPowerGlow" Color="#22C55E" BlurRadius="12" Opacity="0"/></Button.Effect>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="22">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Path Width="20" Height="20" Stretch="Uniform" Data="M 12,2.5 L 12,11.5 M 7.05,5.6 A 8.5,8.5 0 1 0 16.95,5.6" Stroke="White" StrokeThickness="2"/>
                        </Button>
                        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="MiniStatusDot" Width="7" Height="7" Fill="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="MiniStatusText" Text="Ready" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="MiniConnectionText" Text="—" FontSize="10" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0"/>
                            <TextBlock x:Name="MiniSpeedText" Text="↓ 0 B/s   ↑ 0 B/s" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" x:Name="MiniRestoreBtn" Width="42" Height="42" Background="{DynamicResource AccentBrush}" Cursor="Hand" Click="MiniRestoreBtn_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="⤢" FontSize="19" Foreground="White"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- DRAWER OVERLAY (Preserved) -->
            <Grid x:Name="DrawerOverlay" Grid.RowSpan="2" Background="#80000000" Visibility="Collapsed" Panel.ZIndex="999" MouseLeftButtonDown="DrawerOverlay_MouseLeftButtonDown">
                <Border x:Name="DrawerMenuPanel" HorizontalAlignment="Left" Width="260" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,1,0" MouseLeftButtonDown="DrawerMenuPanel_MouseLeftButtonDown">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="20,20,20,10">
                            <TextBlock x:Name="DrawerTitleText" Text="Main Menu" Foreground="{DynamicResource TextBrush}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="DrawerClose_Click">
                                <Path Data="M18 6L6 18M6 6l12 12" Stroke="#94A3B8" StrokeThickness="2" Stretch="Uniform" Width="14" Height="14"/>
                            </Button>
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="10,20,10,10">
                            <Button Style="{StaticResource DrawerNavBtn}" Click="HotspotNavHome_Click"><TextBlock x:Name="DrawerNavHomeText" Text="🏠 Dashboard" Foreground="{DynamicResource TextBrush}"/></Button>
                            <Button Style="{StaticResource DrawerNavBtn}" Margin="0,5,0,0" Click="HotspotNavXray_Click"><TextBlock x:Name="DrawerNavXrayText" Text="🚀 Xray Service" Foreground="{DynamicResource TextBrush}"/></Button>
                            <Button Style="{StaticResource DrawerNavBtn}" Margin="0,5,0,0" Click="HotspotNavLogs_Click"><TextBlock x:Name="DrawerNavLogsText" Text="📄 Connection Logs" Foreground="{DynamicResource TextBrush}"/></Button>
                            <Button Style="{StaticResource DrawerNavBtn}" Margin="0,5,0,0" Click="OpenHotspotWindow_Click"><TextBlock x:Name="DrawerNavHotspotText" Text="🛜 Hotspot Manager" Foreground="{DynamicResource TextBrush}"/></Button>
                            <Button Style="{StaticResource DrawerNavBtn}" Margin="0,5,0,0" Click="HotspotNavTools_Click"><TextBlock x:Name="DrawerNavToolsText" Text="🧰 Toolbox" Foreground="{DynamicResource TextBrush}"/></Button>
                            <Button Style="{StaticResource DrawerNavBtn}" Margin="0,5,0,0" Click="HotspotNavSettings_Click"><TextBlock x:Name="DrawerNavSettingsText" Text="⚙ Settings" Foreground="{DynamicResource TextBrush}"/></Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- IN-APP VPN URL IMPORT MODAL OVERLAY -->
            <Grid x:Name="VpnUrlImportOverlay" Grid.RowSpan="2" Background="#B0000000" Visibility="Collapsed" Panel.ZIndex="998" MouseLeftButtonDown="VpnUrlImportOverlay_MouseLeftButtonDown">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="380" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20,18" MouseLeftButtonDown="VpnUrlImportModal_MouseLeftButtonDown">
                    <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#000000" Opacity="0.7"/></Border.Effect>
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock x:Name="VpnUrlImportTitleText" Text="🌐 دریافت کانکشن OpenVPN از لینک" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="VpnUrlImportCancel_Click">
                                <Path Data="M18 6L6 18M6 6l12 12" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="2" Stretch="Uniform" Width="12" Height="12"/>
                            </Button>
                        </Grid>
                        <TextBlock Text="نام کانکشن (اختیاری):" Foreground="{DynamicResource SubTextBrush}" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="VpnUrlImportNameInput" Height="34" Padding="8,6" Margin="0,0,0,10" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" FontSize="11.5" VerticalContentAlignment="Center"/>
                        <TextBlock Text="لینک مستقیم فایل کانفیگ (.ovpn):" Foreground="{DynamicResource SubTextBrush}" FontSize="11" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="VpnUrlImportUrlInput" Grid.Column="0" Height="34" Padding="8,6" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" FontSize="11.5" VerticalContentAlignment="Center" KeyDown="VpnUrlImportUrlInput_KeyDown"/>
                            <Button Grid.Column="1" Content="📋 Paste" Style="{StaticResource ActionBtn}" Padding="10,0" Height="34" Margin="6,0,0,0" FontSize="11" Click="VpnUrlImportPaste_Click"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="VpnUrlImportSubmitBtn" Content="دریافت و بارگذاری" Style="{StaticResource PrimaryActionBtn}" Height="36" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0" Click="VpnUrlImportSubmit_Click"/>
                            <Button Grid.Column="1" Content="انصراف" Style="{StaticResource ActionBtn}" Height="36" FontSize="12" Margin="6,0,0,0" Click="VpnUrlImportCancel_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- IN-APP SUB INPUT MODAL OVERLAY -->
            <Grid x:Name="XraySubOverlay" Grid.RowSpan="2" Background="#B0000000" Visibility="Collapsed" Panel.ZIndex="998" MouseLeftButtonDown="XraySubOverlay_MouseLeftButtonDown">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="360" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20,18" MouseLeftButtonDown="XraySubModal_MouseLeftButtonDown">
                    <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#000000" Opacity="0.7"/></Border.Effect>
                    <StackPanel x:Name="XraySubModalStack">
                        <Grid Margin="0,0,0,14">
                            <TextBlock x:Name="XraySubTitleText" Text="🔗 Add Xray Subscription Link" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="XraySubCancel_Click">
                                <Path Data="M18 6L6 18M6 6l12 12" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="2" Stretch="Uniform" Width="12" Height="12"/>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="XraySubNameHintText" Text="Subscription / Group Name (Optional):" Foreground="{DynamicResource SubTextBrush}" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="XraySubNameInput" Height="34" Padding="8,6" Margin="0,0,0,10" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" FontSize="11.5" VerticalContentAlignment="Center"/>
                        <TextBlock x:Name="XraySubHintText" Text="Enter subscription link or node URL:" Foreground="{DynamicResource SubTextBrush}" FontSize="11" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="XraySubUrlInput" Grid.Column="0" Height="34" Padding="8,6" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" FontSize="11.5" VerticalContentAlignment="Center" KeyDown="XraySubUrlInput_KeyDown"/>
                            <Button Grid.Column="1" x:Name="XraySubPasteBtn" Content="📋 Paste" Style="{StaticResource ActionBtn}" Padding="10,0" Height="34" Margin="6,0,0,0" FontSize="11" Click="XraySubPaste_Click"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="XraySubSubmitBtn" Content="Save &amp; Import" Style="{StaticResource PrimaryActionBtn}" Height="36" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0" Click="XraySubSubmit_Click"/>
                            <Button Grid.Column="1" x:Name="XraySubCancelBtn" Content="Cancel" Style="{StaticResource ActionBtn}" Height="36" FontSize="12" Margin="6,0,0,0" Click="XraySubCancel_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- IN-APP SHARE MODAL OVERLAY -->
            <Grid x:Name="XrayShareOverlay" Grid.RowSpan="2" Background="#B0000000" Visibility="Collapsed" Panel.ZIndex="998" MouseLeftButtonDown="XrayShareOverlay_MouseLeftButtonDown">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="340" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20,18" MouseLeftButtonDown="XrayShareModal_MouseLeftButtonDown">
                    <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#000000" Opacity="0.7"/></Border.Effect>
                    <StackPanel x:Name="XrayShareModalStack">
                        <Grid Margin="0,0,0,12">
                            <TextBlock x:Name="XrayShareTitleText" Text="📱 Share Connection" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="XrayShareClose_Click">
                                <Path Data="M18 6L6 18M6 6l12 12" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="2" Stretch="Uniform" Width="12" Height="12"/>
                            </Button>
                        </Grid>
                        <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <Border Background="#1E293B" CornerRadius="4" Padding="5,1" Margin="0,0,6,0"><TextBlock x:Name="XrayShareProtoBadge" Text="VLESS" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/></Border>
                                    <TextBlock x:Name="XrayShareAliasText" Text="Server Name" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                                <TextBlock x:Name="XrayShareAddressText" Text="1.2.3.4:443" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="10" Padding="10" Margin="0,0,0,12" HorizontalAlignment="Center">
                            <Image x:Name="XrayShareQrImage" Width="150" Height="150" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Border>
                        <TextBlock x:Name="XrayShareHintText" Text="Scan with camera or mobile VPN app" Foreground="{DynamicResource SubTextBrush}" FontSize="10.5" TextAlignment="Center" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="XrayShareCopyBtn" Content="📋 Copy Link" Style="{StaticResource PrimaryActionBtn}" Height="34" FontSize="12" Margin="0,0,6,0" Click="XrayShareCopyBtn_Click"/>
                            <Button Grid.Column="1" x:Name="XrayShareCloseBtn" Content="Close" Style="{StaticResource ActionBtn}" Height="34" Padding="14,0" FontSize="12" Click="XrayShareClose_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- IN-APP MESSAGE MODAL OVERLAY -->
            <Grid x:Name="InAppMessageOverlay" Grid.RowSpan="2" Background="#B0000000" Visibility="Collapsed" Panel.ZIndex="1000" MouseLeftButtonDown="InAppMsgOverlay_Dismiss">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="330" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20,18" MouseLeftButtonDown="InAppMsgBox_MouseLeftButtonDown">
                    <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#000000" Opacity="0.7"/></Border.Effect>
                    <StackPanel x:Name="InAppMessageModalStack">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock x:Name="InAppMsgIcon" Text="ℹ" FontSize="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="InAppMsgTitle" Text="System Message" Foreground="{DynamicResource TextBrush}" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="InAppMsgText" Text="Message" Foreground="{DynamicResource SubTextBrush}" FontSize="12" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,16"/>
                        <Button x:Name="InAppMsgOkBtn" Content="OK" Style="{StaticResource PrimaryActionBtn}" Height="34" Width="100" HorizontalAlignment="Center" FontSize="12" Click="InAppMsgOverlay_Dismiss"/>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
