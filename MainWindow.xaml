<Window x:Class="SmartVpn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:TextOptions="clr-namespace:System.Windows.Media;assembly=PresentationCore"
        Title="NETFASTVIP" Width="420" Height="790"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="./Fonts/#Vazirmatn, Vazirmatn, Segoe UI, Tahoma"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="2,14,2,6"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>

        <Style x:Key="ToolTile" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="6,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <LinearGradientBrush x:Key="DlAreaBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#553B82F6" Offset="0"/>
            <GradientStop Color="#003B82F6" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="UlAreaBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#5522C55E" Offset="0"/>
            <GradientStop Color="#0022C55E" Offset="1"/>
        </LinearGradientBrush>

        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="PowerScale" Storyboard.TargetProperty="ScaleX"
                              From="1" To="1.08" Duration="0:0:0.9"/>
            <DoubleAnimation Storyboard.TargetName="PowerScale" Storyboard.TargetProperty="ScaleY"
                              From="1" To="1.08" Duration="0:0:0.9"/>
        </Storyboard>
        <Storyboard x:Key="SpinStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="PowerGlyphRotate" Storyboard.TargetProperty="Angle"
                              From="0" To="360" Duration="0:0:1"/>
        </Storyboard>
        <Storyboard x:Key="SubRefreshSpinStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SubRefreshRotate" Storyboard.TargetProperty="Angle"
                              From="0" To="360" Duration="0:0:0.8"/>
        </Storyboard>
        <Storyboard x:Key="HotspotPulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="HotspotHeaderScale" Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.12" Duration="0:0:0.8"/>
            <DoubleAnimation Storyboard.TargetName="HotspotHeaderScale" Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.12" Duration="0:0:0.8"/>
        </Storyboard>
    </Window.Resources>

    <Border x:Name="WindowSurface" Margin="0"
            Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
            CornerRadius="14" ClipToBounds="True">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="31"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- نوار عنوان داخلی؛ چون بعضی نسخه‌های ویندوز رنگ Native TitleBar را نادیده می‌گیرند،
             کنترل بستن و کمینه‌سازی را خود برنامه در اختیار می‌گیرد. -->
        <Border x:Name="AppTitleBar" Grid.Row="0" Height="31"
                CornerRadius="11,11,0,0" ClipToBounds="True"
                Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="AppTitleBar_MouseLeftButtonDown">
            <Grid FlowDirection="LeftToRight">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,9,0" FlowDirection="LeftToRight">
                    <TextBlock Text="NETFASTVIP" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource SubTextBrush}"
                               VerticalAlignment="Center"/>
                    <Image Source="/app.ico" Width="16" Height="16" Margin="7,0,0,0"
                           Stretch="Uniform" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                    <Button x:Name="TitleCloseButton" Width="38" Height="31"
                            Content="×" FontSize="16" Padding="0"
                            Background="Transparent" Foreground="{DynamicResource SubTextBrush}"
                            BorderThickness="0" Cursor="Hand" ToolTip="بستن"
                            Click="TitleCloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="11,0,0,0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="TitleMinimizeButton" Width="38" Height="31"
                            Content="—" FontSize="14" Padding="0"
                            Background="Transparent" Foreground="{DynamicResource SubTextBrush}"
                            BorderThickness="0" Cursor="Hand" ToolTip="کمینه‌سازی"
                            Click="TitleMinimizeButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale"/>
        </Grid.LayoutTransform>
        <!-- ================= NORMAL MODE ================= -->
        <Grid x:Name="RootGrid" Margin="14,10,14,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Glass header -->
            <Border Grid.Row="0" Margin="2,0,2,8" CornerRadius="12" Padding="8,6" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#40FFFFFF" Offset="0"/>
                        <GradientStop Color="#4D1E293B" Offset="0.12"/>
                        <GradientStop Color="#331E293B" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#55FFFFFF" Offset="0"/>
                        <GradientStop Color="#15FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="2" Opacity="0.22"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                    <StackPanel x:Name="HeaderBrandPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,1,7,0"/>
                        <TextBlock x:Name="BrandTitleText" Text="NETFASTVIP" FontSize="14.5" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" FlowDirection="LeftToRight"
                                   Cursor="Hand" ToolTip="کانال تلگرام"
                                   MouseLeftButtonUp="BrandTitleText_Click"/>
                    </StackPanel>
                    <StackPanel x:Name="HeaderPagePanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <Button x:Name="BackBtn" Width="28" Height="26" Margin="0,0,8,0"
                                Style="{StaticResource ActionBtn}" Padding="0"
                            Content="⌂" FontSize="16" ToolTip="صفحه اصلی" Click="HotspotNavHome_Click"/>
                        <TextBlock x:Name="HeaderTitleText" Text="" FontSize="14.5" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="HeaderPowerBtn" Width="32" Height="26" Margin="0,0,6,0"
                                Style="{StaticResource ActionBtn}" Padding="0"
                                Content="⏻" ToolTip="روشن/خاموش اتصال" Click="Power_Click">
                            <Button.Effect>
                                <DropShadowEffect Color="#33415A" BlurRadius="10" ShadowDepth="0" Opacity="0"/>
                            </Button.Effect>
                        </Button>
                        <Button x:Name="HeaderLogBtn" Width="32" Height="26" Margin="0,0,6,0"
                                Style="{StaticResource ActionBtn}" Padding="0"
                                Content="📜" ToolTip="گزارش کانکشن‌ها" Click="HotspotNavLogs_Click"/>
                        <Button x:Name="HeaderHotspotBtn" Width="32" Height="26" Margin="0,0,6,0"
                                Style="{StaticResource ActionBtn}" Padding="0"
                                ToolTip="باز کردن پنجره Hotspot" Click="OpenHotspotWindow_Click">
                            <TextBlock x:Name="HotspotHeaderIcon" Text="📶"
                                       FontSize="15" Foreground="#64748B"
                                       VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock.RenderTransform>
                                    <ScaleTransform x:Name="HotspotHeaderScale" CenterX="0.5" CenterY="0.5"/>
                                </TextBlock.RenderTransform>
                                <TextBlock.Effect>
                                    <DropShadowEffect x:Name="HotspotHeaderGlow" Color="#22C55E"
                                                      BlurRadius="10" ShadowDepth="0" Opacity="0"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </Button>
                        <Button x:Name="HeaderToolsBtn" Width="32" Height="26" Margin="0,0,6,0"
                                Style="{StaticResource ActionBtn}" Padding="0" Tag="tools"
                                Content="🧰" ToolTip="ابزارها و گزارش" Click="HotspotNavTools_Click"/>
                        <Button x:Name="HeaderSettingsBtn" Width="32" Height="26"
                                Style="{StaticResource ActionBtn}" Padding="0" Tag="settings"
                                Content="⚙" ToolTip="تنظیمات" Click="HotspotNavSettings_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= HOME ================= -->
            <Grid Grid.Row="1" x:Name="HomePanel">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="HomeTransform"/>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Compact connection info card -->
                <Border Grid.Row="0" Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="14,10" ClipToBounds="True">
                    <StackPanel>
                        <!-- Top: power left, connection summary right -->
                        <Grid FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="82"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Button x:Name="PowerBtn" Width="60" Height="60"
                                        Background="#334155" Cursor="Hand" Click="Power_Click"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Button.RenderTransform>
                                        <ScaleTransform x:Name="PowerScale" ScaleX="1" ScaleY="1"/>
                                    </Button.RenderTransform>
                                    <Button.Effect>
                                        <DropShadowEffect Color="#22C55E" BlurRadius="18" ShadowDepth="0" Opacity="0.35"/>
                                    </Button.Effect>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>
                                                <Ellipse Fill="#172131" Stroke="#1F3F3A" StrokeThickness="4"/>
                                                <Ellipse Margin="6" Fill="{TemplateBinding Background}"/>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Path x:Name="PowerGlyph" Width="24" Height="24" Stretch="Uniform"
                                          Data="M 12,2.5 L 12,11.5 M 7.05,5.6 A 8.5,8.5 0 1 0 16.95,5.6"
                                          Stroke="#F8FAFC" StrokeThickness="2.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="PowerGlyphRotate" Angle="0"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </Button>
                                <TextBlock x:Name="PowerHintText" Visibility="Collapsed" Text="Click to Connect" FontSize="10" Margin="0,5,0,0"
                                           Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" FlowDirection="RightToLeft" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#64748B" Visibility="Collapsed"
                                             VerticalAlignment="Center" Margin="0,0,0,0"/>
                                    <TextBlock x:Name="StatusText" Text="آماده اتصال" Visibility="Collapsed"/>
                                </StackPanel>
                                <TextBlock x:Name="ActiveConnText" Text="—" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,0"
                                           Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                                    <TextBlock x:Name="ServerSubText" Text="" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" FlowDirection="LeftToRight"/>
                                </StackPanel>
                                <TextBlock x:Name="GeoIpText" Text="—" FontSize="10.5" Margin="0,4,0,0"
                                           Foreground="{DynamicResource SubTextBrush}" FlowDirection="LeftToRight"
                                           HorizontalAlignment="Right"/>
                                <TextBlock x:Name="DurationText" Text="00:00:00" FontSize="11" FontWeight="Bold" Margin="0,5,0,0"
                                           Foreground="#A855F7" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Margin="0,8,0,7" Background="{DynamicResource LineBrush}" Opacity="0.75"/>

                        <Button x:Name="MoreInfoBtn" Click="MoreInfoToggle_Click" Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource SubTextBrush}" Padding="0" Margin="0,5,0,0"
                                Cursor="Hand" HorizontalAlignment="Right" HorizontalContentAlignment="Right" Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                                <TextBlock x:Name="MoreInfoText" Text="Details" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SubTextBrush}" Margin="0,0,4,0"/>
                                <TextBlock x:Name="MoreInfoArrow" Text="⌄" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource SubTextBrush}" Margin="0,-1,0,0"/>
                            </StackPanel>
                        </Button>

                        <Border x:Name="MoreInfoPanel" Visibility="Collapsed" Padding="0,7,0,0">
                            <StackPanel>
                                <Border Background="{DynamicResource BgBrush}" CornerRadius="7"
                                        Padding="4" ClipToBounds="True" Margin="0,0,0,10">
                                    <Grid Height="58">
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Opacity="0.35"/>
                                        <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Opacity="0.35"/>
                                        <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Opacity="0.35"/>
                                        <Canvas x:Name="GraphCanvas" Grid.RowSpan="4" FlowDirection="LeftToRight">
                                            <Polygon x:Name="DlArea" Fill="{StaticResource DlAreaBrush}"/>
                                            <Polygon x:Name="UlArea" Fill="{StaticResource UlAreaBrush}"/>
                                            <Polyline x:Name="DlLine" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8"/>
                                            <Polyline x:Name="UlLine" Stroke="#22C55E" StrokeThickness="1.5"/>
                                        </Canvas>
                                        <Border Grid.RowSpan="4" HorizontalAlignment="Left" VerticalAlignment="Bottom" CornerRadius="4" Padding="4,1"
                                                Background="#CC030A16" Margin="1,0,0,1">
                                            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                                                <TextBlock x:Name="DlSpeedText" Text="↓ 0 B/s" FontSize="9" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="UlSpeedText" Text="↑ 0 B/s" FontSize="9" FontWeight="Bold" Foreground="#22C55E"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            <UniformGrid Columns="2" Rows="3" FlowDirection="LeftToRight">
                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="9,7" Margin="0,0,5,5">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Ping" FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                                        <TextBlock Grid.Column="1" x:Name="PingText" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="#22C55E" FlowDirection="LeftToRight"/>
                                    </Grid>
                                </Border>
                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="9,7" Margin="5,0,0,5">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Session" FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                                        <TextBlock Grid.Column="1" x:Name="SessionTrafficText" Text="0 B" FontSize="11" FontWeight="SemiBold" Foreground="#3B82F6" FlowDirection="LeftToRight"/>
                                    </Grid>
                                </Border>
                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="9,7" Margin="0,5,5,5">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Tunnel IP" FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                                        <TextBlock Grid.Column="1" x:Name="PrivateIpText" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" FlowDirection="LeftToRight"
                                                   Cursor="Hand" ToolTip="برای کپی کلیک کنید" MouseLeftButtonDown="CopyIpText_Click"/>
                                    </Grid>
                                </Border>
                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="9,7" Margin="5,5,0,5">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Server IP" FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                                        <TextBlock Grid.Column="1" x:Name="ServerIpText" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" FlowDirection="LeftToRight"
                                                   Cursor="Hand" ToolTip="برای کپی کلیک کنید" MouseLeftButtonDown="CopyIpText_Click"/>
                                    </Grid>
                                </Border>
                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="9,7" Margin="0,5,5,0">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="YouLbl" Text="User" FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                                        <TextBlock Grid.Column="1" x:Name="YouText" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" FlowDirection="LeftToRight"/>
                                    </Grid>
                                </Border>
                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="9,7" Margin="5,5,0,0">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="ProtocolLbl" Text="Protocol" FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                                        <TextBlock Grid.Column="1" x:Name="ProtocolText" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" FlowDirection="LeftToRight"/>
                                    </Grid>
                                </Border>
                            </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Connections header -->
                <Grid Grid.Row="1" Margin="2,12,2,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="ConnSectionLabel" Text="کانکشن‌ها" FontWeight="Bold" FontSize="13"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="AddBtn" Content="＋ Add" Style="{StaticResource ActionBtn}" FontSize="10.5" FontWeight="Bold"
                                Padding="9,3" Margin="0,0,8,0" Foreground="White" Background="#3B82F6" BorderBrush="#3B82F6"
                                ToolTip="افزودن کانکشن جدید" Click="Add_Click"/>
                        <Button x:Name="FilterDropdownBtn" Style="{StaticResource ActionBtn}" FontSize="10.5" Padding="9,3" Click="FilterDropdownBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="FilterDropdownLabel" Text="همه" FontSize="10.5"/>
                                <TextBlock Text=" ⌄" FontSize="10" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Connections list -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ConnList" Margin="0,4,0,10"/>
                </ScrollViewer>

                <!-- کارت خلاصه اشتراک -->
                <Border Grid.Row="3" x:Name="SubSummaryCard"
                        Background="{DynamicResource RowCardBrush}" BorderBrush="{DynamicResource RowLineBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="9,7" Margin="2,8,2,2">
                    <StackPanel>
                        <Grid FlowDirection="LeftToRight" Cursor="Hand" ToolTip="مشاهده / استعلام وضعیت اشتراک" MouseLeftButtonUp="SubSummaryCard_Click">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" x:Name="SubRefreshBtn" Width="28" Height="28" Padding="0"
                                    VerticalAlignment="Center" Style="{StaticResource ActionBtn}" Visibility="Collapsed"
                                    ToolTip="بروزرسانی وضعیت اشتراک" Click="SubRefreshBtn_Click">
                                <TextBlock Text="🔄" FontSize="12" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform x:Name="SubRefreshRotate" Angle="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Button>

                            <StackPanel Grid.Column="1" FlowDirection="RightToLeft" VerticalAlignment="Center" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock x:Name="SubSectionLabel" Text="🎫 اشتراک من" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Border x:Name="SubActiveBadge" Background="Transparent"
                                            Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="SubActiveDot" Width="5" Height="5" Fill="#22C55E"
                                                     VerticalAlignment="Center" Margin="0,0,3,0"/>
                                            <TextBlock x:Name="SubActiveText" Text="فعال" FontSize="8.5" FontWeight="Normal"
                                                       Foreground="{DynamicResource SubTextBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="SubEmptyText" Text="برای مشاهده وضعیت اشتراک کلیک کنید" FontSize="9.5"
                                           Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0"
                                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>

                        <Border x:Name="SubDetailPanel" Visibility="Collapsed" Padding="0,8,0,0">
                            <StackPanel FlowDirection="LeftToRight">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock x:Name="SubTimeLbl" Text="⏳ زمان باقی‌مانده" FontSize="9"
                                                   Foreground="{DynamicResource SubTextBrush}"
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="SubTimeLeftText" Text="—" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}" Margin="0,2,0,0"
                                                   FlowDirection="LeftToRight" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock x:Name="SubDataLbl" Text="📦 حجم باقی‌مانده" FontSize="9"
                                                   Foreground="{DynamicResource SubTextBrush}"
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="SubDataLeftText" Text="—" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}" Margin="0,2,0,0"
                                                   FlowDirection="LeftToRight" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="SubUpdatedText" Text="—" FontSize="8.5" Margin="0,7,0,0"
                                           Foreground="{DynamicResource SubTextBrush}" FlowDirection="RightToLeft"
                                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= TOOLBOX + LOG ================= -->
            <DockPanel Grid.Row="1" x:Name="ToolboxPanel" Visibility="Collapsed"
                       Margin="2,0" LastChildFill="True">
                <DockPanel.RenderTransform>
                    <TranslateTransform x:Name="ToolsTransform"/>
                </DockPanel.RenderTransform>
                    <TextBlock DockPanel.Dock="Top" x:Name="ToolboxTitle" Text="🧰 جعبه‌ابزار و عیب‌یابی شبکه" Style="{StaticResource SectionTitle}"/>
                    
                    <Button DockPanel.Dock="Top" x:Name="SpeedTestBtn" Style="{StaticResource ToolTile}" Click="SpeedTest_Click"
                            Margin="3,3,3,1" Padding="6,9"
                            ToolTip="اندازه‌گیری پینگ، جیتر و سرعت دانلود/آپلود">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚀" FontSize="15" Foreground="#22C55E" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SpeedTestLbl" Text="تست سرعت اتصال" FontSize="11.5" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                    </Button>

                    <UniformGrid DockPanel.Dock="Top" Columns="2" Rows="3">
                        <Button x:Name="RenewIpBtn" Style="{StaticResource ToolTile}" Click="RenewIp_Click"
                                ToolTip="وقتی شبکه وصل است ولی اینترنت ندارید">
                            <StackPanel>
                                <TextBlock Text="🔄" FontSize="15" HorizontalAlignment="Center" Foreground="#3B82F6"/>
                                <TextBlock x:Name="RenewIpLbl" Text="تمدید IP" FontSize="10.5" Margin="0,3,0,0" HorizontalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="FlushDnsBtn" Style="{StaticResource ToolTile}" Click="FlushDns_Click"
                                ToolTip="وقتی بعد از تغییر VPN سایت‌ها باز نمی‌شوند">
                            <StackPanel>
                                <TextBlock Text="🧹" FontSize="15" HorizontalAlignment="Center" Foreground="#F59E0B"/>
                                <TextBlock x:Name="FlushDnsLbl" Text="پاک‌سازی DNS" FontSize="10.5" Margin="0,3,0,0" HorizontalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ProxyOffBtn" Style="{StaticResource ToolTile}" Click="ProxyOff_Click"
                                ToolTip="وقتی پراکسی قدیمی، مرورگر را خراب کرده است">
                            <StackPanel>
                                <TextBlock Text="🚫" FontSize="15" HorizontalAlignment="Center" Foreground="#6366F1"/>
                                <TextBlock x:Name="DisableProxyLbl" Text="غیرفعال‌کردن پراکسی" FontSize="10.5" Margin="0,3,0,0" HorizontalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="KillProcBtn" Style="{StaticResource ToolTile}" Click="KillProc_Click"
                                ToolTip="وقتی اتصال قبلی گیر کرده و قطع نمی‌شود">
                            <StackPanel>
                                <TextBlock Text="⛔" FontSize="15" HorizontalAlignment="Center" Foreground="#EF4444"/>
                                <TextBlock x:Name="KillProcLbl" Text="بستن پروسه‌های گیرکرده" FontSize="10.5" Margin="0,3,0,0" HorizontalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="DnsLeakTestBtn" Style="{StaticResource ToolTile}" Click="DnsLeakTest_Click"
                                ToolTip="بررسی اینکه DNS شما هم از داخل تانل رد می‌شود یا نشت دارد">
                            <StackPanel>
                                <TextBlock Text="🧪" FontSize="15" HorizontalAlignment="Center" Foreground="#14B8A6"/>
                                <TextBlock x:Name="DnsLeakLbl" Text="تست نشتی DNS" FontSize="10.5" Margin="0,3,0,0" HorizontalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ResetAdapterBtn" Style="{StaticResource ToolTile}" Click="ResetAdapter_Click"
                                ToolTip="غیرفعال و فعال‌کردن کارت شبکه">
                            <StackPanel>
                                <TextBlock Text="🔁" FontSize="15" HorizontalAlignment="Center" Foreground="#F43F5E"/>
                                <TextBlock x:Name="ResetAdapterLbl" Text="ریست آداپتور" FontSize="10.5" Margin="0,3,0,0" HorizontalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <TextBlock DockPanel.Dock="Top" x:Name="PingTraceLbl" Text="🏓 پینگ / Traceroute" Style="{StaticResource SectionTitle}"/>
                    <TextBox DockPanel.Dock="Top" x:Name="ToolTargetBox" Height="30" Margin="0,0,0,6"
                             FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="12"
                             VerticalContentAlignment="Center"
                             Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                             ToolTip="هدف دلخواه (IP یا دامنه)"/>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="PingToggleBtn" Content="🏓 شروع پینگ"
                                Style="{StaticResource ActionBtn}" Click="PingToggle_Click"/>
                        <Button Grid.Column="2" x:Name="TracerouteToggleBtn" Content="🛰 شروع Traceroute"
                                Style="{StaticResource ActionBtn}" Click="TracerouteToggle_Click"/>
                    </Grid>

                    <Grid DockPanel.Dock="Top" Margin="0,10,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="LogSectionLbl" Text="📜 گزارش" Style="{StaticResource SectionTitle}" Margin="0"/>
                        <Button Grid.Column="1" x:Name="ClearLogBtn" Content="🗑 پاک‌سازی" Style="{StaticResource ActionBtn}" Padding="8,4" Click="ClearLog_Click"/>
                    </Grid>
                    <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" Margin="0,0,0,4"
                             VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight"
                             FontFamily="Consolas" FontSize="11"
                             Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"/>
            </DockPanel>

            <!-- ================= SETTINGS ================= -->
            <ScrollViewer Grid.Row="1" x:Name="SettingsPanel" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <ScrollViewer.RenderTransform>
                    <TranslateTransform x:Name="SettingsTransform"/>
                </ScrollViewer.RenderTransform>
                <StackPanel Margin="2,0">
                    <Expander x:Name="AppearanceExpander" Header="🎨 ظاهر برنامه" IsExpanded="True"
                              Margin="0,4,0,6" Padding="8" Foreground="{DynamicResource TextBrush}"
                              Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
                              BorderThickness="1">
                        <StackPanel Margin="2,8,2,2">
                            <TextBlock x:Name="LangLabel" Text="زبان برنامه" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="LangFaRb" GroupName="Language" Content="فارسی" Margin="0,0,14,0" Checked="LangRb_Click"/>
                                <RadioButton x:Name="LangEnRb" GroupName="Language" Content="English" Checked="LangRb_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="ThemeLabel" Text="تم برنامه" Foreground="{DynamicResource SubTextBrush}" Margin="0,12,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ThemeDarkRb" GroupName="Theme" Content="تیره" Margin="0,0,14,0" Checked="ThemeRb_Click"/>
                                <RadioButton x:Name="ThemeLightRb" GroupName="Theme" Content="روشن" Margin="0,0,14,0" Checked="ThemeRb_Click"/>
                                <RadioButton x:Name="ThemeSystemRb" GroupName="Theme" Content="سیستم" Checked="ThemeRb_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="BehaviorExpander" Header="⚙ رفتار اتصال" Margin="0,0,0,6" Padding="8"
                              Foreground="{DynamicResource TextBrush}" Background="{DynamicResource CardBrush}"
                              BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                        <StackPanel Margin="2,8,2,2">
                            <CheckBox x:Name="SmartToggle" Content="اتصال هوشمند (امتحان خودکار همه کانکشن‌ها)"
                                      Checked="SmartToggle_Changed" Unchecked="SmartToggle_Changed"/>
                            <CheckBox x:Name="TrayToggle" Content="مخفی‌شدن در کنار ساعت به‌جای بستن"
                                      Checked="TrayToggle_Changed" Unchecked="TrayToggle_Changed" Margin="0,5,0,0"/>
                            <CheckBox x:Name="KillSwitchToggle" Content="Kill Switch" Margin="0,5,0,0"
                                      Checked="KillSwitchToggle_Changed" Unchecked="KillSwitchToggle_Changed"/>
                            <CheckBox x:Name="StartupToggle" Content="اجرای خودکار با ویندوز"
                                      Checked="StartupToggle_Changed" Unchecked="StartupToggle_Changed" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="IdleExpander" Header="⏱ قطع خودکار در بی‌استفادگی" Margin="0,0,0,6" Padding="8"
                              Foreground="{DynamicResource TextBrush}" Background="{DynamicResource CardBrush}"
                              BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                        <StackPanel Margin="2,8,2,2">
                            <RadioButton x:Name="IdleOffRb" GroupName="IdleMode" Content="همیشه متصل" Checked="IdleRb_Checked"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <RadioButton x:Name="IdleOnRb" GroupName="IdleMode" Content="قطع بعد از" VerticalAlignment="Center" Checked="IdleRb_Checked"/>
                                <TextBox x:Name="IdleMinutesBox" Width="52" Height="26" Margin="8,0,6,0"
                                         FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="12"
                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                         Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                         LostFocus="IdleMinutes_LostFocus"/>
                                <TextBlock x:Name="IdleMinutesLabel" Text="دقیقه بی‌استفادگی" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="SplitExpander" Header="🔀 اسپلیت تانل (همه کانکشن‌ها)" Margin="0,0,0,6" Padding="8"
                              Foreground="{DynamicResource TextBrush}" Background="{DynamicResource CardBrush}"
                              BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                        <StackPanel Margin="2,8,2,2">
                            <RadioButton x:Name="StOffRb" GroupName="StMode" Tag="off"
                                         Content="غیرفعال — همه ترافیک از VPN" Checked="StMode_Checked"/>
                            <RadioButton x:Name="StDenyRb" GroupName="StMode" Tag="deny"
                                         Content="Deny — همه از VPN به‌جز موارد لیست" Checked="StMode_Checked" Margin="0,5,0,0"/>
                            <RadioButton x:Name="StAllowRb" GroupName="StMode" Tag="allow"
                                         Content="Allow — فقط موارد لیست از VPN" Checked="StMode_Checked" Margin="0,5,0,0"/>
                            <TextBox x:Name="StListBox" Height="110" Margin="0,8,0,2"
                                     AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="12"
                                     Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}"
                                     BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                     LostFocus="StList_LostFocus"/>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="DnsExpander" Header="🌐 DNS" Margin="0,0,0,6" Padding="8"
                              Foreground="{DynamicResource TextBrush}" Background="{DynamicResource CardBrush}"
                              BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                        <StackPanel Margin="2,8,2,2">
                            <RadioButton x:Name="DnsAutoRb" GroupName="DnsMode" Tag="auto" Content="خودکار" Checked="DnsRb_Checked"/>
                            <RadioButton x:Name="DnsCfRb" GroupName="DnsMode" Tag="cloudflare" Content="Cloudflare — 1.1.1.1" Checked="DnsRb_Checked" Margin="0,5,0,0"/>
                            <RadioButton x:Name="DnsGoogleRb" GroupName="DnsMode" Tag="google" Content="Google — 8.8.8.8" Checked="DnsRb_Checked" Margin="0,5,0,0"/>
                            <RadioButton x:Name="DnsAdguardRb" GroupName="DnsMode" Tag="adguard" Content="AdGuard — 94.140.14.14 (مسدودساز تبلیغات)" Checked="DnsRb_Checked" Margin="0,5,0,0"/>
                            <RadioButton x:Name="DnsAdguardFamilyRb" GroupName="DnsMode" Tag="adguard_family" Content="AdGuard Family — 94.140.14.15 (امنیت خانواده)" Checked="DnsRb_Checked" Margin="0,5,0,0"/>
                            <RadioButton x:Name="DnsCustomRb" GroupName="DnsMode" Tag="custom" Content="دلخواه" Checked="DnsRb_Checked" Margin="0,5,0,0"/>
                            <Grid Margin="0,8,0,2" FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="DnsPrimaryBox" Height="30" FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Center"
                                         Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" LostFocus="DnsBox_LostFocus"/>
                                <TextBox Grid.Column="2" x:Name="DnsSecondaryBox" Height="30" FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Center"
                                         Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" LostFocus="DnsBox_LostFocus"/>
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="PackageExpander" Header="📦 پکیج و پیکربندی" Margin="0,0,0,6" Padding="8"
                              Foreground="{DynamicResource TextBrush}" Background="{DynamicResource CardBrush}"
                              BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                        <StackPanel Margin="2,8,2,2">
                            <Button x:Name="UpdateBaseBtn" Content="🔧 به‌روزرسانی base.ovpn از فایل" Style="{StaticResource ActionBtn}" Margin="0,4" Click="UpdateBase_Click"/>
                            <Button x:Name="ImportBtn" Content="📥 ایمپورت پکیج / فایل ovpn" Style="{StaticResource ActionBtn}" Margin="0,4" Click="Import_Click"/>
                            <Button x:Name="ExportBtn" Content="📤 اکسپورت / بک‌اپ کانکشن‌ها" Style="{StaticResource ActionBtn}" Margin="0,4" Click="Export_Click"/>
                            <Button x:Name="AboutBtn" Content="ℹ درباره برنامه و اشتراک" Style="{StaticResource ActionBtn}" Margin="0,14,0,6" Click="About_Click"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= CONNECTION LOG ================= -->
            <DockPanel Grid.Row="1" x:Name="ConnLogPanel" Visibility="Collapsed"
                       Margin="2,0" LastChildFill="True">
                <DockPanel.RenderTransform>
                    <TranslateTransform x:Name="ConnLogTransform"/>
                </DockPanel.RenderTransform>
                <Grid DockPanel.Dock="Top" Margin="0,10,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="ConnLogSectionLbl" Text="📶 گزارش کانکشن‌ها" Style="{StaticResource SectionTitle}" Margin="0"/>
                    <Button Grid.Column="1" x:Name="ClearConnLogBtn" Content="🗑 پاکسازی" Style="{StaticResource ActionBtn}" Padding="8,4" Click="ClearConnLog_Click"/>
                </Grid>
                <TextBox x:Name="ConnLogBox" IsReadOnly="True" TextWrapping="Wrap" Margin="0,0,0,4"
                         VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight"
                         FontFamily="Consolas" FontSize="11"
                         Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"/>
            </DockPanel>

            <!-- ================= HOTSPOT PANEL ================= -->
            <ScrollViewer Grid.Row="1" x:Name="HotspotPanel" Visibility="Collapsed"
                          Background="{DynamicResource BgBrush}"
                          VerticalScrollBarVisibility="Auto">
                <ScrollViewer.RenderTransform>
                    <TranslateTransform x:Name="HotspotTransform"/>
                </ScrollViewer.RenderTransform>
                <StackPanel Margin="2,0">
                    <TextBlock Text="VPN WIFI-Direct" Style="{StaticResource SectionTitle}" Margin="0,0,0,15"/>

                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" x:Name="HsVpnLabel" Text="کانکشن VPN فعال:" Foreground="{DynamicResource SubTextBrush}" FontSize="11"/>
                            <TextBlock Grid.Row="0" x:Name="HsVpnConnectionText" Text="در حال بررسی..." Foreground="{DynamicResource TextBrush}" FontSize="12.5" FontWeight="Bold" FontFamily="Consolas" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="2" x:Name="HsAdapterLabel" Text="کارت شبکه اینترنت:" Foreground="{DynamicResource SubTextBrush}" FontSize="11"/>
                            <TextBlock Grid.Row="2" x:Name="HsSourceText" Text="در حال بررسی..." Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="Bold" FontFamily="Consolas" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <UniformGrid Columns="3" Margin="0,0,0,15">
                        <Button x:Name="BtnHsStart" Content="روشن کردن" Style="{StaticResource ActionBtn}"
                                Background="#3B82F6" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="12" Height="42" Margin="0,0,3,0" Click="BtnHsStart_Click"/>

                        <Button x:Name="BtnHsStop" Content="توقف" Style="{StaticResource ActionBtn}"
                                Background="#EF4444" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="12" Height="42" Margin="3,0,3,0" IsEnabled="False" Click="BtnHsStop_Click"/>

                        <Button x:Name="BtnHsRestart" Content="راه‌اندازی مجدد" Style="{StaticResource ActionBtn}"
                                Background="#F59E0B" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="12" Height="42" Margin="3,0,0,0" IsEnabled="False" Click="BtnHsRestart_Click"/>
                    </UniformGrid>

                    <TextBlock x:Name="HsStatusText" Text="منتظر اتصال پایدار VPN..." Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,15" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="HsManualHint" Visibility="Collapsed" Foreground="{DynamicResource SubTextBrush}" FontSize="11.5" Margin="0,-5,0,5" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap">
                        <Run Text="کارت شبکه وای‌فای دایرکت معمولاً با نام "/>
                        <Run Text="Local Area Connection*" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                        <Run Text=" و یک عدد (مثل 10 یا 11) ساخته می‌شود."/>
                    </TextBlock>
                    <Button x:Name="BtnOpenNcpa" Content="باز کردن تنظیمات شبکه ویندوز (ncpa.cpl) 🔗" Visibility="Collapsed" Background="Transparent" Foreground="#3B82F6" BorderThickness="0" Cursor="Hand" Margin="0,0,0,15" Click="BtnOpenNcpa_Click" FontWeight="Bold" FontSize="12"/>
                    <Border x:Name="HsInfoContainer" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,15" Visibility="Collapsed">
                        <Grid FlowDirection="LeftToRight">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="SSID:" Foreground="{DynamicResource SubTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="HsSsidText" Text="-" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="Bold" FontFamily="Consolas" FlowDirection="LeftToRight" HorizontalAlignment="Left" TextAlignment="Left"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="PASS:" Foreground="{DynamicResource SubTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="HsPassText" Text="-" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="Bold" FontFamily="Consolas" FlowDirection="LeftToRight" HorizontalAlignment="Left" TextAlignment="Left"/>
                        </Grid>
                    </Border>

                    <Border x:Name="HsQrContainer" Background="White" CornerRadius="10" Padding="12" Visibility="Collapsed" HorizontalAlignment="Center">
                        <StackPanel>
                            <TextBlock x:Name="QrScanLbl" Text="📱 اسکن برای اتصال سریع" Foreground="#0F172A" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                            <Image x:Name="HsQrImage" Width="130" Height="130" Stretch="Uniform"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="HsClientsContainer" Visibility="Collapsed"
                            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,12,0,0"
                            Cursor="Hand" MouseEnter="HsClientsContainer_MouseEnter" MouseLeave="HsClientsContainer_MouseLeave">
                        <Grid>
                            <TextBlock x:Name="HsClientsCountText" Text="دستگاه‌های متصل: ۰"
                                       Foreground="{DynamicResource TextBrush}" FontSize="11.5"
                                       HorizontalAlignment="Center"/>
                            <Popup x:Name="HsClientsPopup" PlacementTarget="{Binding ElementName=HsClientsContainer}"
                                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="8" Width="300">
                                    <TextBox x:Name="HsClientsTextBox" IsReadOnly="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" MaxHeight="130"
                                             Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}"
                                             BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                             FontFamily="Consolas" FontSize="11" Padding="6"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            </Grid>

        <!-- ================= MINI WIDGET ================= -->
        <Border x:Name="MiniWidget" Visibility="Collapsed"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                CornerRadius="12" Padding="10,8" Margin="8">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="MiniAlwaysOnTopMenuItem" Header="همیشه بالا" IsCheckable="True" Click="MiniAlwaysOnTop_Click"/>
                </ContextMenu>
            </Border.ContextMenu>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="MiniPowerBtn" Width="44" Height="44" Padding="0"
                        Background="#334155" Cursor="Hand" Click="Power_Click"
                        ToolTip="روشن/خاموش اتصال" VerticalAlignment="Center">
                    <Button.Effect>
                        <DropShadowEffect x:Name="MiniPowerGlow" Color="#22C55E"
                                          BlurRadius="12" ShadowDepth="0" Opacity="0"/>
                    </Button.Effect>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="22">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Path Width="20" Height="20" Stretch="Uniform"
                          Data="M 12,2.5 L 12,11.5 M 7.05,5.6 A 8.5,8.5 0 1 0 16.95,5.6"
                          Stroke="#F8FAFC" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>

                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="MiniStatusDot" Width="7" Height="7" Fill="#64748B"
                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="MiniStatusText" Text="آماده اتصال" FontSize="12.5" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock x:Name="MiniConnectionText" Text="—" FontSize="10"
                               Foreground="{DynamicResource SubTextBrush}" FlowDirection="LeftToRight"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    <TextBlock x:Name="MiniSpeedText" Text="↓ 0 B/s   ↑ 0 B/s" FontSize="10.5"
                               Foreground="{DynamicResource SubTextBrush}" FlowDirection="LeftToRight" Margin="0,3,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" x:Name="MiniRestoreBtn" Width="42" Height="42" Padding="0"
                        Background="{DynamicResource AccentBrush}" Cursor="Hand" Click="MiniRestoreBtn_Click"
                        ToolTip="بازگشت به حالت عادی" VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="⤢" FontSize="19" Foreground="#F8FAFC"/>
                </Button>
            </Grid>
        </Border>

        </Grid>
    </Grid>
    </Border>
</Window>



