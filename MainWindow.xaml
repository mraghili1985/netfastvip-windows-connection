<Window x:Class="SmartVpn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:TextOptions="clr-namespace:System.Windows.Media;assembly=PresentationCore"
        Title="NETFASTVIP" Width="880" Height="580"
        FlowDirection="LeftToRight"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        AllowsTransparency="False"
        Background="Transparent"
        FontFamily="./Fonts/#Inter, Inter, Segoe UI Variable Text, Segoe UI, ./Fonts/#Vazirmatn, Vazirmatn"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True" PreviewDragOver="Window_PreviewDragOver" DragOver="Window_DragOver" PreviewDrop="Window_Drop" Drop="Window_Drop"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34"
                      CornerRadius="12"
                      GlassFrameThickness="-1"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Button Styles -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryGlowBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Tab Button Style -->
        <Style x:Key="SidebarTabBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,1,0,1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DrawerNavBtn" TargetType="Button" BasedOn="{StaticResource SidebarTabBtn}"/>

        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="2,14,2,6"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>

        <Style x:Key="ElevatedPanelCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ElevatedCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ElevatedCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="4" BlurRadius="14" Opacity="0.40"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ElevatedCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ElevatedCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.35"/>
                            </Border.Effect>
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Top"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" Padding="2,2">
                                                <Grid>
                                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                                      VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                    <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                          Data="M 0 0 L 5 5 L 10 0" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="2" RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="0"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="180"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource TextBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ContentPresenter Content="{TemplateBinding Header}"
                                                      TextBlock.FontWeight="Bold" TextBlock.FontSize="13.5" TextBlock.Foreground="{DynamicResource TextBrush}"/>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpandSite" DockPanel.Dock="Bottom"
                                                  Content="{TemplateBinding Content}"
                                                  Visibility="Collapsed" Margin="0,10,0,0"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolTile" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource ElevatedCardBrush}"
                                BorderBrush="{DynamicResource ElevatedCardBorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="3" BlurRadius="8" Opacity="0.30"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <LinearGradientBrush x:Key="DlAreaBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4038BDF8" Offset="0"/>
            <GradientStop Color="#0038BDF8" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="UlAreaBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4022C55E" Offset="0"/>
            <GradientStop Color="#0022C55E" Offset="1"/>
        </LinearGradientBrush>

        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="PowerScale" Storyboard.TargetProperty="ScaleX"
                              From="1" To="1.06" Duration="0:0:0.9"/>
            <DoubleAnimation Storyboard.TargetName="PowerScale" Storyboard.TargetProperty="ScaleY"
                              From="1" To="1.06" Duration="0:0:0.9"/>
        </Storyboard>
        <Storyboard x:Key="SpinStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="PowerGlyphRotate" Storyboard.TargetProperty="Angle"
                              From="0" To="360" Duration="0:0:1"/>
        </Storyboard>
        <Storyboard x:Key="SubRefreshSpinStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SubRefreshRotate" Storyboard.TargetProperty="Angle"
                              From="0" To="360" Duration="0:0:0.8"/>
        </Storyboard>
        <Storyboard x:Key="HotspotPulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="HotspotHeaderScale" Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.12" Duration="0:0:0.8"/>
            <DoubleAnimation Storyboard.TargetName="HotspotHeaderScale" Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.12" Duration="0:0:0.8"/>
        </Storyboard>
    </Window.Resources>

    <!-- Main Window Root Surface -->
    <Border x:Name="WindowSurface" Margin="0"
            Background="{DynamicResource WindowBackdropTintBrush}"
            BorderThickness="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleBarRow" Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Minimalist Windows 11 Title Bar -->
            <Border x:Name="AppTitleBar" Grid.Row="0" Height="34"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="AppTitleBar_MouseLeftButtonDown">
                <Grid FlowDirection="LeftToRight">
                    <!-- Left: Sidebar Toggle + Brand Logo & Title -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Button x:Name="SidebarToggleBtn" Width="30" Height="28" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" ToolTip="نمایش / پنهان کردن منو" WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="SidebarToggleBtn_Click" Margin="0,0,6,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FieldBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="☰" FontSize="14" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Path Data="M12 2L3 7v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-9-5z"
                              Fill="{DynamicResource AccentBrush}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TitleBrandText" Text="NETFASTVIP" FontSize="11.5" FontWeight="Bold"
                                   Foreground="{DynamicResource SubTextBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: Account Badge + Window Caption Controls -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border x:Name="TitleAccountBadge" Background="#1438BDF8" BorderBrush="#2538BDF8" BorderThickness="1"
                                CornerRadius="12" Padding="10,3" Margin="0,0,12,0" VerticalAlignment="Center" Cursor="Hand"
                                ToolTip="وضعیت حساب کاربری" MouseLeftButtonDown="TitleAccountBadge_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="TitleStatusDot" Width="6" Height="6" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TitleAccountText" Text="حساب کاربری" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="TitleMinimizeButton" Width="44" Height="34"
                                Content="—" FontSize="13" Padding="0"
                                Background="Transparent" Foreground="{DynamicResource SubTextBrush}"
                                BorderThickness="0" Cursor="Hand" ToolTip="کمینه‌سازی"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="TitleMinimizeButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="TitleCloseButton" Width="46" Height="34"
                                Content="✕" FontSize="14" Padding="0"
                                Background="Transparent" Foreground="{DynamicResource SubTextBrush}"
                                BorderThickness="0" Cursor="Hand" ToolTip="بستن"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="TitleCloseButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#DC2626"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main App Body: Sidebar + Main Content Stage -->
            <Grid Grid.Row="1">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="RootScale"/>
                </Grid.LayoutTransform>

                <Grid x:Name="RootGrid" AllowDrop="True" PreviewDragOver="Window_PreviewDragOver" DragOver="Window_DragOver" PreviewDrop="Window_PreviewDrop" Drop="Window_Drop">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SidebarColumn" Width="210"/> <!-- Left Sidebar -->
                        <ColumnDefinition Width="*"/>   <!-- Main Content Canvas -->
                    </Grid.ColumnDefinitions>

                    <!-- ================= VERTICAL SIDEBAR ================= -->
                    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                            BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Brand -->
                                <RowDefinition Height="*"/>    <!-- Navigation Tabs -->
                                <RowDefinition Height="Auto"/> <!-- Footer / Version -->
                            </Grid.RowDefinitions>

                            <!-- Brand Header (App Icon & Clean Name) -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="14,10,12,6">
                                <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource ElevatedCardBrush}"
                                        BorderBrush="{DynamicResource ElevatedCardBorderBrush}" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" BlurRadius="6" Opacity="0.35"/>
                                    </Border.Effect>
                                    <Image Source="pack://application:,,,/app.ico" Width="20" Height="20"
                                           RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="SidebarBrandText" Text="NETFASTVIP" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"
                                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Navigation Tabs -->
                            <StackPanel Grid.Row="1" Margin="8,3,8,3">
                                <!-- Dashboard Tab (Default Active) -->
                                <Button x:Name="NavDashboardBtn" Style="{StaticResource SidebarTabBtn}" Background="{DynamicResource CardHoverBrush}" Click="SidebarNavDashboard_Click">
                                    <Grid>
                                        <Border x:Name="NavDashboardIndicator" Width="3" Height="22" HorizontalAlignment="Left"
                                                Background="{DynamicResource AccentBrush}" CornerRadius="1.5" Visibility="Visible"/>
                                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="⌂" FontSize="18" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Width="24"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="NavDashboardText" Text="داشبورد" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock x:Name="SidebarNavDashboardSubtext" Text="آماده" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- VPN Core Tab -->
                                <Button x:Name="NavVpnCoreBtn" Style="{StaticResource SidebarTabBtn}" Click="SidebarNavVpnCore_Click">
                                    <Grid>
                                        <Border x:Name="NavVpnCoreIndicator" Width="3" Height="22" HorizontalAlignment="Left"
                                                Background="{DynamicResource AccentBrush}" CornerRadius="1.5" Visibility="Collapsed"/>
                                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="🛡️" FontSize="14" VerticalAlignment="Center" Width="24"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="NavVpnCoreText" Text="VPN Core" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock Text="WireGuard / OVPN" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Xray Core Tab -->
                                <Button x:Name="NavXrayCoreBtn" Style="{StaticResource SidebarTabBtn}" Click="SidebarNavXrayCore_Click">
                                    <Grid>
                                        <Border x:Name="NavXrayCoreIndicator" Width="3" Height="22" HorizontalAlignment="Left"
                                                Background="{DynamicResource AccentBrush}" CornerRadius="1.5" Visibility="Collapsed"/>
                                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="⚡" FontSize="15" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Width="24"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="NavXrayCoreText" Text="Xray Core" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock Text="sing-box / VLESS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Legacy stub for compilation safety -->
                                <Button x:Name="NavServersBtn" Visibility="Collapsed"/>
                                <Border x:Name="NavServersIndicator" Visibility="Collapsed"/>

                                <!-- Hotspot Tab -->
                                <Button x:Name="NavHotspotBtn" Style="{StaticResource SidebarTabBtn}" Click="SidebarNavHotspot_Click">
                                    <Grid>
                                        <Border x:Name="NavHotspotIndicator" Width="3" Height="22" HorizontalAlignment="Left"
                                                Background="{DynamicResource AccentBrush}" CornerRadius="1.5" Visibility="Collapsed"/>
                                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="📶" FontSize="15" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Width="24"/>
                                            <TextBlock x:Name="NavHotspotText" Text="VPN Wi-Fi Direct" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Settings Tab -->
                                <Button x:Name="NavSettingsBtn" Style="{StaticResource SidebarTabBtn}" Click="SidebarNavSettings_Click">
                                    <Grid>
                                        <Border x:Name="NavSettingsIndicator" Width="3" Height="22" HorizontalAlignment="Left"
                                                Background="{DynamicResource AccentBrush}" CornerRadius="1.5" Visibility="Collapsed"/>
                                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="⚙" FontSize="15" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Width="24"/>
                                            <TextBlock x:Name="NavSettingsText" Text="تنظیمات" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Tools Tab -->
                                <Button x:Name="NavToolsBtn" Style="{StaticResource SidebarTabBtn}" Click="SidebarNavTools_Click">
                                    <Grid>
                                        <Border x:Name="NavToolsIndicator" Width="3" Height="22" HorizontalAlignment="Left"
                                                Background="{DynamicResource AccentBrush}" CornerRadius="1.5" Visibility="Collapsed"/>
                                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="🧰" FontSize="15" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Width="24"/>
                                            <TextBlock x:Name="NavToolsText" Text="ابزارهای شبکه" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Connection Logs Tab -->
                                <Button x:Name="NavLogsBtn" Style="{StaticResource SidebarTabBtn}" Click="SidebarNavLogs_Click">
                                    <Grid>
                                        <Border x:Name="NavLogsIndicator" Width="3" Height="22" HorizontalAlignment="Left"
                                                Background="{DynamicResource AccentBrush}" CornerRadius="1.5" Visibility="Collapsed"/>
                                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="📜" FontSize="15" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Width="24"/>
                                            <TextBlock x:Name="NavLogsText" Text="لاگ کانکشن‌ها" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <!-- Sidebar Footer & Account Card -->
                            <StackPanel Grid.Row="2" Margin="8,0,8,8">
                                <!-- User Account Card (from Image 3) -->
                                <Border x:Name="SidebarAccountCard" Margin="0,0,0,5" Padding="8,6"
                                        Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Cursor="Hand" ToolTip="مشاهده وضعیت اشتراک، ترافیک و ورود/خروج"
                                        MouseLeftButtonDown="SidebarAccountCard_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- User Avatar / Icon Badge -->
                                        <Border x:Name="SidebarAccountBadge" Grid.Column="0" Width="28" Height="28" CornerRadius="8"
                                                Background="#203B82F6" BorderBrush="#353B82F6" BorderThickness="1"
                                                VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock x:Name="SidebarAccountIcon" Text="👤" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- User Info & Remaining Traffic -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="SidebarAccountTitle" Text="حساب کاربری" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="SidebarAccountSub" Text="اشتراک فعال ✅" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" Margin="0,1,0,3" TextTrimming="CharacterEllipsis"/>
                                            <ProgressBar x:Name="SubTrafficBar" Height="4" Value="0" Maximum="100" Background="#1E293B" Foreground="{DynamicResource AccentBrush}" BorderThickness="0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Version & Social Links (Telegram & GitHub) -->
                                <Border Padding="8,5" Background="{DynamicResource ElevatedCardBrush}"
                                        BorderBrush="{DynamicResource ElevatedCardBorderBrush}" BorderThickness="1" CornerRadius="10">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" BlurRadius="6" Opacity="0.30"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Version Badge -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#203B82F6" BorderBrush="#403B82F6" BorderThickness="1" CornerRadius="5" Padding="7,2">
                                                <TextBlock x:Name="SidebarVersionText" Text="v3.0.2" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Social Icons: Telegram & GitHub -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Telegram Button -->
                                            <Button x:Name="SidebarTelegramBtn" Width="28" Height="28" Margin="0,0,6,0"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="کانال تلگرام (Telegram Channel)"
                                                    Click="SidebarTelegramBtn_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="#143B82F6" BorderBrush="#303B82F6" BorderThickness="1" CornerRadius="6">
                                                            <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .37z"
                                                                  Fill="{DynamicResource AccentBrush}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#353B82F6"/>
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- GitHub Button -->
                                            <Button x:Name="SidebarGithubBtn" Width="28" Height="28"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="مخزن گیت‌هاب (GitHub Repository)"
                                                    Click="SidebarGithubBtn_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="#1494A3B8" BorderBrush="#3094A3B8" BorderThickness="1" CornerRadius="6">
                                                            <Path Data="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z"
                                                                  Fill="{DynamicResource SubTextBrush}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#3094A3B8"/>
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ================= MAIN CONTENT AREA ================= -->
                    <Grid Grid.Column="1" Margin="22,18,22,18">

                        <!-- Hidden stubs to keep C# references 100% safe -->
                        <StackPanel Visibility="Collapsed">
                            <Button x:Name="HamburgerBtn" Click="HamburgerBtn_Click"/>
                            <StackPanel x:Name="HeaderBrandPanel"/>
                            <StackPanel x:Name="HeaderPagePanel"/>
                            <TextBlock x:Name="HeaderTitleText"/>
                            <TextBlock x:Name="BrandTitleText"/>
                            <Button x:Name="HeaderPowerBtn"/>
                            <Button x:Name="HeaderLogBtn"/>
                            <Button x:Name="HeaderHotspotBtn"/>
                            <Button x:Name="HeaderToolsBtn"/>
                            <Button x:Name="HeaderSettingsBtn"/>
                            <TextBlock x:Name="HotspotHeaderIcon"/>
                            <Button Visibility="Collapsed">
                                <Button.Effect><DropShadowEffect x:Name="HotspotHeaderGlow"/></Button.Effect>
                                <Button.RenderTransform><ScaleTransform x:Name="HotspotHeaderScale"/></Button.RenderTransform>
                            </Button>
                        </StackPanel>

                        <!-- ================= 1. DASHBOARD VIEW (CONCEPT 2 HIGH FIDELITY) ================= -->
                        <!-- ================= 1. DASHBOARD VIEW (CONNECTED TO REAL PROGRAM) ================= -->
                        <!-- ================= 1. DASHBOARD VIEW (3-TIER COMPACT BALANCED ARCHITECTURE) ================= -->
                        <Grid x:Name="HomePanel" Visibility="Visible">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="HomeTransform"/>
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Tier 1: Active Server Hero + Style 1 Orbital Power Button -->
                                <RowDefinition Height="Auto"/> <!-- Tier 2: Live Telemetry + Adaptive More Graph -->
                                <RowDefinition Height="*"/>    <!-- Tier 3: Favorite & Recent Servers + Core Selector -->
                            </Grid.RowDefinitions>

                            <!-- ================= TIER 1: ACTIVE SERVER HERO CARD (LEFT) & ORBITAL POWER BUTTON (RIGHT) ================= -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.75*"/> <!-- Active Server Hero Card -->
                                    <ColumnDefinition Width="*"/>     <!-- Style 1 Orbital Power Button Card -->
                                </Grid.ColumnDefinitions>

                                <!-- 1.1 Active Server Hero Card -->
                                <Border Grid.Column="0" Background="{DynamicResource ElevatedCardBrush}"
                                        BorderBrush="{DynamicResource ElevatedCardBorderBrush}" BorderThickness="1"
                                        CornerRadius="16" Padding="18,14" Margin="0,0,10,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="4" BlurRadius="14" Opacity="0.45"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Top Header: Badge + Server Title & Subtitle + Status Pill -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Dynamic Location/Protocol Badge -->
                                            <Border x:Name="ActiveServerBadge" Grid.Column="0" Width="44" Height="44" CornerRadius="12"
                                                    Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                                                    Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border CornerRadius="6" ClipToBounds="True" Width="28" Height="20">
                                                        <Image x:Name="ActiveServerBadgeImg" Width="28" Height="20" Stretch="UniformToFill" Visibility="Collapsed"/>
                                                    </Border>
                                                    <TextBlock x:Name="ActiveServerBadgeText" Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- Active Server Title, Subtitle, & Status -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="ActiveConnText" Text="یک کانکشن انتخاب کنید" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="ServerSubText" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,0">
                                                    <Border x:Name="GeoIpPill" Background="#183B82F6" BorderBrush="#303B82F6" BorderThickness="1" CornerRadius="8" Padding="7,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <TextBlock x:Name="GeoIpText" Text="آماده اتصال" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="ActiveCoreTypePill" CornerRadius="8" Padding="7,2" Background="#183B82F6" BorderBrush="#353B82F6" BorderThickness="1" VerticalAlignment="Center" Visibility="Collapsed">
                                                        <TextBlock x:Name="ActiveCoreTypeText" Text="🛡️ VPN Core" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock x:Name="StatusText" FontSize="11" FontWeight="Bold" Foreground="#22C55E" Margin="0,3,0,0" Visibility="Collapsed"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Middle Spacer -->
                                        <Border Grid.Row="1" MinHeight="10"/>

                                        <!-- Card Footer: Duration -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <TextBlock x:Name="DurationLbl" Text="مدت زمان اتصال" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="DurationText" Text="00:00:00" FontSize="14.5" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 1.2 Orbital Power Button Card (Style 1 Orbital) -->
                                <Border Grid.Column="1" Background="{DynamicResource ElevatedCardBrush}"
                                        BorderBrush="{DynamicResource ElevatedCardBorderBrush}" BorderThickness="1"
                                        CornerRadius="16" Padding="14,10">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="4" BlurRadius="14" Opacity="0.45"/>
                                    </Border.Effect>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Orbital Button with Outer Glowing Ring -->
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- Pulsing Outer Ring -->
                                            <Border x:Name="PowerOuterRing" Width="72" Height="72" CornerRadius="36"
                                                    Background="Transparent" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1.5">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#3B82F6" BlurRadius="16" ShadowDepth="0" Opacity="0.3"/>
                                                </Border.Effect>
                                            </Border>

                                            <!-- Main Power Button -->
                                            <Button x:Name="PowerBtn" Width="60" Height="60" Cursor="Hand" Click="Power_Click"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Button.RenderTransform>
                                                    <ScaleTransform x:Name="PowerScale" ScaleX="1" ScaleY="1"/>
                                                </Button.RenderTransform>
                                                <Button.Effect>
                                                    <DropShadowEffect Color="#334155" BlurRadius="14" ShadowDepth="0" Opacity="0.4"/>
                                                </Button.Effect>
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="PowerCircleBorder" Width="60" Height="60" CornerRadius="30"
                                                                Background="{TemplateBinding Background}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="2">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Grid>
                                                    <Path x:Name="PowerGlyph" Width="22" Height="22" Stretch="Uniform"
                                                          Data="M 12,2.5 L 12,11.5 M 7.05,5.6 A 8.5,8.5 0 1 0 16.95,5.6"
                                                          Stroke="#F8FAFC" StrokeThickness="2.6"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform x:Name="PowerGlyphRotate" Angle="0"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Grid>
                                            </Button>
                                        </Grid>

                                        <!-- Status Texts -->
                                        <TextBlock x:Name="PowerStateText" Text="خاموش" FontSize="13" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                        <TextBlock x:Name="PowerHintText" Text="جهت اتصال کلیک کنید" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- ================= TIER 2: CENTERPIECE LIVE TELEMETRY & ADAPTIVE MORE GRAPH ================= -->
                            <Border Grid.Row="1" Background="{DynamicResource ElevatedCardBrush}"
                                    BorderBrush="{DynamicResource ElevatedCardBorderBrush}" BorderThickness="1"
                                    CornerRadius="16" Padding="16,12" Margin="0,0,0,10">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="4" BlurRadius="14" Opacity="0.45"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Metrics Header + More Button -->
                                        <RowDefinition Height="Auto"/> <!-- Split Graph / Details -->
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: 4 Live Telemetry Metrics + More Details Toggle Button -->
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104"/> <!-- Current Speed (Fixed rock-solid column) -->
                                            <ColumnDefinition Width="104"/> <!-- Upload Speed (Fixed rock-solid column) -->
                                            <ColumnDefinition Width="80"/>  <!-- Latency / Ping (Fixed rock-solid column) -->
                                            <ColumnDefinition Width="*"/>   <!-- Session Traffic (takes remaining space) -->
                                            <ColumnDefinition Width="Auto"/> <!-- More Button -->
                                        </Grid.ColumnDefinitions>

                                        <!-- 1. Download Speed -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="CurrentSpeedLbl" Text="دریافت ↓" FontWeight="SemiBold" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"/>
                                            <TextBlock x:Name="DlSpeedText" Text="0 B/s" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0" Typography.NumeralAlignment="Tabular"/>
                                        </StackPanel>

                                        <!-- 2. Upload Speed -->
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="UlSpeedLbl" Text="ارسال ↑" FontWeight="SemiBold" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"/>
                                            <TextBlock x:Name="UlSpeedText" Text="0 B/s" FontSize="15" FontWeight="Bold" Foreground="#22C55E" Margin="0,2,0,0" Typography.NumeralAlignment="Tabular"/>
                                        </StackPanel>

                                        <!-- 3. Latency / Ping -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="LatencyLbl" Text="پینگ" FontWeight="SemiBold" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"/>
                                            <TextBlock x:Name="PingText" Text="—" FontSize="15" FontWeight="Bold" Foreground="#22C55E" Margin="0,2,0,0" Typography.NumeralAlignment="Tabular"/>
                                        </StackPanel>

                                        <!-- 4. Session Traffic -->
                                        <StackPanel Grid.Column="3">
                                            <TextBlock x:Name="SessionTrafficLbl" Text="حجم سشن" FontWeight="SemiBold" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"/>
                                            <TextBlock x:Name="SessionTrafficText" Text="0 B" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,2,0,0" Typography.NumeralAlignment="Tabular"/>
                                        </StackPanel>

                                        <!-- 5. "More" Details Toggle Button -->
                                        <Button x:Name="MoreInfoBtn" Grid.Column="4" Style="{StaticResource ActionBtn}"
                                                Padding="10,4" Height="28" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                Click="MoreInfoToggle_Click" Cursor="Hand" ToolTip="نمایش / پنهان کردن جزئیات اتصال">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="MoreInfoText" Text="جزئیات بیشتر" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="MoreInfoArrow" Text=" ▾" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Bottom Row: Dynamic Graph Canvas & Embedded Connection Details -->
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>   <!-- Waveform Graph: Expands to 100% when details collapsed -->
                                            <ColumnDefinition Width="Auto"/> <!-- 4 Details Fields: Appears when More clicked -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Column 0: Real-time Telemetry Graph -->
                                        <Border Grid.Column="0" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                                                BorderThickness="1" CornerRadius="12" Padding="10,6" ClipToBounds="True">
                                            <Grid>
                                                <!-- Watermark -->
                                                <TextBlock Text="LIVE TELEMETRY" FontSize="9" FontWeight="Bold" Foreground="#38485E"
                                                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0"/>

                                                <!-- Dynamic Canvas with SizeChanged redraw hook -->
                                                <Canvas x:Name="GraphCanvas" Height="78" ClipToBounds="True"
                                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                        SizeChanged="GraphCanvas_SizeChanged">
                                                    <Polygon x:Name="DlArea" Fill="{StaticResource DlAreaBrush}"/>
                                                    <Polygon x:Name="UlArea" Fill="{StaticResource UlAreaBrush}"/>
                                                    <Polyline x:Name="DlLine" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8"/>
                                                    <Polyline x:Name="UlLine" Stroke="#22C55E" StrokeThickness="1.4"/>
                                                </Canvas>
                                            </Grid>
                                        </Border>

                                        <!-- Column 1: Embedded Connection Details Panel (Revealed upon clicking "More") -->
                                        <Border x:Name="MoreInfoPanel" Grid.Column="1" Width="285" Margin="10,0,0,0"
                                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                                                BorderThickness="1" CornerRadius="12" Padding="6,5" Visibility="Collapsed">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Tunnel IP -->
                                                <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                                                        BorderThickness="1" CornerRadius="8" Padding="7,4" Margin="0,0,2.5,2.5" Cursor="Hand" ToolTip="برای کپی کلیک کنید" MouseLeftButtonDown="CopyIpText_Click">
                                                    <StackPanel>
                                                        <TextBlock x:Name="TunnelIpLbl" Text="🌐 آی‌پی تونل" FontSize="9" Foreground="{DynamicResource SubTextBrush}" FontWeight="SemiBold"/>
                                                        <TextBlock x:Name="PrivateIpText" Text="—" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Server IP -->
                                                <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                                                        BorderThickness="1" CornerRadius="8" Padding="7,4" Margin="2.5,0,0,2.5" Cursor="Hand" ToolTip="برای کپی کلیک کنید" MouseLeftButtonDown="CopyIpText_Click">
                                                    <StackPanel>
                                                        <TextBlock x:Name="ServerIpLbl" Text="🖥️ آی‌پی سرور" FontSize="9" Foreground="{DynamicResource SubTextBrush}" FontWeight="SemiBold"/>
                                                        <TextBlock x:Name="ServerIpText" Text="—" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Protocol -->
                                                <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                                                        BorderThickness="1" CornerRadius="8" Padding="7,4" Margin="0,2.5,2.5,0">
                                                    <StackPanel>
                                                        <TextBlock x:Name="ProtocolLbl" Text="🔒 پروتکل" FontSize="9" Foreground="{DynamicResource SubTextBrush}" FontWeight="SemiBold"/>
                                                        <TextBlock x:Name="ProtocolText" Text="—" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- User -->
                                                <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                                                        BorderThickness="1" CornerRadius="8" Padding="7,4" Margin="2.5,2.5,0,0">
                                                    <StackPanel>
                                                        <TextBlock x:Name="YouLbl" Text="👤 نام کاربری" FontSize="9" Foreground="{DynamicResource SubTextBrush}" FontWeight="SemiBold"/>
                                                        <TextBlock x:Name="YouText" Text="—" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- ================= TIER 3: FAVORITE & RECENT SERVERS (LEFT) & CORE SWITCH (RIGHT) ================= -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.75*"/> <!-- Favorite & Recent Servers Card -->
                                    <ColumnDefinition Width="*"/>     <!-- Core Switch Card -->
                                </Grid.ColumnDefinitions>

                                <!-- 3.1 Multi-Mode Bottom Slot: Mode 0 (Recent Servers), Mode 1 (Quick Security), Mode 2 (Quick Tools) -->
                                <Border x:Name="RecentServersCard" Grid.Column="0" Background="{DynamicResource ElevatedCardBrush}"
                                        BorderBrush="{DynamicResource ElevatedCardBorderBrush}" BorderThickness="1"
                                        CornerRadius="16" Padding="14,11" Margin="0,0,10,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="4" BlurRadius="14" Opacity="0.45"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Card Header with Title and Mode Switcher Pill -->
                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="RecentCardIcon" Text="⭐" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="RecentCardTitle" Text="⭐ سرورهای منتخب و اخیر" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                                    <TextBlock x:Name="RecentCardSubtitle" Text="اتصال سریع با یک کلیک به آخرین کانکشن‌ها" FontWeight="SemiBold" FontSize="9" Foreground="{DynamicResource SubTextBrush}" Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Mode Switch Pill (Allows 1-click cycling: Servers -> Security -> Tools) -->
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="8" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="6,2" Cursor="Hand" MouseLeftButtonDown="DashBottomWidgetCycle_Click" ToolTip="تغییر ویجت: سرورها / امنیت / ابزارها">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock x:Name="DashBottomWidgetModeBadge" Text="سرورها" FontSize="9" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                                                    <TextBlock Text=" ⟳" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource SubTextBrush}" Margin="2,-1,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Mode 0: Recent & Favorite Servers (2 rows) -->
                                        <StackPanel Grid.Row="1" x:Name="RecentServersList" VerticalAlignment="Center" Visibility="Visible"/>

                                        <!-- Mode 1: Quick Security Controls (3 columns: Kill Switch, Split Tunnel, DNS) -->
                                        <Grid Grid.Row="1" x:Name="DashSecurityControlsView" Visibility="Collapsed" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Col 0: Kill Switch -->
                                            <Border Grid.Column="0" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,8" Cursor="Hand" MouseLeftButtonDown="DashQuickKillSwitch_Click" ToolTip="کیل‌سوئیچ امنیتی (قطع خودکار اینترنت هنگام قطعی VPN)">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock Text="🛡️" FontSize="12" Margin="0,0,4,0"/>
                                                        <TextBlock x:Name="DashKsTitleText" Text="کیل‌سوئیچ" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                                    </StackPanel>
                                                    <Border x:Name="DashKsPill" CornerRadius="4" Padding="6,1" Margin="0,5,0,0" HorizontalAlignment="Center" Background="#1A64748B">
                                                        <TextBlock x:Name="DashKsText" Text="غیرفعال" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <!-- Col 1: Split Tunnel -->
                                            <Border Grid.Column="2" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,8" Cursor="Hand" MouseLeftButtonDown="DashQuickSplitTunnel_Click" ToolTip="تفکیک ترافیک برنامه‌ها (اسپلیت تانل)">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock Text="🔀" FontSize="12" Margin="0,0,4,0"/>
                                                        <TextBlock x:Name="DashStTitleText" Text="اسپلیت تانل" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                                    </StackPanel>
                                                    <Border x:Name="DashStPill" CornerRadius="4" Padding="6,1" Margin="0,5,0,0" HorizontalAlignment="Center" Background="#1A64748B">
                                                        <TextBlock x:Name="DashStText" Text="کل ترافیک" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <!-- Col 2: DNS Protection -->
                                            <Border Grid.Column="4" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,8" Cursor="Hand" MouseLeftButtonDown="DashQuickDns_Click" ToolTip="محافظت از نشت DNS">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock Text="🌐" FontSize="12" Margin="0,0,4,0"/>
                                                        <TextBlock x:Name="DashDnsTitleText" Text="محافظت DNS" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                                    </StackPanel>
                                                    <Border x:Name="DashDnsPill" CornerRadius="4" Padding="6,1" Margin="0,5,0,0" HorizontalAlignment="Center" Background="#1A22C55E">
                                                        <TextBlock x:Name="DashDnsText" Text="فعال" FontSize="9" FontWeight="SemiBold" Foreground="#22C55E"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Mode 2: Quick Diagnostics & Tools (3 symmetric columns: Flush DNS, Kill Procs, Speed Test) -->
                                        <UniformGrid Grid.Row="1" x:Name="DashQuickToolsView" Columns="3" Visibility="Collapsed" VerticalAlignment="Center">
                                            <!-- Tool 1: Flush DNS -->
                                            <Border x:Name="DashToolFlushCard" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,9" Margin="0,0,4,0" Cursor="Hand" MouseLeftButtonDown="DashToolFlushDns_Click" ToolTip="پاکسازی کش DNS سیستم">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock x:Name="DashToolFlushIcon" Text="🧹" FontSize="14" HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="DashToolFlushText" Text="فلاش DNS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Tool 2: Kill Procs -->
                                            <Border x:Name="DashToolKillCard" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,9" Margin="2,0,2,0" Cursor="Hand" MouseLeftButtonDown="DashToolKillProcs_Click" ToolTip="بستن تمام پروسس‌های گیرکرده و ریست آداپتورها">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock x:Name="DashToolKillIcon" Text="⚡" FontSize="14" HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="DashToolKillText" Text="کیل پروسس" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Tool 3: Speed Test -->
                                            <Border x:Name="DashToolSpeedCard" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,9" Margin="4,0,0,0" Cursor="Hand" MouseLeftButtonDown="DashToolSpeedTest_Click" ToolTip="اجرای تست سرعت">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock x:Name="DashToolSpeedIcon" Text="🚀" FontSize="14" HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="DashToolSpeedText" Text="تست سرعت" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </Grid>
                                </Border>

                                <!-- 3.2 Core Selector Card -->
                                <Border Grid.Column="1" Background="{DynamicResource ElevatedCardBrush}"
                                        BorderBrush="{DynamicResource ElevatedCardBorderBrush}" BorderThickness="1"
                                        CornerRadius="16" Padding="14,12">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="4" BlurRadius="14" Opacity="0.45"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Card Header -->
                                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                            <TextBlock x:Name="HomeCoreSelectorTitle" Text="⚡ انتخاب هسته اتصال" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock x:Name="HomeCoreSelectorSubtitle" Text="دسترسی سریع به سرورهای تفکیک‌شده" FontWeight="SemiBold" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}" Margin="0,1,0,0"/>
                                        </StackPanel>

                                        <!-- Switch Buttons / Interactive Core Selector Tiles -->
                                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                            <!-- 1. VPN Core Selector Tile (Cyan Shield Theme) -->
                                            <Border x:Name="HomeVpnTile" Background="{DynamicResource FieldBrush}"
                                                    BorderBrush="#3038BDF8" BorderThickness="1"
                                                    CornerRadius="10" Padding="10,6" Margin="0,0,0,6" Cursor="Hand"
                                                    MouseLeftButtonDown="HomeVpnTile_Click">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Icon Badge -->
                                                    <Border x:Name="HomeVpnIconBadge" Grid.Column="0" Width="28" Height="28" CornerRadius="7" Background="#183B82F6"
                                                            BorderBrush="#403B82F6" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <TextBlock Text="🛡️" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Titles -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock x:Name="HomeVpnTitleText" Text="هسته VPN" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                                        <TextBlock x:Name="HomeVpnSubtitleText" Text="WireGuard / OpenVPN" FontWeight="SemiBold" FontSize="9" Foreground="{DynamicResource SubTextBrush}" Margin="0,1,0,0"/>
                                                    </StackPanel>

                                                    <!-- Status Pill / Action -->
                                                    <Border x:Name="HomeVpnStatusBadge" Grid.Column="2" CornerRadius="6" Padding="6,2" VerticalAlignment="Center"
                                                            Background="#183B82F6" BorderBrush="#353B82F6" BorderThickness="1">
                                                        <TextBlock x:Name="HomeVpnStatusText" Text="ورود →" FontSize="9.5" FontWeight="SemiBold" Foreground="#3B82F6"/>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- 2. Xray Core Selector Tile (Electric Purple Theme) -->
                                            <Border x:Name="HomeXrayTile" Background="{DynamicResource FieldBrush}"
                                                    BorderBrush="#35A855F7" BorderThickness="1"
                                                    CornerRadius="10" Padding="10,6" Cursor="Hand"
                                                    MouseLeftButtonDown="HomeXrayTile_Click">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Icon Badge -->
                                                    <Border x:Name="HomeXrayIconBadge" Grid.Column="0" Width="28" Height="28" CornerRadius="7" Background="#20A855F7"
                                                            BorderBrush="#40A855F7" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Titles -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock x:Name="HomeXrayTitleText" Text="هسته Xray" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                                        <TextBlock x:Name="HomeXraySubtitleText" Text="sing-box / VLESS" FontWeight="SemiBold" FontSize="9" Foreground="{DynamicResource SubTextBrush}" Margin="0,1,0,0"/>
                                                    </StackPanel>

                                                    <!-- Status Pill / Action -->
                                                    <Border x:Name="HomeXrayStatusBadge" Grid.Column="2" CornerRadius="6" Padding="6,2" VerticalAlignment="Center"
                                                            Background="#18A855F7" BorderBrush="#35A855F7" BorderThickness="1">
                                                        <TextBlock x:Name="HomeXrayStatusText" Text="ورود →" FontSize="9.5" FontWeight="SemiBold" Foreground="#C084FC"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Hidden Stubs to keep all background C# code, handlers, & timers 100% stable -->
                            <StackPanel Visibility="Collapsed">
                                <Button x:Name="HomeSwitchToVpnBtn" Click="SidebarNavVpnCore_Click"/>
                                <Button x:Name="HomeSwitchToXrayBtn" Click="SidebarNavXrayCore_Click"/>
                                <Border x:Name="SecurityStatusCard"/>
                                <TextBlock x:Name="DashboardCustomLabel"/>
                                <StackPanel x:Name="ActiveConnSummaryPanel"/>
                                <TextBlock x:Name="ConnSectionLabel"/>
                                <Image x:Name="TargetConnBadgeImg"/>
                                <TextBlock x:Name="TargetConnBadgeText"/>
                                <TextBlock x:Name="TargetConnNameText"/>
                                <TextBlock x:Name="TargetConnSubText"/>
                                <TextBlock x:Name="ConnControlLbl"/>
                                <TextBlock x:Name="LiveTrafficGraphLbl"/>

                                <!-- SubSummaryCard Stub -->
                                <Border x:Name="SubSummaryCard" MouseLeftButtonUp="SubSummaryCard_Click">
                                    <Grid>
                                        <Button x:Name="SubRefreshBtn" Click="SubRefreshBtn_Click">
                                            <RotateTransform x:Name="SubRefreshRotate"/>
                                        </Button>
                                        <StackPanel x:Name="SubSummaryPanel">
                                            <TextBlock x:Name="SubSectionLabel"/>
                                            <Border x:Name="SubActiveBadge">
                                                <StackPanel>
                                                    <Ellipse x:Name="SubActiveDot"/>
                                                    <TextBlock x:Name="SubActiveText"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock x:Name="SubEmptyText"/>
                                        </StackPanel>
                                        <Border x:Name="SubDetailPanel">
                                            <StackPanel>
                                                <TextBlock x:Name="SubTimeLbl"/>
                                                <TextBlock x:Name="SubTimeLeftText"/>
                                                <TextBlock x:Name="SubDataLbl"/>
                                                <TextBlock x:Name="SubDataLeftText"/>
                                                <TextBlock x:Name="SubUpdatedText"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- HomeXraySubCard Stub -->
                                <Border x:Name="HomeXraySubCard" MouseLeftButtonUp="HomeXraySubCard_Click">
                                    <Grid>
                                        <Button x:Name="HomeXraySubRefreshBtn" Click="HomeXraySubRefreshBtn_Click">
                                            <RotateTransform x:Name="HomeXraySubRefreshRotate"/>
                                        </Button>
                                        <StackPanel x:Name="HomeXraySubSummaryPanel">
                                            <TextBlock x:Name="HomeXraySubSectionLabel"/>
                                            <Border x:Name="HomeXraySubActiveBadge">
                                                <StackPanel>
                                                    <Ellipse x:Name="HomeXraySubActiveDot"/>
                                                    <TextBlock x:Name="HomeXraySubActiveText"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock x:Name="HomeXraySubEmptyText"/>
                                        </StackPanel>
                                        <Border x:Name="HomeXraySubDetailPanel">
                                            <StackPanel>
                                                <TextBlock x:Name="HomeXraySubTimeLbl"/>
                                                <TextBlock x:Name="HomeXraySubTimeLeftText"/>
                                                <TextBlock x:Name="HomeXraySubDataLbl"/>
                                                <TextBlock x:Name="HomeXraySubDataLeftText"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- ================= 2. VPN CORE PANEL (WIREGUARD, OPENVPN, RAS) ================= -->
                        <Grid x:Name="VpnPanel" Visibility="Collapsed">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="VpnTransform"/>
                            </Grid.RenderTransform>

                            <!-- VIEW 1: Connections List (Default) -->
                            <Grid x:Name="VpnListView" Visibility="Visible">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Action Toolbar -->
                                    <RowDefinition Height="*"/>    <!-- Server List -->
                                </Grid.RowDefinitions>

                                <!-- Toolbar with Title, Prominent Add (+), Filter, Import, Export -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="VpnBackHomeBtn" Style="{StaticResource ActionBtn}" Click="SidebarNavDashboard_Click"
                                                Width="32" Height="32" Padding="0" Margin="0,0,8,0" ToolTip="بازگشت به داشبورد" Cursor="Hand">
                                            <TextBlock Text="⌂" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                        <TextBlock Text="🛡️ VPN Core" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="VpnBackHomeText" Visibility="Collapsed"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Prominent '+' Action Button -->
                                        <Button x:Name="AddBtn" Style="{StaticResource PrimaryActionBtn}" Click="Add_Click" Margin="0,0,5,0" Width="32" Height="32" Padding="0" ToolTip="افزودن کانکشن جدید (Add Connection)">
                                            <TextBlock Text="＋" FontSize="18" FontWeight="Bold" Margin="0,-2,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                        <Button x:Name="VpnAddUrlBtn" Style="{StaticResource ActionBtn}" Click="VpnAddUrl_Click" Height="32" Padding="8,4" Margin="0,0,4,0" ToolTip="دریافت کانکشن OpenVPN از لینک (Add from URL)">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🌐" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Text=" URL" FontSize="10.5" FontWeight="SemiBold" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="VpnPingAllBtn" Style="{StaticResource ActionBtn}" Click="VpnPingAll_Click" Height="32" Padding="8,4" Margin="0,0,4,0" ToolTip="Ping All Servers">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚡" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Text=" Ping" FontSize="10.5" FontWeight="SemiBold" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="FilterDropdownBtn" Style="{StaticResource ActionBtn}" Click="FilterDropdownBtn_Click" Height="32" Padding="8,4" Margin="0,0,4,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="FilterDropdownLabel" Text="همه" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Text=" ⌄" FontWeight="SemiBold" FontSize="10" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="VpnSortDropdownBtn" Style="{StaticResource ActionBtn}" Click="VpnSortDropdownBtn_Click" Height="32" Padding="8,4" Margin="0,0,4,0" ToolTip="مرتب‌سازی سرورها (Sort Servers)">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⇅" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="VpnSortDropdownLabel" Text=" Sort" FontSize="10.5" FontWeight="SemiBold" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock Text=" ⌄" FontWeight="SemiBold" FontSize="10" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Content="📁 Import" Style="{StaticResource ActionBtn}" Height="32" Padding="8,4" FontSize="10.5" FontWeight="SemiBold" Click="Import_Click" Margin="0,0,4,0"/>
                                        <Button Content="💾 Export" Style="{StaticResource ActionBtn}" Height="32" Padding="8,4" FontSize="10.5" FontWeight="SemiBold" Click="Export_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Full-Height Scrollable Connections List (ConnList) -->
                                <Border Grid.Row="1" Style="{StaticResource ElevatedPanelCard}" Padding="8,8">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="ConnList"/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>

                            <!-- VIEW 2: In-place Add / Edit Connection Form -->
                            <Grid x:Name="VpnEditView" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Header with Back Button & Quick Actions -->
                                    <RowDefinition Height="*"/>    <!-- Scrollable Form Container -->
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" x:Name="VpnEditBackBtn" Style="{StaticResource ActionBtn}" Padding="10,6" Click="ConnFormCancel_Click" Margin="0,0,12,0" ToolTip="بازگشت به لیست کانکشن‌ها">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="←" FontSize="14" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="بازگشت" FontSize="11.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="VpnEditTitleText" Text="افزودن کانکشن جدید" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock x:Name="VpnEditSubtitleText" Text="مشخصات و پارامترهای اتصال VPN را وارد نمایید" FontWeight="SemiBold" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"/>
                                    </StackPanel>

                                    <!-- Top Save / Cancel Quick Actions -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button x:Name="ConnFormTopSaveBtn" Content="💾 ذخیره" Style="{StaticResource PrimaryActionBtn}" Padding="14,6" Click="ConnFormSave_Click" Margin="0,0,6,0"/>
                                        <Button x:Name="ConnFormTopCancelBtn" Content="انصراف" Style="{StaticResource ActionBtn}" Padding="12,6" Click="ConnFormCancel_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Scrollable Form Body -->
                                <Border Grid.Row="1" Style="{StaticResource ElevatedPanelCard}" Padding="16,14">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="0,0,10,0">

                                            <!-- 1. General Info: Name & Protocol Type -->
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="2*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="نام کانکشن *" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                    <TextBox x:Name="ConnFormNameBox" Height="34" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="10,0" VerticalContentAlignment="Center" FontSize="12.5"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="نوع پروتکل *" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                    <ComboBox x:Name="ConnFormTypeCombo" Height="34" SelectionChanged="ConnFormType_Changed">
                                                        <ComboBoxItem Content="OpenVPN" Tag="openvpn"/>
                                                        <ComboBoxItem Content="WireGuard / AmneziaWG" Tag="wireguard"/>
                                                        <ComboBoxItem Content="L2TP/IPsec" Tag="l2tp"/>
                                                        <ComboBoxItem Content="SSTP" Tag="sstp"/>
                                                        <ComboBoxItem Content="IKEv2" Tag="ikev2"/>
                                                        <ComboBoxItem Content="PPTP" Tag="pptp"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>

                                            <!-- 2. Standard Panel (OpenVPN, L2TP, SSTP, IKEv2, PPTP) -->
                                            <StackPanel x:Name="ConnFormStandardPanel">

                                                <!-- Server Address & Port -->
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="1*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="آدرس سرور (Server Address) *" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                        <TextBox x:Name="ConnFormServerBox" Height="34" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="12" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="10,0" VerticalContentAlignment="Center"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="پورت (اختیاری)" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                        <TextBox x:Name="ConnFormPortBox" Height="34" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="12" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="10,0" VerticalContentAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- OpenVPN Extras (Proto, Override, File Import) -->
                                                <StackPanel x:Name="ConnFormOvpnPanel" Margin="0,0,0,12">
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1*"/>
                                                            <ColumnDefinition Width="12"/>
                                                            <ColumnDefinition Width="2*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="پروتکل OpenVPN" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                            <ComboBox x:Name="ConnFormProtoCombo" Height="34" SelectedIndex="0">
                                                                <ComboBoxItem Content="UDP" Tag="udp"/>
                                                                <ComboBoxItem Content="TCP" Tag="tcp"/>
                                                            </ComboBox>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Server Override (اختیاری)" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                            <TextBox x:Name="ConnFormOverrideBox" Height="34" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="12" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="10,0" VerticalContentAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,4,0,0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="0" x:Name="ConnFormImportOvpnBtn" Content="📂 انتخاب فایل .ovpn" Style="{StaticResource ActionBtn}" Padding="12,6" Click="ConnFormImportOvpn_Click"/>
                                                            <Button Grid.Column="1" x:Name="ConnFormDownloadOvpnUrlBtn" Content="🌐 دریافت از لینک URL" Style="{StaticResource ActionBtn}" Padding="12,6" Margin="8,0,0,0" Click="ConnFormDownloadOvpnUrl_Click"/>
                                                            <TextBlock Grid.Column="2" x:Name="ConnFormOvpnStatusText" Text="" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Credentials: Username & Password -->
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="1*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="نام کاربری (Username)" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                        <TextBox x:Name="ConnFormUserBox" Height="34" FlowDirection="LeftToRight" FontSize="12" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="10,0" VerticalContentAlignment="Center"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="رمز عبور (Password)" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                        <PasswordBox x:Name="ConnFormPassBox" Height="34" FlowDirection="LeftToRight" FontSize="12" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="10,0" VerticalContentAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- L2TP PSK -->
                                                <StackPanel x:Name="ConnFormPskPanel" Margin="0,0,0,12" Visibility="Collapsed">
                                                    <TextBlock Text="کلید مشترک (Pre-shared Key / PSK)" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                    <TextBox x:Name="ConnFormPskBox" Height="34" FlowDirection="LeftToRight" FontSize="12" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="10,0" VerticalContentAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- 3. WireGuard / AmneziaWG Panel -->
                                            <StackPanel x:Name="ConnFormWgPanel" Visibility="Collapsed" Margin="0,0,0,12">

                                                <!-- Import .conf button -->
                                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button Grid.Column="0" x:Name="ConnFormImportWgBtn" Content="📂 ایمپورت از فایل .conf (اختیاری)" Style="{StaticResource ActionBtn}" Padding="12,6" Click="ConnFormImportWgConf_Click"/>
                                                        <TextBlock Grid.Column="1" x:Name="ConnFormWgStatusText" Text="یا فیلدهای زیر را دستی تکمیل کنید" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </Border>

                                                <!-- [Interface] -->
                                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,12">
                                                    <StackPanel>
                                                        <TextBlock Text="─── Interface ───" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                                                        <TextBlock Text="Private Key *" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                        <TextBox x:Name="ConnFormWgPrivateKeyBox" Height="34" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="8,0" VerticalContentAlignment="Center"/>

                                                        <Grid Margin="0,8,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="8"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="8"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="Address * (e.g. 10.0.0.2/32)" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                                <TextBox x:Name="ConnFormWgAddressBox" Height="32" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="8,0" VerticalContentAlignment="Center"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="DNS (اختیاری)" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                                <TextBox x:Name="ConnFormWgDnsBox" Height="32" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="8,0" VerticalContentAlignment="Center"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="4">
                                                                <TextBlock Text="MTU (اختیاری)" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                                <TextBox x:Name="ConnFormWgMtuBox" Height="32" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="8,0" VerticalContentAlignment="Center"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- [Peer] -->
                                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,12">
                                                    <StackPanel>
                                                        <TextBlock Text="─── Peer ───" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="2*"/>
                                                                <ColumnDefinition Width="8"/>
                                                                <ColumnDefinition Width="1*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="Public Key *" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                                <TextBox x:Name="ConnFormWgPublicKeyBox" Height="32" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="8,0" VerticalContentAlignment="Center"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="Endpoint * (host:port)" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                                <TextBox x:Name="ConnFormWgEndpointBox" Height="32" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="8,0" VerticalContentAlignment="Center"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="1*"/>
                                                                <ColumnDefinition Width="8"/>
                                                                <ColumnDefinition Width="1*"/>
                                                                <ColumnDefinition Width="8"/>
                                                                <ColumnDefinition Width="1*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="Preshared Key (اختیاری)" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                                <TextBox x:Name="ConnFormWgPresharedKeyBox" Height="32" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="8,0" VerticalContentAlignment="Center"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="Allowed IPs" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                                <TextBox x:Name="ConnFormWgAllowedIPsBox" Text="0.0.0.0/0" Height="32" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="8,0" VerticalContentAlignment="Center"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="4">
                                                                <TextBlock Text="Keepalive (ثانیه)" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                                <TextBox x:Name="ConnFormWgKeepaliveBox" Height="32" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="8,0" VerticalContentAlignment="Center"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- AmneziaWG Obfuscation Checkbox & Card -->
                                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,12">
                                                    <StackPanel>
                                                        <CheckBox x:Name="ConnFormAwgCheckBox" FontSize="12" Checked="ConnFormAwgCheckBox_Changed" Unchecked="ConnFormAwgCheckBox_Changed">
                                                            <TextBlock>
                                                                <Run Text="AmneziaWG Obfuscation" FontWeight="SemiBold"/>
                                                                <Run Text=" — پارامترهای ضد فیلترینگ پیشرفته (Jc, S, H)" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"/>
                                                            </TextBlock>
                                                        </CheckBox>

                                                        <StackPanel x:Name="ConnFormAwgPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                                            <TextBlock Text="─── پارامترهای Junk و Obfuscation ───" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                                                            <!-- Jc / Jmin / Jmax -->
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0"><TextBlock Text="Jc" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/><TextBox x:Name="ConnFormAwgJcBox" Height="30" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="6,0" VerticalContentAlignment="Center"/></StackPanel>
                                                                <StackPanel Grid.Column="2"><TextBlock Text="Jmin" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/><TextBox x:Name="ConnFormAwgJminBox" Height="30" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="6,0" VerticalContentAlignment="Center"/></StackPanel>
                                                                <StackPanel Grid.Column="4"><TextBlock Text="Jmax" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/><TextBox x:Name="ConnFormAwgJmaxBox" Height="30" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="6,0" VerticalContentAlignment="Center"/></StackPanel>
                                                            </Grid>

                                                            <!-- S1 / S2 / S3 / S4 -->
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0"><TextBlock Text="S1" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/><TextBox x:Name="ConnFormAwgS1Box" Height="30" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="6,0" VerticalContentAlignment="Center"/></StackPanel>
                                                                <StackPanel Grid.Column="2"><TextBlock Text="S2" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/><TextBox x:Name="ConnFormAwgS2Box" Height="30" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="6,0" VerticalContentAlignment="Center"/></StackPanel>
                                                                <StackPanel Grid.Column="4"><TextBlock Text="S3" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/><TextBox x:Name="ConnFormAwgS3Box" Height="30" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="6,0" VerticalContentAlignment="Center"/></StackPanel>
                                                                <StackPanel Grid.Column="6"><TextBlock Text="S4" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/><TextBox x:Name="ConnFormAwgS4Box" Height="30" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="6,0" VerticalContentAlignment="Center"/></StackPanel>
                                                            </Grid>

                                                            <!-- H1 / H2 / H3 / H4 -->
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0"><TextBlock Text="H1" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/><TextBox x:Name="ConnFormAwgH1Box" Height="30" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="6,0" VerticalContentAlignment="Center"/></StackPanel>
                                                                <StackPanel Grid.Column="2"><TextBlock Text="H2" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/><TextBox x:Name="ConnFormAwgH2Box" Height="30" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="6,0" VerticalContentAlignment="Center"/></StackPanel>
                                                                <StackPanel Grid.Column="4"><TextBlock Text="H3" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/><TextBox x:Name="ConnFormAwgH3Box" Height="30" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="6,0" VerticalContentAlignment="Center"/></StackPanel>
                                                                <StackPanel Grid.Column="6"><TextBlock Text="H4" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/><TextBox x:Name="ConnFormAwgH4Box" Height="30" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="6,0" VerticalContentAlignment="Center"/></StackPanel>
                                                            </Grid>

                                                            <TextBlock Text="پارامترهای اضافی (اختیاری)" Style="{StaticResource SectionTitle}" Margin="0,4,0,2"/>
                                                            <TextBox x:Name="ConnFormAwgExtraBox" Height="50" TextWrapping="Wrap" AcceptsReturn="True" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="8,4"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <!-- Bottom Save / Cancel Action Buttons -->
                                            <Grid Margin="0,8,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="💾 ذخیره کانکشن (Save)" Style="{StaticResource PrimaryActionBtn}" Height="38" FontSize="12.5" FontWeight="SemiBold" Click="ConnFormSave_Click"/>
                                                <Button Grid.Column="2" Content="انصراف (Cancel)" Style="{StaticResource ActionBtn}" Height="38" FontSize="12" Click="ConnFormCancel_Click"/>
                                            </Grid>

                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- ================= 2. SERVERS PANEL (XRAY & VPN CONNECTIONS) ================= -->
                        <Grid x:Name="XrayPanel" Visibility="Collapsed">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="XrayTransform"/>
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Action Toolbar -->
                                <RowDefinition Height="*"/>    <!-- Server List -->
                                <RowDefinition Height="Auto"/> <!-- Subscription Card -->
                            </Grid.RowDefinitions>

                            <!-- Toolbar with Add Subscription, Ping All, Refresh, Clear -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="XrayBackHomeBtn" Style="{StaticResource ActionBtn}" Click="SidebarNavDashboard_Click"
                                            Width="32" Height="32" Padding="0" Margin="0,0,8,0" ToolTip="بازگشت به داشبورد" Cursor="Hand">
                                        <TextBlock Text="⌂" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                    <TextBlock x:Name="XrayConnSectionLabel" Text="⚡ Xray Core" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="XrayBackHomeText" Visibility="Collapsed"/>
                                    <!-- Hidden Mode Switcher Stubs for code-behind compatibility -->
                                    <Button x:Name="XraySwitchToVpnBtn" Click="SwitchToVpnBtn_Click" Visibility="Collapsed"/>
                                    <Button x:Name="XraySwitchToXrayBtn" Click="SwitchToXrayBtn_Click" Visibility="Collapsed"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="XrayAddSubBtn" Content="＋ Add Sub" Style="{StaticResource PrimaryActionBtn}" Height="32" Padding="8,4" FontSize="11" FontWeight="Bold" Click="XrayAddSub_Click" Margin="0,0,4,0"/>
                                    <Button x:Name="XrayManualAddBtn" Content="＋ دستی" Style="{StaticResource ActionBtn}" Height="32" Padding="8,4" FontSize="10.5" FontWeight="SemiBold" Click="XrayManualAdd_Click" Margin="0,0,4,0" ToolTip="افزودن دستی سرور VLESS / VMess / Trojan"/>
                                    <Button x:Name="XrayUpdateSubBtn" Style="{StaticResource ActionBtn}" Height="32" Padding="8,4" Click="XrayUpdateSub_Click" Margin="0,0,4,0" ToolTip="Update All">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔄" FontWeight="SemiBold" FontSize="11"/>
                                            <TextBlock x:Name="XrayUpdateSubLabel" Text=" Update" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="XrayPingAllBtn" Style="{StaticResource ActionBtn}" Height="32" Padding="8,4" Click="XrayPingAll_Click" Margin="0,0,4,0" ToolTip="Ping All Servers">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡" FontWeight="SemiBold" FontSize="11"/>
                                            <TextBlock x:Name="XrayPingAllLabel" Text=" Ping All" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="XraySortDropdownBtn" Style="{StaticResource ActionBtn}" Height="32" Padding="8,4" Click="XraySortDropdownBtn_Click" Margin="0,0,4,0" ToolTip="مرتب‌سازی سرورها (Sort Servers)">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⇅" FontWeight="SemiBold" FontSize="11"/>
                                            <TextBlock x:Name="XraySortDropdownLabel" Text=" Sort" FontSize="10.5" FontWeight="SemiBold" Margin="4,0,0,0"/>
                                            <TextBlock Text=" ⌄" FontWeight="SemiBold" FontSize="10" Margin="2,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="XrayClearServersBtn" Content="🗑" Style="{StaticResource ActionBtn}" Width="32" Height="32" Padding="0" Click="XrayClearServers_Click" ToolTip="Clear Servers"/>
                                </StackPanel>
                            </Grid>

                            <!-- Connections and Subscription Groups List -->
                            <Border Grid.Row="1" Style="{StaticResource ElevatedPanelCard}" Padding="8,8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="XrayConnList" Margin="0,0,0,4"/>
                                </ScrollViewer>
                            </Border>
                            <ListBox x:Name="XrayProxyList" Visibility="Collapsed"/>

                            <!-- Subscription Card -->
                            <Border Grid.Row="2" x:Name="XraySubSummaryCard" Style="{StaticResource ElevatedPanelCard}" Padding="14,12" Margin="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="XraySubRefreshBtn" Width="32" Height="32" Style="{StaticResource ActionBtn}" Padding="0" Click="XrayUpdateSub_Click" Margin="0,0,10,0">
                                        <TextBlock Text="🔄" FontSize="13" RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform><RotateTransform x:Name="XraySubRefreshRotate"/></TextBlock.RenderTransform>
