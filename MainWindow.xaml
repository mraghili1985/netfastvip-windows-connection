<Window x:Class="SmartVpn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:TextOptions="clr-namespace:System.Windows.Media;assembly=PresentationCore"
        Title="NETFASTVIP" Width="880" Height="580"
        FlowDirection="LeftToRight"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="./Fonts/#Vazirmatn, Vazirmatn, Segoe UI, Tahoma"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <Window.Resources>
        <!-- Button Styles -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryGlowBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Tab Button Style -->
        <Style x:Key="SidebarTabBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DrawerNavBtn" TargetType="Button" BasedOn="{StaticResource SidebarTabBtn}"/>

        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="2,14,2,6"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>

        <Style x:Key="ToolTile" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <LinearGradientBrush x:Key="DlAreaBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4038BDF8" Offset="0"/>
            <GradientStop Color="#0038BDF8" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="UlAreaBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4022C55E" Offset="0"/>
            <GradientStop Color="#0022C55E" Offset="1"/>
        </LinearGradientBrush>

        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="PowerScale" Storyboard.TargetProperty="ScaleX"
                              From="1" To="1.06" Duration="0:0:0.9"/>
            <DoubleAnimation Storyboard.TargetName="PowerScale" Storyboard.TargetProperty="ScaleY"
                              From="1" To="1.06" Duration="0:0:0.9"/>
        </Storyboard>
        <Storyboard x:Key="SpinStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="PowerGlyphRotate" Storyboard.TargetProperty="Angle"
                              From="0" To="360" Duration="0:0:1"/>
        </Storyboard>
        <Storyboard x:Key="SubRefreshSpinStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SubRefreshRotate" Storyboard.TargetProperty="Angle"
                              From="0" To="360" Duration="0:0:0.8"/>
        </Storyboard>
        <Storyboard x:Key="HotspotPulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="HotspotHeaderScale" Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.12" Duration="0:0:0.8"/>
            <DoubleAnimation Storyboard.TargetName="HotspotHeaderScale" Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.12" Duration="0:0:0.8"/>
        </Storyboard>
    </Window.Resources>

    <!-- Outer Window Frame with Fluent Glass Rounded Border -->
    <Border x:Name="WindowSurface" Margin="0"
            Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
            CornerRadius="14" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleBarRow" Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Minimalist Windows 11 Title Bar -->
            <Border x:Name="AppTitleBar" Grid.Row="0" Height="34"
                    CornerRadius="14,14,0,0" ClipToBounds="True"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="AppTitleBar_MouseLeftButtonDown">
                <Grid FlowDirection="LeftToRight">
                    <!-- Left: Brand Logo & Title -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Path Data="M12 2L3 7v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-9-5z"
                              Fill="{DynamicResource AccentBrush}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="NETFASTVIP" FontSize="11.5" FontWeight="Bold"
                                   Foreground="{DynamicResource SubTextBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: Window Caption Controls -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                        <Button x:Name="TitleMinimizeButton" Width="44" Height="34"
                                Content="—" FontSize="13" Padding="0"
                                Background="Transparent" Foreground="{DynamicResource SubTextBrush}"
                                BorderThickness="0" Cursor="Hand" ToolTip="کمینه‌سازی"
                                Click="TitleMinimizeButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="TitleMaximizeButton" Width="44" Height="34"
                                Content="▢" FontSize="12" Padding="0"
                                Background="Transparent" Foreground="{DynamicResource SubTextBrush}"
                                BorderThickness="0" Cursor="Hand" ToolTip="بزرگ‌نمایی"
                                Click="TitleMaximizeButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="TitleCloseButton" Width="46" Height="34"
                                Content="✕" FontSize="14" Padding="0"
                                Background="Transparent" Foreground="{DynamicResource SubTextBrush}"
                                BorderThickness="0" Cursor="Hand" ToolTip="بستن"
                                Click="TitleCloseButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="0,14,0,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#DC2626"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main App Body: Sidebar + Main Content Stage -->
            <Grid Grid.Row="1">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="RootScale"/>
                </Grid.LayoutTransform>

                <Grid x:Name="RootGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/> <!-- Left Sidebar -->
                        <ColumnDefinition Width="*"/>   <!-- Main Content Canvas -->
                    </Grid.ColumnDefinitions>

                    <!-- ================= VERTICAL SIDEBAR ================= -->
                    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                            BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Brand -->
                                <RowDefinition Height="*"/>    <!-- Navigation Tabs -->
                                <RowDefinition Height="Auto"/> <!-- Footer / Version -->
                            </Grid.RowDefinitions>

                            <!-- Brand Shield Header -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="18,18,14,14">
                                <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                                    <Path Data="M12 2L3 7v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-9-5z"
                                          Fill="{DynamicResource AccentBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="NETFASTVIP" FontSize="13.5" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Fluent Shield" FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Navigation Tabs -->
                            <StackPanel Grid.Row="1" Margin="10,10,10,10">
                                <!-- Dashboard Tab (Default Active) -->
                                <Button x:Name="NavDashboardBtn" Style="{StaticResource SidebarTabBtn}" Background="{DynamicResource CardHoverBrush}" Click="SidebarNavDashboard_Click">
                                    <Grid>
                                        <Border x:Name="NavDashboardIndicator" Width="3" Height="22" HorizontalAlignment="Left"
                                                Background="{DynamicResource AccentBrush}" CornerRadius="1.5" Visibility="Visible"/>
                                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="⌂" FontSize="18" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Width="24"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Dashboard" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                                <TextBlock x:Name="SidebarNavDashboardSubtext" Text="Ready" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- VPN Core Tab -->
                                <Button x:Name="NavVpnCoreBtn" Style="{StaticResource SidebarTabBtn}" Click="SidebarNavVpnCore_Click">
                                    <Grid>
                                        <Border x:Name="NavVpnCoreIndicator" Width="3" Height="22" HorizontalAlignment="Left"
                                                Background="{DynamicResource AccentBrush}" CornerRadius="1.5" Visibility="Collapsed"/>
                                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="🛡️" FontSize="14" VerticalAlignment="Center" Width="24"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="VPN Core" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock Text="WireGuard / OVPN" FontSize="9" Foreground="{DynamicResource SubTextBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Xray Core Tab -->
                                <Button x:Name="NavXrayCoreBtn" Style="{StaticResource SidebarTabBtn}" Click="SidebarNavXrayCore_Click">
                                    <Grid>
                                        <Border x:Name="NavXrayCoreIndicator" Width="3" Height="22" HorizontalAlignment="Left"
                                                Background="{DynamicResource AccentBrush}" CornerRadius="1.5" Visibility="Collapsed"/>
                                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="⚡" FontSize="15" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Width="24"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Xray Core" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock Text="sing-box / VLESS" FontSize="9" Foreground="{DynamicResource SubTextBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Legacy stub for compilation safety -->
                                <Button x:Name="NavServersBtn" Visibility="Collapsed"/>
                                <Border x:Name="NavServersIndicator" Visibility="Collapsed"/>

                                <!-- Hotspot Tab -->
                                <Button x:Name="NavHotspotBtn" Style="{StaticResource SidebarTabBtn}" Click="SidebarNavHotspot_Click">
                                    <Grid>
                                        <Border x:Name="NavHotspotIndicator" Width="3" Height="22" HorizontalAlignment="Left"
                                                Background="{DynamicResource AccentBrush}" CornerRadius="1.5" Visibility="Collapsed"/>
                                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="📶" FontSize="15" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Width="24"/>
                                            <TextBlock Text="Hotspot" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Speedtest Tab -->
                                <Button x:Name="NavSpeedTestBtn" Style="{StaticResource SidebarTabBtn}" Click="SidebarNavSpeedTest_Click">
                                    <Grid>
                                        <Border x:Name="NavSpeedTestIndicator" Width="3" Height="22" HorizontalAlignment="Left"
                                                Background="{DynamicResource AccentBrush}" CornerRadius="1.5" Visibility="Collapsed"/>
                                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="⏱" FontSize="15" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Width="24"/>
                                            <TextBlock Text="Speedtest" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Settings Tab -->
                                <Button x:Name="NavSettingsBtn" Style="{StaticResource SidebarTabBtn}" Click="SidebarNavSettings_Click">
                                    <Grid>
                                        <Border x:Name="NavSettingsIndicator" Width="3" Height="22" HorizontalAlignment="Left"
                                                Background="{DynamicResource AccentBrush}" CornerRadius="1.5" Visibility="Collapsed"/>
                                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="⚙" FontSize="15" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Width="24"/>
                                            <TextBlock Text="Settings" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Tools & Logs Tab -->
                                <Button x:Name="NavToolsBtn" Style="{StaticResource SidebarTabBtn}" Click="SidebarNavTools_Click">
                                    <Grid>
                                        <Border x:Name="NavToolsIndicator" Width="3" Height="22" HorizontalAlignment="Left"
                                                Background="{DynamicResource AccentBrush}" CornerRadius="1.5" Visibility="Collapsed"/>
                                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="🧰" FontSize="15" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Width="24"/>
                                            <TextBlock Text="Tools &amp; Logs" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <!-- Sidebar Footer -->
                            <Border Grid.Row="2" Margin="12,0,12,14" Padding="10,8" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="v2.5 Fluent Mica" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}"/>
                                        <TextBlock Text="Engine: sing-box / Core" FontSize="9" Foreground="#64748B"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ================= MAIN CONTENT AREA ================= -->
                    <Grid Grid.Column="1" Margin="22,18,22,18">

                        <!-- Hidden stubs to keep C# references 100% safe -->
                        <StackPanel Visibility="Collapsed">
                            <Button x:Name="HamburgerBtn" Click="HamburgerBtn_Click"/>
                            <StackPanel x:Name="HeaderBrandPanel"/>
                            <StackPanel x:Name="HeaderPagePanel"/>
                            <TextBlock x:Name="HeaderTitleText"/>
                            <TextBlock x:Name="BrandTitleText"/>
                            <Button x:Name="HeaderPowerBtn"/>
                            <Button x:Name="HeaderLogBtn"/>
                            <Button x:Name="HeaderHotspotBtn"/>
                            <Button x:Name="HeaderToolsBtn"/>
                            <Button x:Name="HeaderSettingsBtn"/>
                            <TextBlock x:Name="HotspotHeaderIcon"/>
                            <Button Visibility="Collapsed">
                                <Button.Effect><DropShadowEffect x:Name="HotspotHeaderGlow"/></Button.Effect>
                                <Button.RenderTransform><ScaleTransform x:Name="HotspotHeaderScale"/></Button.RenderTransform>
                            </Button>
                        </StackPanel>

                        <!-- ================= 1. DASHBOARD VIEW (CONCEPT 2 HIGH FIDELITY) ================= -->
                        <!-- ================= 1. DASHBOARD VIEW (CONNECTED TO REAL PROGRAM) ================= -->
                        <Grid x:Name="HomePanel" Visibility="Visible">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="HomeTransform"/>
                            </Grid.RenderTransform>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340"/> <!-- Left Hero & Telemetry -->
                                <ColumnDefinition Width="*"/>   <!-- Right Controls & Real Server List -->
                            </Grid.ColumnDefinitions>

                            <!-- ================= LEFT COLUMN: HERO CARD + TELEMETRY + DETAILS ================= -->
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Top">

                                <!-- Hero Active Server Card with Sapphire Ambient Glow -->
                                <Border Background="{DynamicResource GlassBrush}"
                                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                                        CornerRadius="16" Padding="18,16" ClipToBounds="True">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#38BDF8" BlurRadius="28" ShadowDepth="0" Opacity="0.32"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <!-- Top Row: Location/Protocol Badge + Server Name + Status Pill -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Dynamic Location/Protocol Badge -->
                                            <Border x:Name="ActiveServerBadge" Grid.Column="0" Width="44" Height="44" CornerRadius="12"
                                                    Background="#1A253C" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                                                    Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="ActiveServerBadgeText" Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Active Server Title, Subtitle, & Status -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="ActiveConnText" Text="یک کانکشن انتخاب کنید" FontSize="15" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="ServerSubText" Text="—" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <Border Background="#2038BDF8" BorderBrush="#3038BDF8" BorderThickness="1" CornerRadius="8" Padding="6,2">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#64748B" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBlock x:Name="StatusText" Text="آماده اتصال" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock x:Name="GeoIpText" Text="—" FontSize="10.5" Foreground="#64748B" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Card Footer: Duration -->
                                        <Grid Margin="0,18,0,0">
                                            <TextBlock Text="مدت زمان اتصال" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="DurationText" Text="00:00:00" FontSize="16" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Telemetry Widgets Area -->
                                <StackPanel Margin="0,18,0,0">
                                    <!-- 1. Current Speed -->
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="Current Speed" FontSize="12" Foreground="{DynamicResource SubTextBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                                            <TextBlock x:Name="DlSpeedText" Text="↓ 0 B/s" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                            <TextBlock x:Name="UlSpeedText" Text="↑ 0 B/s" FontSize="11" Foreground="#22C55E" Margin="12,0,0,2" VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                        <!-- Glowing Gradient Progress Bar -->
                                        <Border Height="6" Background="#1E293B" CornerRadius="3" ClipToBounds="True">
                                            <Border Width="200" HorizontalAlignment="Left" Background="{DynamicResource SpeedGradientBrush}" CornerRadius="3">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#06B6D4" BlurRadius="10" ShadowDepth="0" Opacity="0.55"/>
                                                </Border.Effect>
                                            </Border>
                                        </Border>
                                    </StackPanel>

                                    <!-- 2. Latency with Live Waveform -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Latency" FontSize="12" Foreground="{DynamicResource SubTextBrush}"/>
                                            <TextBlock x:Name="PingText" Text="—" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Latency Waveform Curve -->
                                        <Canvas Grid.Column="1" Height="32" Margin="16,0,0,0" VerticalAlignment="Center">
                                            <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                                  Data="M 0,20 Q 12,8 25,22 T 50,6 T 75,24 T 100,4 T 125,18 T 150,10 T 175,16">
                                                <Path.Effect>
                                                    <DropShadowEffect Color="#38BDF8" BlurRadius="10" ShadowDepth="0" Opacity="0.7"/>
                                                </Path.Effect>
                                            </Path>
                                        </Canvas>
                                    </Grid>

                                    <!-- 3. Data Used -->
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock x:Name="SessionTrafficText" Text="0 B" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="Data Used (This session)" FontSize="11.5" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Details Toggle Button & Panel -->
                                <Border Margin="0,4,0,0">
                                    <StackPanel>
                                        <Button x:Name="MoreInfoBtn" Click="MoreInfoToggle_Click" Background="Transparent" BorderThickness="0"
                                                Foreground="{DynamicResource SubTextBrush}" Padding="0" Cursor="Hand" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="MoreInfoText" Text="جزئیات اتصال" FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,4,0"/>
                                                <TextBlock x:Name="MoreInfoArrow" Text="⌄" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SubTextBrush}"/>
                                            </StackPanel>
                                        </Button>

                                        <Border x:Name="MoreInfoPanel" Visibility="Collapsed" Margin="0,8,0,0" Padding="10,8"
                                                Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10">
                                            <StackPanel>
                                                <!-- Mini Speed Graph -->
                                                <Canvas x:Name="GraphCanvas" Height="40" Margin="0,0,0,6">
                                                    <Polygon x:Name="DlArea" Fill="{StaticResource DlAreaBrush}"/>
                                                    <Polygon x:Name="UlArea" Fill="{StaticResource UlAreaBrush}"/>
                                                    <Polyline x:Name="DlLine" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"/>
                                                    <Polyline x:Name="UlLine" Stroke="#22C55E" StrokeThickness="1.2"/>
                                                </Canvas>
                                                <Grid>
                                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,4">
                                                        <TextBlock Text="Tunnel IP" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}"/>
                                                        <TextBlock x:Name="PrivateIpText" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="White" Cursor="Hand" MouseLeftButtonDown="CopyIpText_Click"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,4">
                                                        <TextBlock Text="Server IP" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}"/>
                                                        <TextBlock x:Name="ServerIpText" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="White" Cursor="Hand" MouseLeftButtonDown="CopyIpText_Click"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="1" Grid.Column="0">
                                                        <TextBlock x:Name="ProtocolLbl" Text="Protocol" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}"/>
                                                        <TextBlock x:Name="ProtocolText" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                                        <TextBlock x:Name="YouLbl" Text="User" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}"/>
                                                        <TextBlock x:Name="YouText" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ================= RIGHT COLUMN: CONNECTION CONTROL & SELECTED TARGET ================= -->
                            <Grid Grid.Column="1" Margin="8,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Connection Control Capsule Card -->
                                    <RowDefinition Height="*"/>    <!-- Selected Server Target & Quick Switch Card -->
                                    <RowDefinition Height="Auto"/> <!-- Real Subscription Card (SubSummaryCard) -->
                                </Grid.RowDefinitions>

                                <!-- 1. Connection Control Card -->
                                <Border Grid.Row="0" Background="{DynamicResource GlassBrush}"
                                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                                        CornerRadius="16" Padding="14,14" Margin="0,0,0,10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="کنترل اتصال (Connection Control)" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                                        <!-- Capsule Toggle Switch Button -->
                                        <Button x:Name="PowerBtn" Width="144" Height="50" Cursor="Hand" Click="Power_Click"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Button.RenderTransform>
                                                <ScaleTransform x:Name="PowerScale" ScaleX="1" ScaleY="1"/>
                                            </Button.RenderTransform>
                                            <Button.Effect>
                                                <DropShadowEffect Color="#22C55E" BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
                                            </Button.Effect>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="CapsuleBorder" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource GlassBorderBrush}"
                                                            BorderThickness="1" CornerRadius="25" Padding="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid Width="136" Height="42">
                                                <!-- Status Label "ON" / "OFF" -->
                                                <TextBlock x:Name="PowerStateText" Text="OFF" FontSize="15" FontWeight="Bold"
                                                           Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0"/>

                                                <!-- Glowing Circular Knob with Ring -->
                                                <Border Width="36" Height="36" HorizontalAlignment="Right" CornerRadius="18"
                                                        Background="#0B1120" BorderBrush="#F59E0B" BorderThickness="2.5" Margin="0,0,3,0">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#F59E0B" BlurRadius="14" ShadowDepth="0" Opacity="0.85"/>
                                                    </Border.Effect>
                                                    <Grid>
                                                        <!-- Power Glyph inside Knob -->
                                                        <Path x:Name="PowerGlyph" Width="17" Height="17" Stretch="Uniform"
                                                              Data="M 12,2.5 L 12,11.5 M 7.05,5.6 A 8.5,8.5 0 1 0 16.95,5.6"
                                                              Stroke="#F8FAFC" StrokeThickness="2"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              RenderTransformOrigin="0.5,0.5">
                                                            <Path.RenderTransform>
                                                                <RotateTransform x:Name="PowerGlyphRotate" Angle="0"/>
                                                            </Path.RenderTransform>
                                                        </Path>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Button>

                                        <TextBlock x:Name="PowerHintText" Text="روشن/خاموش اتصال" FontSize="11"
                                                   Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- 2. Selected Target & Quick Switch Card (Clean, Spacious, No crammed list!) -->
                                <Border Grid.Row="1" Background="{DynamicResource GlassBrush}"
                                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                                        CornerRadius="16" Padding="16,14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Card Header -->
                                        <StackPanel Grid.Row="0">
                                            <TextBlock Text="سرور انتخاب شده برای اتصال" FontSize="12.5" FontWeight="Bold" Foreground="White"/>
                                            <TextBlock Text="با کلیک روی کلید پاور، به این سرور متصل خواهید شد" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Selected Server Preview Box -->
                                        <Border Grid.Row="1" Background="{DynamicResource CardBrush}"
                                                BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                                                CornerRadius="12" Padding="14,12" Margin="0,10,0,10" VerticalAlignment="Center">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="42" Height="42" CornerRadius="12" Background="#2038BDF8" BorderBrush="#3538BDF8" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Text, ElementName=ActiveServerBadgeText}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TargetConnNameText" Text="{Binding Text, ElementName=ActiveConnText}" FontSize="13.5" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="TargetConnSubText" Text="{Binding Text, ElementName=ServerSubText}" FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Quick Navigation Buttons to Core Panels -->
                                        <StackPanel Grid.Row="2">
                                            <TextBlock Text="برای انتخاب یا تغییر سرور:" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,6"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" x:Name="HomeSwitchToVpnBtn" Content="🛡️ سرورهای VPN Core"
                                                        Click="SidebarNavVpnCore_Click" Style="{StaticResource ActionBtn}"
                                                        FontSize="11" FontWeight="SemiBold" Margin="0,0,4,0" Padding="8,8"/>
                                                <Button Grid.Column="1" x:Name="HomeSwitchToXrayBtn" Content="⚡ سرورهای Xray Core"
                                                        Click="SidebarNavXrayCore_Click" Style="{StaticResource ActionBtn}"
                                                        FontSize="11" FontWeight="SemiBold" Margin="4,0,0,0" Padding="8,8"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 3. Real Subscription Summary Card (SubSummaryCard) -->
                                <Border Grid.Row="2" x:Name="SubSummaryCard"
                                        Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                                        BorderThickness="1" CornerRadius="14" Padding="12,10" Cursor="Hand" MouseLeftButtonUp="SubSummaryCard_Click">
                                    <StackPanel>
                                        <Grid FlowDirection="LeftToRight">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" x:Name="SubRefreshBtn" Width="28" Height="28" Padding="0" Style="{StaticResource ActionBtn}" Margin="0,0,8,0" Click="SubRefreshBtn_Click" ToolTip="بروزرسانی اشتراک">
                                                <TextBlock Text="🔄" FontSize="11" RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform><RotateTransform x:Name="SubRefreshRotate"/></TextBlock.RenderTransform>
                                                </TextBlock>
                                            </Button>

                                            <StackPanel Grid.Column="1" x:Name="SubSummaryPanel" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="SubSectionLabel" Text="🎫 اشتراک من" FontSize="11.5" FontWeight="SemiBold" Foreground="White"/>
                                                    <Border x:Name="SubActiveBadge" Background="#2022C55E" CornerRadius="6" Padding="5,1" Margin="6,0,0,0" Visibility="Collapsed">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse x:Name="SubActiveDot" Width="5" Height="5" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                            <TextBlock x:Name="SubActiveText" Text="فعال" FontSize="8.5" Foreground="#22C55E"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock x:Name="SubEmptyText" Text="برای مشاهده وضعیت اشتراک کلیک کنید" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}" Margin="0,1,0,0"/>
                                            </StackPanel>

                                            <Border Grid.Column="2" x:Name="SubDetailPanel" Visibility="Collapsed" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock x:Name="SubTimeLbl" Text="زمان باقی‌مانده" FontSize="8.5" Foreground="{DynamicResource SubTextBrush}"/>
                                                        <TextBlock x:Name="SubTimeLeftText" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock x:Name="SubDataLbl" Text="حجم باقی‌مانده" FontSize="8.5" Foreground="{DynamicResource SubTextBrush}"/>
                                                        <TextBlock x:Name="SubDataLeftText" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="SubUpdatedText" Text="" Visibility="Collapsed"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Hidden Stubs (any remaining items) -->
                            <StackPanel Visibility="Collapsed">
                                <StackPanel x:Name="ActiveConnSummaryPanel"/>
                                <TextBlock x:Name="ConnSectionLabel"/>
                            </StackPanel>
                        </Grid>

                        <!-- ================= 2. VPN CORE PANEL (WIREGUARD, OPENVPN, RAS) ================= -->
                        <Grid x:Name="VpnPanel" Visibility="Collapsed">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="VpnTransform"/>
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Action Toolbar -->
                                <RowDefinition Height="*"/>    <!-- Server List -->
                            </Grid.RowDefinitions>

                            <!-- Toolbar with Title, Add, Filter, Import, Export, and Dashboard Back -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🛡️ VPN Core" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Text="سرورهای WireGuard, OpenVPN, Amnezia, L2TP, SSTP" FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="AddBtn" Content="＋ Add" Style="{StaticResource PrimaryActionBtn}" Click="Add_Click" Margin="0,0,6,0"/>
                                    <Button x:Name="FilterDropdownBtn" Style="{StaticResource ActionBtn}" Click="FilterDropdownBtn_Click" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="FilterDropdownLabel" Text="همه" FontSize="11"/>
                                            <TextBlock Text=" ⌄" FontSize="10" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="📁 Import" Style="{StaticResource ActionBtn}" Click="Import_Click" Margin="0,0,6,0"/>
                                    <Button Content="💾 Export" Style="{StaticResource ActionBtn}" Click="Export_Click" Margin="0,0,6,0"/>
                                    <Button Content="⌂ داشبورد" Style="{StaticResource ActionBtn}" Click="SidebarNavDashboard_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- Full-Height Scrollable Connections List (ConnList) -->
                            <Border Grid.Row="1" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                                    BorderThickness="1" CornerRadius="14" Padding="8,8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="ConnList"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <!-- ================= 2. SERVERS PANEL (XRAY & VPN CONNECTIONS) ================= -->
                        <Grid x:Name="XrayPanel" Visibility="Collapsed">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="XrayTransform"/>
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Action Toolbar -->
                                <RowDefinition Height="*"/>    <!-- Server List -->
                                <RowDefinition Height="Auto"/> <!-- Subscription Card -->
                            </Grid.RowDefinitions>

                            <!-- Toolbar with Add Subscription, Ping All, Refresh, Clear -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="XrayConnSectionLabel" Text="⚡ Xray Core" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Text="هسته sing-box (VLESS / VMess / Trojan)" FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    <!-- Hidden Mode Switcher Stubs for code-behind compatibility -->
                                    <Button x:Name="XraySwitchToVpnBtn" Click="SwitchToVpnBtn_Click" Visibility="Collapsed"/>
                                    <Button x:Name="XraySwitchToXrayBtn" Click="SwitchToXrayBtn_Click" Visibility="Collapsed"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="XrayAddSubBtn" Content="＋ Add Subscription" Style="{StaticResource PrimaryActionBtn}" Click="XrayAddSub_Click" Margin="0,0,6,0"/>
                                    <Button x:Name="XrayUpdateSubBtn" Style="{StaticResource ActionBtn}" Click="XrayUpdateSub_Click" Margin="0,0,6,0" ToolTip="Update All">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔄" FontSize="11"/>
                                            <TextBlock x:Name="XrayUpdateSubLabel" Text=" Update" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="XrayPingAllBtn" Style="{StaticResource ActionBtn}" Click="XrayPingAll_Click" Margin="0,0,6,0" ToolTip="Ping All Servers">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡" FontSize="11"/>
                                            <TextBlock x:Name="XrayPingAllLabel" Text=" Ping All" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="XrayClearServersBtn" Content="🗑" Style="{StaticResource ActionBtn}" Click="XrayClearServers_Click" Margin="0,0,6,0" ToolTip="Clear Servers"/>
                                    <Button Content="⌂ داشبورد" Style="{StaticResource ActionBtn}" Click="SidebarNavDashboard_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- Connections and Subscription Groups List -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="XrayConnList" Margin="0,0,0,10"/>
                            </ScrollViewer>
                            <ListBox x:Name="XrayProxyList" Visibility="Collapsed"/>

                            <!-- Subscription Card -->
                            <Border Grid.Row="2" x:Name="XraySubSummaryCard" Background="{DynamicResource GlassBrush}"
                                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="XraySubRefreshBtn" Width="32" Height="32" Style="{StaticResource ActionBtn}" Padding="0" Click="XrayUpdateSub_Click" Margin="0,0,10,0">
                                        <TextBlock Text="🔄" FontSize="13" RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform><RotateTransform x:Name="XraySubRefreshRotate"/></TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Button>
                                    <StackPanel Grid.Column="1" x:Name="XraySubSummaryPanel" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="XraySubSectionLabel" Text="My Subscription" FontSize="12.5" FontWeight="Bold" Foreground="White"/>
                                            <Border x:Name="XraySubActiveBadge" Background="#2022C55E" CornerRadius="6" Padding="6,1" Margin="8,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse x:Name="XraySubActiveDot" Width="5" Height="5" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock x:Name="XraySubActiveText" Text="Active" FontSize="9.5" Foreground="#22C55E"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="XraySubEmptyText" Text="Click to load subscription status" FontSize="11" Foreground="{DynamicResource SubTextBrush}" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" x:Name="XraySubDetailPanel">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <StackPanel Margin="0,0,20,0">
                                                <TextBlock x:Name="XraySubTimeLbl" Text="Expires" FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                                                <TextBlock x:Name="XraySubTimeLeftText" Text="—" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock x:Name="XraySubDataLbl" Text="Data Left" FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                                                <TextBlock x:Name="XraySubDataLeftText" Text="—" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                            </StackPanel>
                                            <TextBlock x:Name="XraySubUpdatedText" Text="" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Hidden Xray Power & Telemetry Stubs -->
                            <StackPanel Visibility="Collapsed">
                                <Button x:Name="XrayBtnPower" Click="XrayBtnPower_Click">
                                    <Button.RenderTransform><ScaleTransform x:Name="XrayPowerScale"/></Button.RenderTransform>
                                    <Path x:Name="XrayPowerGlyph" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform><RotateTransform x:Name="XrayPowerGlyphRotate"/></Path.RenderTransform>
                                    </Path>
                                </Button>
                                <TextBlock x:Name="XrayPowerHintText"/>
                                <StackPanel x:Name="XrayActiveConnSummaryPanel"/>
                                <Ellipse x:Name="XrayStatusDot"/>
                                <TextBlock x:Name="XrayStatusText"/>
                                <TextBlock x:Name="XrayTxtActiveName"/>
                                <TextBlock x:Name="XrayTxtActiveProtocol"/>
                                <TextBlock x:Name="XrayTxtActiveGeoIP"/>
                                <TextBlock x:Name="XrayTxtDuration"/>
                                <Button x:Name="XrayMoreInfoBtn" Click="XrayMoreInfoToggle_Click"/>
                                <TextBlock x:Name="XrayMoreInfoText"/>
                                <TextBlock x:Name="XrayMoreInfoArrow"/>
                                <Border x:Name="XrayMoreInfoPanel"/>
                                <Canvas x:Name="XrayGraphCanvas">
                                    <Polygon x:Name="XrayDlArea"/>
                                    <Polygon x:Name="XrayUlArea"/>
                                    <Polyline x:Name="XrayDlLine"/>
                                    <Polyline x:Name="XrayUlLine"/>
                                </Canvas>
                                <TextBlock x:Name="XrayDlSpeedText"/>
                                <TextBlock x:Name="XrayUlSpeedText"/>
                                <TextBlock x:Name="XrayPingText"/>
                                <TextBlock x:Name="XraySessionTrafficText"/>
                                <TextBlock x:Name="XrayPrivateIpText" MouseLeftButtonDown="CopyIpText_Click"/>
                                <TextBlock x:Name="XrayServerIpText" MouseLeftButtonDown="CopyIpText_Click"/>
                                <TextBlock x:Name="XrayYouLbl"/>
                                <TextBlock x:Name="XrayYouText"/>
                                <TextBlock x:Name="XrayProtocolLbl"/>
                                <TextBlock x:Name="XrayProtocolText"/>
                            </StackPanel>
                        </Grid>

                        <!-- ================= 3. HOTSPOT PANEL ================= -->
                        <ScrollViewer Grid.Row="1" x:Name="HotspotPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.RenderTransform>
                                <TranslateTransform x:Name="HotspotTransform"/>
                            </ScrollViewer.RenderTransform>
                            <StackPanel Margin="2,0">
                                <TextBlock Text="VPN WiFi-Direct &amp; Hotspot" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>

                                <Border Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,15">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" x:Name="HsVpnLabel" Text="Active VPN Connection:" Foreground="{DynamicResource SubTextBrush}" FontSize="11.5"/>
                                        <TextBlock Grid.Row="0" x:Name="HsVpnConnectionText" Text="Checking..." Foreground="White" FontSize="13" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Row="2" x:Name="HsAdapterLabel" Text="Internet NIC Adapter:" Foreground="{DynamicResource SubTextBrush}" FontSize="11.5"/>
                                        <TextBlock Grid.Row="2" x:Name="HsSourceText" Text="Checking..." Foreground="White" FontSize="12.5" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>

                                <UniformGrid Columns="3" Margin="0,0,0,15">
                                    <Button x:Name="BtnHsStart" Content="Start Hotspot" Style="{StaticResource PrimaryActionBtn}" Height="42" Margin="0,0,4,0" Click="BtnHsStart_Click"/>
                                    <Button x:Name="BtnHsStop" Content="Stop" Style="{StaticResource ActionBtn}" Height="42" Margin="4,0,4,0" IsEnabled="False" Click="BtnHsStop_Click"/>
                                    <Button x:Name="BtnHsRestart" Content="Restart" Style="{StaticResource ActionBtn}" Height="42" Margin="4,0,0,0" IsEnabled="False" Click="BtnHsRestart_Click"/>
                                </UniformGrid>

                                <TextBlock x:Name="HsStatusText" Text="Waiting for VPN connection..." Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="HsManualHint" Visibility="Collapsed" Foreground="{DynamicResource SubTextBrush}" FontSize="11.5" Margin="0,-5,0,5" HorizontalAlignment="Center">
                                    <Run Text="Wi-Fi Direct NIC usually named Local Area Connection*"/>
                                </TextBlock>
                                <Button x:Name="BtnOpenNcpa" Content="Open Network Connections (ncpa.cpl) 🔗" Visibility="Collapsed" Background="Transparent" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" Cursor="Hand" Margin="0,0,0,15" Click="BtnOpenNcpa_Click" FontWeight="Bold" FontSize="12"/>

                                <Border x:Name="HsInfoContainer" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,15" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="SSID:" Foreground="{DynamicResource SubTextBrush}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="HsSsidText" Text="-" Foreground="White" FontSize="14" FontWeight="Bold" FontFamily="Consolas"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="PASS:" Foreground="{DynamicResource SubTextBrush}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="HsPassText" Text="-" Foreground="White" FontSize="14" FontWeight="Bold" FontFamily="Consolas"/>
                                    </Grid>
                                </Border>

                                <Border x:Name="HsQrContainer" Background="White" CornerRadius="12" Padding="14" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock x:Name="QrScanLbl" Text="📱 Scan to Connect Fast" Foreground="#0F172A" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                                        <Image x:Name="HsQrImage" Width="130" Height="130" Stretch="Uniform"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="HsClientsContainer" Visibility="Collapsed" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10"
                                        Cursor="Hand" MouseEnter="HsClientsContainer_MouseEnter" MouseLeave="HsClientsContainer_MouseLeave">
                                    <Grid>
                                        <TextBlock x:Name="HsClientsCountText" Text="Connected Devices: 0" Foreground="White" FontSize="12" HorizontalAlignment="Center"/>
                                        <Popup x:Name="HsClientsPopup" PlacementTarget="{Binding ElementName=HsClientsContainer}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Width="300">
                                                <TextBox x:Name="HsClientsTextBox" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="130" Background="{DynamicResource FieldBrush}" Foreground="White" BorderThickness="0" FontFamily="Consolas" FontSize="11" Padding="6"/>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ================= 4. TOOLBOX PANEL ================= -->
                        <DockPanel x:Name="ToolboxPanel" Visibility="Collapsed" LastChildFill="True">
                            <DockPanel.RenderTransform>
                                <TranslateTransform x:Name="ToolsTransform"/>
                            </DockPanel.RenderTransform>
                            <TextBlock DockPanel.Dock="Top" x:Name="ToolboxTitle" Text="🧰 Network Toolbox &amp; Diagnostics" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                            
                            <Button DockPanel.Dock="Top" x:Name="SpeedTestBtn" Style="{StaticResource ToolTile}" Click="SpeedTest_Click" Margin="0,0,0,10" Padding="12,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚀" FontSize="16" Foreground="#22C55E" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SpeedTestLbl" Text="Run Connection Speed Test" FontSize="13" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="White"/>
                                </StackPanel>
                            </Button>

                            <UniformGrid DockPanel.Dock="Top" Columns="3" Rows="2" Margin="0,0,0,10">
                                <Button x:Name="RenewIpBtn" Style="{StaticResource ToolTile}" Click="RenewIp_Click">
                                    <StackPanel><TextBlock Text="🔄" FontSize="16" HorizontalAlignment="Center"/><TextBlock x:Name="RenewIpLbl" Text="Renew IP" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button x:Name="FlushDnsBtn" Style="{StaticResource ToolTile}" Click="FlushDns_Click">
                                    <StackPanel><TextBlock Text="🧹" FontSize="16" HorizontalAlignment="Center"/><TextBlock x:Name="FlushDnsLbl" Text="Flush DNS" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button x:Name="ProxyOffBtn" Style="{StaticResource ToolTile}" Click="ProxyOff_Click">
                                    <StackPanel><TextBlock Text="🚫" FontSize="16" HorizontalAlignment="Center"/><TextBlock x:Name="DisableProxyLbl" Text="Disable Proxy" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button x:Name="KillProcBtn" Style="{StaticResource ToolTile}" Click="KillProc_Click">
                                    <StackPanel><TextBlock Text="⛔" FontSize="16" HorizontalAlignment="Center"/><TextBlock x:Name="KillProcLbl" Text="Kill Frozen Procs" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button x:Name="DnsLeakTestBtn" Style="{StaticResource ToolTile}" Click="DnsLeakTest_Click">
                                    <StackPanel><TextBlock Text="🧪" FontSize="16" HorizontalAlignment="Center"/><TextBlock x:Name="DnsLeakLbl" Text="DNS Leak Test" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button x:Name="ResetAdapterBtn" Style="{StaticResource ToolTile}" Click="ResetAdapter_Click">
                                    <StackPanel><TextBlock Text="🔁" FontSize="16" HorizontalAlignment="Center"/><TextBlock x:Name="ResetAdapterLbl" Text="Reset Adapter" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel>
                                </Button>
                            </UniformGrid>

                            <TextBlock DockPanel.Dock="Top" x:Name="PingTraceLbl" Text="🏓 Ping &amp; Traceroute" Style="{StaticResource SectionTitle}"/>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="ToolTargetBox" Height="34" FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Center" Background="{DynamicResource FieldBrush}" Foreground="White" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="8,0"/>
                                <Button Grid.Column="2" x:Name="PingToggleBtn" Content="🏓 Start Ping" Style="{StaticResource ActionBtn}" Click="PingToggle_Click"/>
                                <Button Grid.Column="4" x:Name="TracerouteToggleBtn" Content="🛰 Traceroute" Style="{StaticResource ActionBtn}" Click="TracerouteToggle_Click"/>
                            </Grid>

                            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                <TextBlock x:Name="LogSectionLbl" Text="📜 System Logs" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                                <Button x:Name="ClearLogBtn" Content="🗑 Clear" Style="{StaticResource ActionBtn}" HorizontalAlignment="Right" Padding="8,3" Click="ClearLog_Click"/>
                            </Grid>
                            <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="White" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="8"/>
                        </DockPanel>

                        <!-- ================= 5. SETTINGS PANEL ================= -->
                        <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.RenderTransform>
                                <TranslateTransform x:Name="SettingsTransform"/>
                            </ScrollViewer.RenderTransform>
                            <StackPanel Margin="2,0">
                                <TextBlock Text="Settings &amp; Configuration" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,14"/>

                                <Expander x:Name="AppearanceExpander" Header="🎨 Appearance &amp; Language" IsExpanded="True" Margin="0,0,0,10" Padding="10" Foreground="White" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                                    <StackPanel Margin="4,10,4,4">
                                        <TextBlock x:Name="LangLabel" Text="Language" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="LangFaRb" GroupName="Language" Content="فارسی" Margin="0,0,16,0" Checked="LangRb_Click"/>
                                            <RadioButton x:Name="LangEnRb" GroupName="Language" Content="English" Checked="LangRb_Click"/>
                                        </StackPanel>
                                        <TextBlock x:Name="ThemeLabel" Text="Theme" Foreground="{DynamicResource SubTextBrush}" Margin="0,14,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="ThemeDarkRb" GroupName="Theme" Content="Dark" Margin="0,0,16,0" Checked="ThemeRb_Click"/>
                                            <RadioButton x:Name="ThemeLightRb" GroupName="Theme" Content="Light" Margin="0,0,16,0" Checked="ThemeRb_Click"/>
                                            <RadioButton x:Name="ThemeSystemRb" GroupName="Theme" Content="System" Checked="ThemeRb_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>

                                <Expander x:Name="BehaviorExpander" Header="⚙ Connection Behavior" Margin="0,0,0,10" Padding="10" Foreground="White" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                                    <StackPanel Margin="4,10,4,4">
                                        <CheckBox x:Name="SmartToggle" Content="Smart Connect (Auto try all servers)" Checked="SmartToggle_Changed" Unchecked="SmartToggle_Changed"/>
                                        <CheckBox x:Name="TrayToggle" Content="Minimize to tray instead of closing" Checked="TrayToggle_Changed" Unchecked="TrayToggle_Changed" Margin="0,6,0,0"/>
                                        <CheckBox x:Name="KillSwitchToggle" Content="Kill Switch (Block internet if VPN drops)" Checked="KillSwitchToggle_Changed" Unchecked="KillSwitchToggle_Changed" Margin="0,6,0,0"/>
                                        <CheckBox x:Name="StartupToggle" Content="Start with Windows" Checked="StartupToggle_Changed" Unchecked="StartupToggle_Changed" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Expander>

                                <Expander x:Name="IdleExpander" Header="⏱ Idle Auto-Disconnect" Margin="0,0,0,10" Padding="10" Foreground="White" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                                    <StackPanel Margin="4,10,4,4">
                                        <RadioButton x:Name="IdleOffRb" GroupName="IdleMode" Content="Always Connected" Checked="IdleRb_Checked"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <RadioButton x:Name="IdleOnRb" GroupName="IdleMode" Content="Disconnect after" VerticalAlignment="Center" Checked="IdleRb_Checked"/>
                                            <TextBox x:Name="IdleMinutesBox" Width="52" Height="28" Margin="10,0,8,0" FontFamily="Consolas" FontSize="12" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="{DynamicResource FieldBrush}" Foreground="White" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" LostFocus="IdleMinutes_LostFocus"/>
                                            <TextBlock x:Name="IdleMinutesLabel" Text="minutes idle" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>

                                <Expander x:Name="SplitExpander" Header="🔀 Per-App Split Tunneling (Xray / Proxy)" Margin="0,0,0,10" Padding="10" Foreground="White" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                                    <StackPanel Margin="4,10,4,4">
                                        <RadioButton x:Name="StOffRb" GroupName="StMode" Tag="off" Content="Tunnel Entire System" Checked="StMode_Checked"/>
                                        <RadioButton x:Name="StAllowRb" GroupName="StMode" Tag="allow" Content="Only selected apps (Allow list)" Checked="StMode_Checked" Margin="0,6,0,0"/>
                                        <RadioButton x:Name="StDenyRb" GroupName="StMode" Tag="deny" Content="Bypass selected apps" Checked="StMode_Checked" Margin="0,6,0,0"/>
                                        <Button x:Name="BtnManagePerApp" Content="⚙️ Manage App List" Click="BtnManagePerApp_Click" Style="{StaticResource ActionBtn}" Margin="0,10,0,2"/>
                                    </StackPanel>
                                </Expander>

                                <Expander x:Name="DnsExpander" Header="🌐 DNS Servers" Margin="0,0,0,10" Padding="10" Foreground="White" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                                    <StackPanel Margin="4,10,4,4">
                                        <RadioButton x:Name="DnsAutoRb" GroupName="DnsMode" Tag="auto" Content="Automatic" Checked="DnsRb_Checked"/>
                                        <RadioButton x:Name="DnsCfRb" GroupName="DnsMode" Tag="cloudflare" Content="Cloudflare — 1.1.1.1" Checked="DnsRb_Checked" Margin="0,5,0,0"/>
                                        <RadioButton x:Name="DnsGoogleRb" GroupName="DnsMode" Tag="google" Content="Google — 8.8.8.8" Checked="DnsRb_Checked" Margin="0,5,0,0"/>
                                        <RadioButton x:Name="DnsAdguardRb" GroupName="DnsMode" Tag="adguard" Content="AdGuard — Ad Blocking" Checked="DnsRb_Checked" Margin="0,5,0,0"/>
                                        <RadioButton x:Name="DnsAdguardFamilyRb" GroupName="DnsMode" Tag="adguard_family" Content="AdGuard Family" Checked="DnsRb_Checked" Margin="0,5,0,0"/>
                                        <RadioButton x:Name="DnsCustomRb" GroupName="DnsMode" Tag="custom" Content="Custom DNS" Checked="DnsRb_Checked" Margin="0,5,0,0"/>
                                        <Grid Margin="0,8,0,2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="DnsPrimaryBox" Height="30" FontFamily="Consolas" FontSize="12" Background="{DynamicResource FieldBrush}" Foreground="White" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" LostFocus="DnsBox_LostFocus"/>
                                            <TextBox Grid.Column="2" x:Name="DnsSecondaryBox" Height="30" FontFamily="Consolas" FontSize="12" Background="{DynamicResource FieldBrush}" Foreground="White" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" LostFocus="DnsBox_LostFocus"/>
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <Expander x:Name="PackageExpander" Header="📦 Package &amp; About" Margin="0,0,0,10" Padding="10" Foreground="White" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                                    <StackPanel Margin="4,10,4,4">
                                        <Button x:Name="UpdateBaseBtn" Content="🔧 Update base.ovpn" Style="{StaticResource ActionBtn}" Margin="0,4" Click="UpdateBase_Click"/>
                                        <Button x:Name="ImportBtn" Content="📥 Import OVPN / Package" Style="{StaticResource ActionBtn}" Margin="0,4" Click="Import_Click"/>
                                        <Button x:Name="ExportBtn" Content="📤 Export Connections" Style="{StaticResource ActionBtn}" Margin="0,4" Click="Export_Click"/>
                                        <Button x:Name="AboutBtn" Content="ℹ About &amp; Support" Style="{StaticResource ActionBtn}" Margin="0,10,0,4" Click="About_Click"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ================= 6. CONNECTION LOGS PANEL ================= -->
                        <Grid x:Name="ConnLogPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="ConnLogTransform"/>
                            </Grid.RenderTransform>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock x:Name="ConnLogSectionLbl" Text="📶 Connection Logs" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                <Button x:Name="ClearConnLogBtn" Content="🗑 Clear Logs" Style="{StaticResource ActionBtn}" HorizontalAlignment="Right" Click="ClearConnLog_Click"/>
                            </Grid>
                            <TextBox Grid.Row="1" x:Name="ConnLogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBrush}" Foreground="White" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="8"/>
                        </Grid>

                    </Grid>
                </Grid>

                <!-- ================= MINI WIDGET ================= -->
                <Border x:Name="MiniWidget" Visibility="Collapsed" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="8">
                    <Border.ContextMenu>
                        <ContextMenu><MenuItem x:Name="MiniAlwaysOnTopMenuItem" Header="Always on Top" IsCheckable="True" Click="MiniAlwaysOnTop_Click"/></ContextMenu>
                    </Border.ContextMenu>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="MiniPowerBtn" Width="44" Height="44" Background="#334155" Cursor="Hand" Click="Power_Click">
                            <Button.Effect><DropShadowEffect x:Name="MiniPowerGlow" Color="#22C55E" BlurRadius="12" Opacity="0"/></Button.Effect>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="22">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Path Width="20" Height="20" Stretch="Uniform" Data="M 12,2.5 L 12,11.5 M 7.05,5.6 A 8.5,8.5 0 1 0 16.95,5.6" Stroke="White" StrokeThickness="2"/>
                        </Button>
                        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="MiniStatusDot" Width="7" Height="7" Fill="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="MiniStatusText" Text="Ready" FontSize="12.5" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                            <TextBlock x:Name="MiniConnectionText" Text="—" FontSize="10" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0"/>
                            <TextBlock x:Name="MiniSpeedText" Text="↓ 0 B/s   ↑ 0 B/s" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" x:Name="MiniRestoreBtn" Width="42" Height="42" Background="{DynamicResource AccentBrush}" Cursor="Hand" Click="MiniRestoreBtn_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="⤢" FontSize="19" Foreground="White"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- DRAWER OVERLAY (Preserved) -->
            <Grid x:Name="DrawerOverlay" Grid.RowSpan="2" Background="#80000000" Visibility="Collapsed" Panel.ZIndex="999" MouseLeftButtonDown="DrawerOverlay_MouseLeftButtonDown">
                <Border x:Name="DrawerMenuPanel" HorizontalAlignment="Left" Width="260" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,1,0" MouseLeftButtonDown="DrawerMenuPanel_MouseLeftButtonDown">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="20,20,20,10">
                            <TextBlock x:Name="DrawerTitleText" Text="Main Menu" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="DrawerClose_Click">
                                <Path Data="M18 6L6 18M6 6l12 12" Stroke="#94A3B8" StrokeThickness="2" Stretch="Uniform" Width="14" Height="14"/>
                            </Button>
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="10,20,10,10">
                            <Button Style="{StaticResource DrawerNavBtn}" Click="HotspotNavHome_Click"><TextBlock x:Name="DrawerNavHomeText" Text="🏠 Dashboard" Foreground="White"/></Button>
                            <Button Style="{StaticResource DrawerNavBtn}" Margin="0,5,0,0" Click="HotspotNavXray_Click"><TextBlock x:Name="DrawerNavXrayText" Text="🚀 Xray Service" Foreground="White"/></Button>
                            <Button Style="{StaticResource DrawerNavBtn}" Margin="0,5,0,0" Click="HotspotNavLogs_Click"><TextBlock x:Name="DrawerNavLogsText" Text="📄 Connection Logs" Foreground="White"/></Button>
                            <Button Style="{StaticResource DrawerNavBtn}" Margin="0,5,0,0" Click="OpenHotspotWindow_Click"><TextBlock x:Name="DrawerNavHotspotText" Text="🛜 Hotspot Manager" Foreground="White"/></Button>
                            <Button Style="{StaticResource DrawerNavBtn}" Margin="0,5,0,0" Click="HotspotNavTools_Click"><TextBlock x:Name="DrawerNavToolsText" Text="🧰 Toolbox" Foreground="White"/></Button>
                            <Button Style="{StaticResource DrawerNavBtn}" Margin="0,5,0,0" Click="HotspotNavSettings_Click"><TextBlock x:Name="DrawerNavSettingsText" Text="⚙ Settings" Foreground="White"/></Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- IN-APP SUB INPUT MODAL OVERLAY -->
            <Grid x:Name="XraySubOverlay" Grid.RowSpan="2" Background="#B0000000" Visibility="Collapsed" Panel.ZIndex="998" MouseLeftButtonDown="XraySubOverlay_MouseLeftButtonDown">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="360" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20,18" MouseLeftButtonDown="XraySubModal_MouseLeftButtonDown">
                    <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#000000" Opacity="0.7"/></Border.Effect>
                    <StackPanel x:Name="XraySubModalStack">
                        <Grid Margin="0,0,0,14">
                            <TextBlock x:Name="XraySubTitleText" Text="🔗 Add Xray Subscription Link" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="XraySubCancel_Click">
                                <Path Data="M18 6L6 18M6 6l12 12" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="2" Stretch="Uniform" Width="12" Height="12"/>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="XraySubNameHintText" Text="Subscription / Group Name (Optional):" Foreground="{DynamicResource SubTextBrush}" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="XraySubNameInput" Height="34" Padding="8,6" Margin="0,0,0,10" Background="{DynamicResource FieldBrush}" Foreground="White" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" FontSize="11.5" VerticalContentAlignment="Center"/>
                        <TextBlock x:Name="XraySubHintText" Text="Enter subscription link or node URL:" Foreground="{DynamicResource SubTextBrush}" FontSize="11" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="XraySubUrlInput" Grid.Column="0" Height="34" Padding="8,6" Background="{DynamicResource FieldBrush}" Foreground="White" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" FontSize="11.5" VerticalContentAlignment="Center" KeyDown="XraySubUrlInput_KeyDown"/>
                            <Button Grid.Column="1" x:Name="XraySubPasteBtn" Content="📋 Paste" Style="{StaticResource ActionBtn}" Padding="10,0" Height="34" Margin="6,0,0,0" FontSize="11" Click="XraySubPaste_Click"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="XraySubSubmitBtn" Content="Save &amp; Import" Style="{StaticResource PrimaryActionBtn}" Height="36" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0" Click="XraySubSubmit_Click"/>
                            <Button Grid.Column="1" x:Name="XraySubCancelBtn" Content="Cancel" Style="{StaticResource ActionBtn}" Height="36" FontSize="12" Margin="6,0,0,0" Click="XraySubCancel_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- IN-APP SHARE MODAL OVERLAY -->
            <Grid x:Name="XrayShareOverlay" Grid.RowSpan="2" Background="#B0000000" Visibility="Collapsed" Panel.ZIndex="998" MouseLeftButtonDown="XrayShareOverlay_MouseLeftButtonDown">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="340" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20,18" MouseLeftButtonDown="XrayShareModal_MouseLeftButtonDown">
                    <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#000000" Opacity="0.7"/></Border.Effect>
                    <StackPanel x:Name="XrayShareModalStack">
                        <Grid Margin="0,0,0,12">
                            <TextBlock x:Name="XrayShareTitleText" Text="📱 Share Connection" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="XrayShareClose_Click">
                                <Path Data="M18 6L6 18M6 6l12 12" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="2" Stretch="Uniform" Width="12" Height="12"/>
                            </Button>
                        </Grid>
                        <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <Border Background="#1E293B" CornerRadius="4" Padding="5,1" Margin="0,0,6,0"><TextBlock x:Name="XrayShareProtoBadge" Text="VLESS" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/></Border>
                                    <TextBlock x:Name="XrayShareAliasText" Text="Server Name" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>
                                <TextBlock x:Name="XrayShareAddressText" Text="1.2.3.4:443" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="10" Padding="10" Margin="0,0,0,12" HorizontalAlignment="Center">
                            <Image x:Name="XrayShareQrImage" Width="150" Height="150" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Border>
                        <TextBlock x:Name="XrayShareHintText" Text="Scan with camera or mobile VPN app" Foreground="{DynamicResource SubTextBrush}" FontSize="10.5" TextAlignment="Center" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="XrayShareCopyBtn" Content="📋 Copy Link" Style="{StaticResource PrimaryActionBtn}" Height="34" FontSize="12" Margin="0,0,6,0" Click="XrayShareCopyBtn_Click"/>
                            <Button Grid.Column="1" x:Name="XrayShareCloseBtn" Content="Close" Style="{StaticResource ActionBtn}" Height="34" Padding="14,0" FontSize="12" Click="XrayShareClose_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- IN-APP MESSAGE MODAL OVERLAY -->
            <Grid x:Name="InAppMessageOverlay" Grid.RowSpan="2" Background="#B0000000" Visibility="Collapsed" Panel.ZIndex="1000" MouseLeftButtonDown="InAppMsgOverlay_Dismiss">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="330" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20,18" MouseLeftButtonDown="InAppMsgBox_MouseLeftButtonDown">
                    <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#000000" Opacity="0.7"/></Border.Effect>
                    <StackPanel x:Name="InAppMessageModalStack">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock x:Name="InAppMsgIcon" Text="ℹ" FontSize="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="InAppMsgTitle" Text="System Message" Foreground="White" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="InAppMsgText" Text="Message" Foreground="{DynamicResource SubTextBrush}" FontSize="12" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,16"/>
                        <Button x:Name="InAppMsgOkBtn" Content="OK" Style="{StaticResource PrimaryActionBtn}" Height="34" Width="100" HorizontalAlignment="Center" FontSize="12" Click="InAppMsgOverlay_Dismiss"/>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
