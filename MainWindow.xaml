                                        <Path.RenderTransform><RotateTransform x:Name="XrayPowerGlyphRotate"/></Path.RenderTransform>
                                    </Path>
                                </Button>
                                <TextBlock x:Name="XrayPowerHintText"/>
                                <StackPanel x:Name="XrayActiveConnSummaryPanel"/>
                                <Ellipse x:Name="XrayStatusDot"/>
                                <TextBlock x:Name="XrayStatusText"/>
                                <TextBlock x:Name="XrayTxtActiveName"/>
                                <TextBlock x:Name="XrayTxtActiveProtocol"/>
                                <TextBlock x:Name="XrayTxtActiveGeoIP"/>
                                <TextBlock x:Name="XrayTxtDuration"/>
                                <Button x:Name="XrayMoreInfoBtn" Click="XrayMoreInfoToggle_Click"/>
                                <TextBlock x:Name="XrayMoreInfoText"/>
                                <TextBlock x:Name="XrayMoreInfoArrow"/>
                                <Border x:Name="XrayMoreInfoPanel"/>
                                <Canvas x:Name="XrayGraphCanvas">
                                    <Polygon x:Name="XrayDlArea"/>
                                    <Polygon x:Name="XrayUlArea"/>
                                    <Polyline x:Name="XrayDlLine"/>
                                    <Polyline x:Name="XrayUlLine"/>
                                </Canvas>
                                <TextBlock x:Name="XrayDlSpeedText"/>
                                <TextBlock x:Name="XrayUlSpeedText"/>
                                <TextBlock x:Name="XrayPingText"/>
                                <TextBlock x:Name="XraySessionTrafficText"/>
                                <TextBlock x:Name="XrayPrivateIpText" MouseLeftButtonDown="CopyIpText_Click"/>
                                <TextBlock x:Name="XrayServerIpText" MouseLeftButtonDown="CopyIpText_Click"/>
                                <TextBlock x:Name="XrayYouLbl"/>
                                <TextBlock x:Name="XrayYouText"/>
                                <TextBlock x:Name="XrayProtocolLbl"/>
                                <TextBlock x:Name="XrayProtocolText"/>
                            </StackPanel>
                        </Grid>

                        <!-- ================= 3. HOTSPOT PANEL ================= -->
                        <ScrollViewer Grid.Row="1" x:Name="HotspotPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.RenderTransform>
                                <TranslateTransform x:Name="HotspotTransform"/>
                            </ScrollViewer.RenderTransform>
                            <StackPanel Margin="2,0">
                                <Grid Margin="0,0,0,15">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="HotspotBackHomeBtn" Style="{StaticResource ActionBtn}" Click="SidebarNavDashboard_Click"
                                                Height="32" Padding="10,4" Margin="0,0,10,0" ToolTip="بازگشت به داشبورد" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="⌂" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="داشبورد" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Text="📶 VPN Wi-Fi Direct" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource ElevatedPanelCard}" Padding="16,14" Margin="0,0,0,15">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" x:Name="HsVpnLabel" Text="Active VPN Connection:" Foreground="{DynamicResource SubTextBrush}" FontSize="11.5"/>
                                        <TextBlock Grid.Row="0" x:Name="HsVpnConnectionText" Text="Checking..." Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Row="2" x:Name="HsAdapterLabel" Text="Internet NIC Adapter:" Foreground="{DynamicResource SubTextBrush}" FontSize="11.5"/>
                                        <TextBlock Grid.Row="2" x:Name="HsSourceText" Text="Checking..." Foreground="{DynamicResource TextBrush}" FontSize="12.5" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>

                                <UniformGrid Columns="3" Margin="0,0,0,15">
                                    <Button x:Name="BtnHsStart" Content="Start Hotspot" Style="{StaticResource PrimaryActionBtn}" Height="42" Margin="0,0,4,0" Click="BtnHsStart_Click"/>
                                    <Button x:Name="BtnHsStop" Content="Stop" Style="{StaticResource ActionBtn}" Height="42" Margin="4,0,4,0" IsEnabled="False" Click="BtnHsStop_Click"/>
                                    <Button x:Name="BtnHsRestart" Content="Restart" Style="{StaticResource ActionBtn}" Height="42" Margin="4,0,0,0" IsEnabled="False" Click="BtnHsRestart_Click"/>
                                </UniformGrid>

                                <TextBlock x:Name="HsStatusText" Text="Waiting for VPN connection..." Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="HsManualHint" Visibility="Collapsed" Foreground="{DynamicResource SubTextBrush}" FontSize="11.5" Margin="0,-5,0,5" HorizontalAlignment="Center">
                                    <Run Text="Wi-Fi Direct NIC usually named Local Area Connection*"/>
                                </TextBlock>
                                <Button x:Name="BtnOpenNcpa" Content="Open Network Connections (ncpa.cpl) 🔗" Visibility="Collapsed" Background="Transparent" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" Cursor="Hand" Margin="0,0,0,15" Click="BtnOpenNcpa_Click" FontWeight="Bold" FontSize="12"/>

                                <Border x:Name="HsInfoContainer" Style="{StaticResource ElevatedPanelCard}" Padding="16,14" Margin="0,0,0,15" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="SSID:" Foreground="{DynamicResource SubTextBrush}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="HsSsidText" Text="-" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Bold" FontFamily="Consolas"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="PASS:" Foreground="{DynamicResource SubTextBrush}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="HsPassText" Text="-" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Bold" FontFamily="Consolas"/>
                                    </Grid>
                                </Border>

                                <Border x:Name="HsQrContainer" Background="White" CornerRadius="12" Padding="14" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock x:Name="QrScanLbl" Text="📱 Scan to Connect Fast" Foreground="#0F172A" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                                        <Image x:Name="HsQrImage" Width="130" Height="130" Stretch="Uniform"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="HsClientsContainer" Visibility="Collapsed" Style="{StaticResource ElevatedPanelCard}" Padding="14,12" Margin="0,0,0,15"
                                        Cursor="Hand" MouseEnter="HsClientsContainer_MouseEnter" MouseLeave="HsClientsContainer_MouseLeave">
                                    <Grid>
                                        <TextBlock x:Name="HsClientsCountText" Text="Connected Devices: 0" Foreground="{DynamicResource TextBrush}" FontSize="12" HorizontalAlignment="Center"/>
                                        <Popup x:Name="HsClientsPopup" PlacementTarget="{Binding ElementName=HsClientsContainer}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Width="300">
                                                <TextBox x:Name="HsClientsTextBox" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="130" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" FontFamily="Consolas" FontSize="11" Padding="6"/>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ================= 4. TOOLBOX PANEL ================= -->
                        <Grid x:Name="ToolboxPanel" Visibility="Collapsed">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="ToolsTransform"/>
                            </Grid.RenderTransform>

                            <!-- VIEW 1: REGULAR TOOLBOX HOME VIEW -->
                            <DockPanel x:Name="ToolboxHomeView" LastChildFill="True" Visibility="Visible">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="ToolboxBackHomeBtn" Style="{StaticResource ActionBtn}" Click="SidebarNavDashboard_Click"
                                                Width="32" Height="32" Padding="0" Margin="0,0,8,0" ToolTip="بازگشت به داشبورد" Cursor="Hand">
                                            <TextBlock Text="⌂" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                        <TextBlock x:Name="ToolboxTitle" Text="🧰 ابزارهای شبکه (Network Toolbox)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                
                                <Button DockPanel.Dock="Top" x:Name="SpeedTestBtn" Style="{StaticResource ToolTile}" Click="SpeedTest_Click" Margin="0,0,0,6" Height="36" Padding="12,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🚀" FontSize="15" Foreground="#22C55E" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SpeedTestLbl" Text="Run Connection Speed Test" FontSize="12" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                                    </StackPanel>
                                </Button>

                                <UniformGrid DockPanel.Dock="Top" Columns="3" Rows="2" Margin="0,0,0,6">
                                    <Button x:Name="RenewIpBtn" Style="{StaticResource ToolTile}" Height="36" Padding="6,0" Margin="2" Click="RenewIp_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="🔄" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="RenewIpLbl" Text="Renew IP" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="FlushDnsBtn" Style="{StaticResource ToolTile}" Height="36" Padding="6,0" Margin="2" Click="FlushDns_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="🧹" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="FlushDnsLbl" Text="Flush DNS" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ProxyOffBtn" Style="{StaticResource ToolTile}" Height="36" Padding="6,0" Margin="2" Click="ProxyOff_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="🚫" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="DisableProxyLbl" Text="Disable Proxy" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="KillProcBtn" Style="{StaticResource ToolTile}" Height="36" Padding="6,0" Margin="2" Click="KillProc_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="⛔" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="KillProcLbl" Text="Kill Frozen Procs" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="DnsLeakTestBtn" Style="{StaticResource ToolTile}" Height="36" Padding="6,0" Margin="2" Click="DnsLeakTest_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="🧪" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="DnsLeakLbl" Text="DNS Leak Test" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ResetAdapterBtn" Style="{StaticResource ToolTile}" Height="36" Padding="6,0" Margin="2" Click="ResetAdapter_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="🔁" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="ResetAdapterLbl" Text="Reset Adapter" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>

                                <TextBlock DockPanel.Dock="Top" x:Name="PingTraceLbl" Text="🏓 Ping &amp; Traceroute" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,2,0,4"/>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="ToolTargetBox" Height="30" FontFamily="Consolas" FontSize="11.5" VerticalContentAlignment="Center" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="8,0"/>
                                    <Button Grid.Column="2" x:Name="PingToggleBtn" Content="🏓 Start Ping" Style="{StaticResource ActionBtn}" Height="30" Padding="10,0" FontSize="11" FontWeight="SemiBold" Click="PingToggle_Click"/>
                                    <Button Grid.Column="4" x:Name="TracerouteToggleBtn" Content="🛰 Traceroute" Style="{StaticResource ActionBtn}" Height="30" Padding="10,0" FontSize="11" FontWeight="SemiBold" Click="TracerouteToggle_Click"/>
                                </Grid>

                                <Grid DockPanel.Dock="Top" Margin="0,2,0,4">
                                    <TextBlock x:Name="LogSectionLbl" Text="📡 لاگ ابزارها و پینگ/تریس (Diagnostics Log)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="CopyLogBtn" Content="📋 کپی لاگ" Style="{StaticResource ActionBtn}" Height="28" Padding="8,0" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,4,0" Click="CopyLog_Click"/>
                                        <Button x:Name="OpenLogFileBtn" Content="📂 فایل لاگ" Style="{StaticResource ActionBtn}" Height="28" Padding="8,0" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,4,0" Click="OpenLogFile_Click"/>
                                        <Button x:Name="ClearLogBtn" Content="🗑 پاک‌سازی" Style="{StaticResource ActionBtn}" Height="28" Padding="8,0" FontSize="10.5" FontWeight="SemiBold" Click="ClearLog_Click"/>
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource ElevatedPanelCard}" Padding="4">
                                    <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11.5" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" Padding="6"/>
                                </Border>
                            </DockPanel>

                            <!-- VIEW 2: IN-PLACE SPEED TEST VIEW (COMPACT FIT-TO-PAGE) -->
                            <DockPanel x:Name="ToolboxSpeedTestView" Visibility="Collapsed" LastChildFill="True">
                                <!-- Top Bar with Back Button, Title, and Engine Selector -->
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0">
                                        <Button x:Name="SpeedTestHomeBtn" Style="{StaticResource ActionBtn}" Padding="8,4" Margin="0,0,6,0" Click="SidebarNavDashboard_Click" ToolTip="بازگشت به داشبورد">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⌂" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="داشبورد" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="SpeedTestBackBtn" Style="{StaticResource ActionBtn}" Padding="8,4" Click="SpeedTestBack_Click" ToolTip="بازگشت به ابزارها">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="←" FontSize="13" FontWeight="Bold" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="ابزارها" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="🚀 تست سرعت اتصال" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="سنجش زنده پینگ، جیتر، سرعت دانلود و آپلود" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="موتور:" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="SpeedEngineCombo" MinWidth="135" Height="26" FontSize="10.5" VerticalAlignment="Center" SelectionChanged="SpeedEngineCombo_SelectionChanged">
                                            <ComboBoxItem Content="Speedtest.net (Ookla)"/>
                                            <ComboBoxItem Content="Cloudflare"/>
                                            <ComboBoxItem Content="M-Lab (NDT7)"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="0">
                                        <!-- Dual Telemetry Cards: Client IP/Loc & Server IP/Loc -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Card 1: Your Client IP & Location -->
                                            <Border Grid.Column="0" Style="{StaticResource ElevatedPanelCard}" Padding="10,8" Cursor="Hand" ToolTip="موقعیت و آی‌پی شما (برای بروزرسانی کلیک کنید)" MouseLeftButtonUp="SpeedClientCard_Click">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="7" Background="#183B82F6" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <Ellipse x:Name="SpeedViaDot" Width="8" Height="8" Fill="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📍 اتصال: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}"/>
                                                            <TextBlock x:Name="SpeedViaText" Text="Direct Internet" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <TextBlock x:Name="SpeedClientIpText" Text="در حال شناسایی..." FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,1,0,0" FontFamily="Consolas"/>
                                                        <TextBlock x:Name="SpeedClientLocText" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Card 2: Test Server Target IP & Location -->
                                            <Border Grid.Column="2" Style="{StaticResource ElevatedPanelCard}" Padding="10,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="7" Background="#1822C55E" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="🎯" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="سرور مقصد تست (Test Server)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}"/>
                                                        <TextBlock x:Name="SpeedServerNameText" Text="در حال انتخاب سرور..." FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock x:Name="SpeedServerLocText" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <!-- Vector Speedometer Gauge Card -->
                                        <Border Style="{StaticResource ElevatedPanelCard}" Padding="10,8" Margin="0,0,0,8">
                                            <StackPanel>
                                                <Viewbox Width="165" Height="80" FlowDirection="LeftToRight" HorizontalAlignment="Center">
                                                    <Canvas Width="200" Height="116">
                                                        <Path Data="M 20,100 A 80,80 0 0 1 180,100" Stroke="{DynamicResource LineBrush}"
                                                              StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                        <Path x:Name="SpeedGaugeValueArc" Data="M 20,100 A 80,80 0 0 1 180,100" Stroke="{DynamicResource AccentBrush}"
                                                              StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              StrokeDashArray="0 1000"/>
                                                        <TextBlock Canvas.Left="10" Canvas.Top="103" Text="0" FontSize="8" Foreground="#64748B"/>
                                                        <TextBlock Canvas.Left="29" Canvas.Top="42" Text="12" FontSize="8" Foreground="#64748B"/>
                                                        <TextBlock Canvas.Left="94" Canvas.Top="7" Text="25" FontSize="8" Foreground="#64748B"/>
                                                        <TextBlock Canvas.Left="160" Canvas.Top="42" Text="38" FontSize="8" Foreground="#64748B"/>
                                                        <TextBlock Canvas.Left="177" Canvas.Top="103" Text="50+" FontSize="8" Foreground="#64748B"/>
                                                        <Line x:Name="SpeedNeedle" X1="100" Y1="100" X2="100" Y2="36"
                                                              Stroke="#F8FAFC" StrokeThickness="3"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                                            <Line.RenderTransform>
                                                                <RotateTransform x:Name="SpeedNeedleRotate" CenterX="100" CenterY="100" Angle="-90"/>
                                                            </Line.RenderTransform>
                                                        </Line>
                                                        <Ellipse Canvas.Left="93" Canvas.Top="93" Width="14" Height="14" Fill="{DynamicResource AccentBrush}"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Center" Margin="0,1,0,0">
                                                    <TextBlock x:Name="SpeedGaugeArrow" Text="" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,1" Visibility="Collapsed"/>
                                                    <TextBlock x:Name="SpeedGaugeNumText" Text="0.0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                                    <TextBlock Text="Mbps" FontWeight="SemiBold" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Bottom" Margin="5,0,0,3"/>
                                                </StackPanel>
                                                <TextBlock x:Name="SpeedPhaseText" Text="آماده شروع تست" FontSize="11" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- 4 Metric Cards -->
                                        <UniformGrid Columns="4" Margin="0,0,0,6">
                                            <Border Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4,4" Margin="0,0,3,0">
                                                <StackPanel>
                                                    <TextBlock Text="پینگ" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="SpeedPingVal" Text="—" FontSize="12.5" FontWeight="Bold" FlowDirection="LeftToRight" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,1,0,1"/>
                                                    <Border x:Name="SpeedPingChip" CornerRadius="4" Padding="5,1" HorizontalAlignment="Center" Visibility="Collapsed" Background="#2622C55E">
                                                        <TextBlock x:Name="SpeedPingChipText" Text="" FontSize="8" FontWeight="Bold" Foreground="#22C55E"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4,4" Margin="2,0,2,0">
                                                <StackPanel>
                                                    <TextBlock Text="جیتر" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="SpeedJitterVal" Text="—" FontSize="12.5" FontWeight="Bold" FlowDirection="LeftToRight" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,1,0,1"/>
                                                    <Border x:Name="SpeedJitterChip" CornerRadius="4" Padding="5,1" HorizontalAlignment="Center" Visibility="Collapsed" Background="#2622C55E">
                                                        <TextBlock x:Name="SpeedJitterChipText" Text="" FontSize="8" FontWeight="Bold" Foreground="#22C55E"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4,4" Margin="2,0,2,0">
                                                <StackPanel>
                                                    <TextBlock Text="دانلود" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="SpeedDlVal" Text="—" FontSize="12.5" FontWeight="Bold" FlowDirection="LeftToRight" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,1,0,1"/>
                                                    <Border x:Name="SpeedDlChip" CornerRadius="4" Padding="5,1" HorizontalAlignment="Center" Visibility="Collapsed" Background="#2622C55E">
                                                        <TextBlock x:Name="SpeedDlChipText" Text="" FontSize="8" FontWeight="Bold" Foreground="#22C55E"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4,4" Margin="3,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="آپلود" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="SpeedUlVal" Text="—" FontSize="12.5" FontWeight="Bold" FlowDirection="LeftToRight" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,1,0,1"/>
                                                    <Border x:Name="SpeedUlChip" CornerRadius="4" Padding="5,1" HorizontalAlignment="Center" Visibility="Collapsed" Background="#2622C55E">
                                                        <TextBlock x:Name="SpeedUlChipText" Text="" FontSize="8" FontWeight="Bold" Foreground="#22C55E"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <!-- Progress bar -->
                                        <Border x:Name="SpeedProgressTrack" Height="4" CornerRadius="2" Background="{DynamicResource FieldBrush}" Margin="0,0,0,6">
                                            <Border x:Name="SpeedProgressFill" Width="0" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource AccentBrush}"/>
                                        </Border>

                                        <!-- Action buttons -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" x:Name="SpeedBtnAll" Content="⚡ تست کامل (Full Test)" Style="{StaticResource PrimaryActionBtn}" Height="32" FontSize="11" FontWeight="SemiBold" Click="SpeedAll_Click"/>
                                            <Button Grid.Column="2" x:Name="SpeedBtnDl" Content="⬇ فقط دانلود" Style="{StaticResource ActionBtn}" Height="32" FontSize="10.5" Click="SpeedDl_Click"/>
                                            <Button Grid.Column="4" x:Name="SpeedBtnUl" Content="⬆ فقط آپلود" Style="{StaticResource ActionBtn}" Height="32" FontSize="10.5" Click="SpeedUl_Click"/>
                                            <Button Grid.Column="6" x:Name="SpeedBtnStop" Content="⏹ توقف" Style="{StaticResource ActionBtn}" Height="32" FontSize="10.5" Padding="12,0" Click="SpeedStop_Click"/>
                                        </Grid>

                                        <TextBlock x:Name="SpeedWarnText" Text="⚠️ هر فاز حداکثر تا ۱۰ ثانیه اجرا می‌شود و از حجم اشتراک استفاده می‌کند." FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>

                        <!-- ================= 5. SETTINGS PANEL ================= -->
                        <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.RenderTransform>
                                <TranslateTransform x:Name="SettingsTransform"/>
                            </ScrollViewer.RenderTransform>
                            <StackPanel Margin="2,0">
                                <Grid Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="SettingsBackHomeBtn" Style="{StaticResource ActionBtn}" Click="SidebarNavDashboard_Click"
                                                Height="32" Padding="10,4" Margin="0,0,10,0" ToolTip="بازگشت به داشبورد" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="⌂" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="داشبورد" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Text="⚙ تنظیمات و پیکربندی (Settings)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <Expander x:Name="AppearanceExpander" Header="🎨 Appearance &amp; Language" IsExpanded="True" Margin="0,0,0,10" Padding="10" Foreground="{DynamicResource TextBrush}">
                                    <StackPanel Margin="4,10,4,4">
                                        <TextBlock x:Name="LangLabel" Text="Language" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="LangFaRb" GroupName="Language" Content="فارسی" Margin="0,0,16,0" Checked="LangRb_Click"/>
                                            <RadioButton x:Name="LangEnRb" GroupName="Language" Content="English" Checked="LangRb_Click"/>
                                        </StackPanel>
                                        <TextBlock x:Name="ThemeLabel" Text="Theme" Foreground="{DynamicResource SubTextBrush}" Margin="0,14,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="ThemeDarkRb" GroupName="Theme" Content="Dark" Margin="0,0,16,0" Checked="ThemeRb_Click"/>
                                            <RadioButton x:Name="ThemeLightRb" GroupName="Theme" Content="Light" Margin="0,0,16,0" Checked="ThemeRb_Click"/>
                                            <RadioButton x:Name="ThemeSystemRb" GroupName="Theme" Content="System" Checked="ThemeRb_Click"/>
                                        </StackPanel>
                                        <TextBlock x:Name="FontLabel" Text="Application font" Foreground="{DynamicResource SubTextBrush}" Margin="0,14,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="FontSegoeRb" GroupName="FontChoice" Content="Inter / Segoe UI (مدرن)" Margin="0,0,16,0" IsChecked="True" Checked="FontRb_Click"/>
                                            <RadioButton x:Name="FontVazirRb" GroupName="FontChoice" Content="Vazirmatn (وزیرمتن)" Checked="FontRb_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>

                                <Expander x:Name="DashboardExpander" Header="📊 Dashboard &amp; Sidebar" Margin="0,0,0,10" Padding="10" Foreground="{DynamicResource TextBrush}">
                                    <StackPanel Margin="4,10,4,4">
                                        <TextBlock Text="تایل پایینی داشبورد (Bottom Dashboard Slot):" Foreground="{DynamicResource SubTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <RadioButton x:Name="DashWidgetRecentRb" GroupName="DashWidgetChoice" Content="⭐ سرورهای اخیر" Margin="0,0,14,0" Checked="DashWidgetChoice_Click"/>
                                            <RadioButton x:Name="DashWidgetSecurityRb" GroupName="DashWidgetChoice" Content="🛡️ کنترل‌های امنیت" Margin="0,0,14,0" Checked="DashWidgetChoice_Click"/>
                                            <RadioButton x:Name="DashWidgetToolsRb" GroupName="DashWidgetChoice" Content="🧰 ابزارهای شبکه" Checked="DashWidgetChoice_Click"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ShowRecentServersToggle" Content="نمایش سرورهای اخیر در داشبورد" Checked="ShowRecentServersToggle_Changed" Unchecked="ShowRecentServersToggle_Changed"/>
                                        <CheckBox x:Name="SidebarDefaultOpenToggle" Content="سایدبار منو به صورت باز پیش‌فرض" Checked="SidebarDefaultOpenToggle_Changed" Unchecked="SidebarDefaultOpenToggle_Changed" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Expander>

                                <Expander x:Name="BehaviorExpander" Header="⚙ Connection Behavior" Margin="0,0,0,10" Padding="10" Foreground="{DynamicResource TextBrush}">
                                    <StackPanel Margin="4,10,4,4">
                                        <CheckBox x:Name="SmartToggle" Content="Smart Connect (Auto try all servers)" Checked="SmartToggle_Changed" Unchecked="SmartToggle_Changed"/>
                                        <CheckBox x:Name="TrayToggle" Content="Minimize to tray instead of closing" Checked="TrayToggle_Changed" Unchecked="TrayToggle_Changed" Margin="0,6,0,0"/>
                                        <CheckBox x:Name="KillSwitchToggle" Content="Kill Switch (Block internet if VPN drops)" Checked="KillSwitchToggle_Changed" Unchecked="KillSwitchToggle_Changed" Margin="0,6,0,0"/>
                                        <CheckBox x:Name="StartupToggle" Content="Start with Windows" Checked="StartupToggle_Changed" Unchecked="StartupToggle_Changed" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Expander>

                                <Expander x:Name="IdleExpander" Header="⏱ Idle Auto-Disconnect" Margin="0,0,0,10" Padding="10" Foreground="{DynamicResource TextBrush}">
                                    <StackPanel Margin="4,10,4,4">
                                        <RadioButton x:Name="IdleOffRb" GroupName="IdleMode" Content="Always Connected" Checked="IdleRb_Checked"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <RadioButton x:Name="IdleOnRb" GroupName="IdleMode" Content="Disconnect after" VerticalAlignment="Center" Checked="IdleRb_Checked"/>
                                            <TextBox x:Name="IdleMinutesBox" Width="52" Height="28" Margin="10,0,8,0" FontFamily="Consolas" FontSize="12" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" LostFocus="IdleMinutes_LostFocus"/>
                                            <TextBlock x:Name="IdleMinutesLabel" Text="minutes idle" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>

                                <Expander x:Name="SplitExpander" Header="🔀 Per-App Split Tunneling (Xray / Proxy)" Margin="0,0,0,10" Padding="10" Foreground="{DynamicResource TextBrush}">
                                    <StackPanel Margin="4,10,4,4">
                                        <RadioButton x:Name="StOffRb" GroupName="StMode" Tag="off" Content="Tunnel Entire System" Checked="StMode_Checked"/>
                                        <RadioButton x:Name="StAllowRb" GroupName="StMode" Tag="allow" Content="Only selected apps (Allow list)" Checked="StMode_Checked" Margin="0,6,0,0"/>
                                        <RadioButton x:Name="StDenyRb" GroupName="StMode" Tag="deny" Content="Bypass selected apps" Checked="StMode_Checked" Margin="0,6,0,0"/>
                                        <Button x:Name="BtnManagePerApp" Content="⚙️ Manage App List" Click="BtnManagePerApp_Click" Style="{StaticResource ActionBtn}" Margin="0,10,0,2"/>
                                    </StackPanel>
                                </Expander>

                                <Expander x:Name="DnsExpander" Header="🌐 DNS Servers" Margin="0,0,0,10" Padding="10" Foreground="{DynamicResource TextBrush}">
                                    <StackPanel Margin="4,10,4,4">
                                        <RadioButton x:Name="DnsAutoRb" GroupName="DnsMode" Tag="auto" Content="Automatic" Checked="DnsRb_Checked"/>
                                        <RadioButton x:Name="DnsCfRb" GroupName="DnsMode" Tag="cloudflare" Content="Cloudflare — 1.1.1.1" Checked="DnsRb_Checked" Margin="0,5,0,0"/>
                                        <RadioButton x:Name="DnsGoogleRb" GroupName="DnsMode" Tag="google" Content="Google — 8.8.8.8" Checked="DnsRb_Checked" Margin="0,5,0,0"/>
                                        <RadioButton x:Name="DnsAdguardRb" GroupName="DnsMode" Tag="adguard" Content="AdGuard — Ad Blocking" Checked="DnsRb_Checked" Margin="0,5,0,0"/>
                                        <RadioButton x:Name="DnsAdguardFamilyRb" GroupName="DnsMode" Tag="adguard_family" Content="AdGuard Family" Checked="DnsRb_Checked" Margin="0,5,0,0"/>
                                        <RadioButton x:Name="DnsCustomRb" GroupName="DnsMode" Tag="custom" Content="Custom DNS" Checked="DnsRb_Checked" Margin="0,5,0,0"/>
                                        <Grid Margin="0,8,0,2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="DnsPrimaryBox" Height="30" FontFamily="Consolas" FontSize="12" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" LostFocus="DnsBox_LostFocus"/>
                                            <TextBox Grid.Column="2" x:Name="DnsSecondaryBox" Height="30" FontFamily="Consolas" FontSize="12" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" LostFocus="DnsBox_LostFocus"/>
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <Expander x:Name="PackageExpander" Header="📦 Package &amp; About" Margin="0,0,0,10" Padding="10" Foreground="{DynamicResource TextBrush}">
                                    <StackPanel Margin="4,10,4,4">
                                        <Button x:Name="UpdateBaseBtn" Content="🔧 Update base.ovpn" Style="{StaticResource ActionBtn}" Margin="0,4" Click="UpdateBase_Click"/>
                                        <Button x:Name="ImportBtn" Content="📥 Import OVPN / Package" Style="{StaticResource ActionBtn}" Margin="0,4" Click="Import_Click"/>
                                        <Button x:Name="ExportBtn" Content="📤 Export Connections" Style="{StaticResource ActionBtn}" Margin="0,4" Click="Export_Click"/>
                                        <Button x:Name="AboutBtn" Content="ℹ About &amp; Support" Style="{StaticResource ActionBtn}" Margin="0,10,0,4" Click="About_Click"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ================= 6. CONNECTION LOGS PANEL ================= -->
                        <Grid x:Name="ConnLogPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="ConnLogTransform"/>
                            </Grid.RenderTransform>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="ConnLogBackHomeBtn" Style="{StaticResource ActionBtn}" Click="SidebarNavDashboard_Click"
                                            Height="32" Padding="10,4" Margin="0,0,10,0" ToolTip="بازگشت به داشبورد" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⌂" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="داشبورد" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="ConnLogSectionLbl" Text="📶 لاگ سیستم و کانکشن‌ها" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="CopyConnLogBtn" Content="📋 کپی لاگ" Style="{StaticResource ActionBtn}" Margin="0,0,6,0" Padding="8,3" Click="CopyConnLog_Click"/>
                                    <Button x:Name="OpenConnLogFileBtn" Content="📂 فایل لاگ" Style="{StaticResource ActionBtn}" Margin="0,0,6,0" Padding="8,3" Click="OpenLogFile_Click"/>
                                    <Button x:Name="ClearConnLogBtn" Content="🗑 پاک‌سازی" Style="{StaticResource ActionBtn}" Padding="8,3" Click="ClearConnLog_Click"/>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1" Style="{StaticResource ElevatedPanelCard}" Padding="6">
                                <TextBox x:Name="ConnLogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" Padding="6"/>
                            </Border>
                        </Grid>

                    </Grid>
                </Grid>

                <!-- ================= MINI WIDGET ================= -->
                <Border x:Name="MiniWidget" Visibility="Collapsed" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="8">
                    <Border.ContextMenu>
                        <ContextMenu><MenuItem x:Name="MiniAlwaysOnTopMenuItem" Header="Always on Top" IsCheckable="True" Click="MiniAlwaysOnTop_Click"/></ContextMenu>
                    </Border.ContextMenu>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="MiniPowerBtn" Width="44" Height="44" Background="#334155" Cursor="Hand" Click="Power_Click">
                            <Button.Effect><DropShadowEffect x:Name="MiniPowerGlow" Color="#22C55E" BlurRadius="12" Opacity="0"/></Button.Effect>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="22">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Path Width="20" Height="20" Stretch="Uniform" Data="M 12,2.5 L 12,11.5 M 7.05,5.6 A 8.5,8.5 0 1 0 16.95,5.6" Stroke="White" StrokeThickness="2"/>
                        </Button>
                        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="MiniStatusDot" Width="7" Height="7" Fill="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="MiniStatusText" Text="Ready" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="MiniConnectionText" Text="—" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0"/>
                            <TextBlock x:Name="MiniSpeedText" Text="↓ 0 B/s   ↑ 0 B/s" FontWeight="SemiBold" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" x:Name="MiniRestoreBtn" Width="42" Height="42" Background="{DynamicResource AccentBrush}" Cursor="Hand" Click="MiniRestoreBtn_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="⤢" FontSize="19" Foreground="White"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- DRAWER OVERLAY (Preserved) -->
            <Grid x:Name="DrawerOverlay" Grid.RowSpan="2" Background="#80000000" Visibility="Collapsed" Panel.ZIndex="999" MouseLeftButtonDown="DrawerOverlay_MouseLeftButtonDown">
                <Border x:Name="DrawerMenuPanel" HorizontalAlignment="Left" Width="260" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,1,0" MouseLeftButtonDown="DrawerMenuPanel_MouseLeftButtonDown">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="20,20,20,10">
                            <TextBlock x:Name="DrawerTitleText" Text="Main Menu" Foreground="{DynamicResource TextBrush}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="DrawerClose_Click">
                                <Path Data="M18 6L6 18M6 6l12 12" Stroke="#94A3B8" StrokeThickness="2" Stretch="Uniform" Width="14" Height="14"/>
                            </Button>
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="10,20,10,10">
                            <Button Style="{StaticResource DrawerNavBtn}" Click="HotspotNavHome_Click"><TextBlock x:Name="DrawerNavHomeText" Text="🏠 Dashboard" Foreground="{DynamicResource TextBrush}"/></Button>
                            <Button Style="{StaticResource DrawerNavBtn}" Margin="0,5,0,0" Click="HotspotNavXray_Click"><TextBlock x:Name="DrawerNavXrayText" Text="🚀 Xray Service" Foreground="{DynamicResource TextBrush}"/></Button>
                            <Button Style="{StaticResource DrawerNavBtn}" Margin="0,5,0,0" Click="HotspotNavLogs_Click"><TextBlock x:Name="DrawerNavLogsText" Text="📄 Connection Logs" Foreground="{DynamicResource TextBrush}"/></Button>
                            <Button Style="{StaticResource DrawerNavBtn}" Margin="0,5,0,0" Click="OpenHotspotWindow_Click"><TextBlock x:Name="DrawerNavHotspotText" Text="📶 VPN Wi-Fi Direct" Foreground="{DynamicResource TextBrush}"/></Button>
                            <Button Style="{StaticResource DrawerNavBtn}" Margin="0,5,0,0" Click="HotspotNavTools_Click"><TextBlock x:Name="DrawerNavToolsText" Text="🧰 Toolbox" Foreground="{DynamicResource TextBrush}"/></Button>
                            <Button Style="{StaticResource DrawerNavBtn}" Margin="0,5,0,0" Click="HotspotNavSettings_Click"><TextBlock x:Name="DrawerNavSettingsText" Text="⚙ Settings" Foreground="{DynamicResource TextBrush}"/></Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- IN-APP VPN URL IMPORT MODAL OVERLAY -->
            <Grid x:Name="VpnUrlImportOverlay" Grid.RowSpan="2" Background="#B0000000" Visibility="Collapsed" Panel.ZIndex="998" MouseLeftButtonDown="VpnUrlImportOverlay_MouseLeftButtonDown">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="380" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20,18" MouseLeftButtonDown="VpnUrlImportModal_MouseLeftButtonDown">
                    <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#000000" Opacity="0.7"/></Border.Effect>
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock x:Name="VpnUrlImportTitleText" Text="🌐 دریافت کانکشن OpenVPN از لینک" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="VpnUrlImportCancel_Click">
                                <Path Data="M18 6L6 18M6 6l12 12" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="2" Stretch="Uniform" Width="12" Height="12"/>
                            </Button>
                        </Grid>
                        <TextBlock Text="نام کانکشن (اختیاری):" Foreground="{DynamicResource SubTextBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="VpnUrlImportNameInput" Height="34" Padding="8,6" Margin="0,0,0,10" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" FontSize="11.5" VerticalContentAlignment="Center"/>
                        <TextBlock Text="لینک مستقیم فایل کانفیگ (.ovpn):" Foreground="{DynamicResource SubTextBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="VpnUrlImportUrlInput" Grid.Column="0" Height="34" Padding="8,6" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" FontSize="11.5" VerticalContentAlignment="Center" KeyDown="VpnUrlImportUrlInput_KeyDown"/>
                            <Button Grid.Column="1" Content="📋 Paste" Style="{StaticResource ActionBtn}" Padding="10,0" Height="34" Margin="6,0,0,0" FontSize="11" Click="VpnUrlImportPaste_Click"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="VpnUrlImportSubmitBtn" Content="دریافت و بارگذاری" Style="{StaticResource PrimaryActionBtn}" Height="36" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0" Click="VpnUrlImportSubmit_Click"/>
                            <Button Grid.Column="1" Content="انصراف" Style="{StaticResource ActionBtn}" Height="36" FontSize="12" Margin="6,0,0,0" Click="VpnUrlImportCancel_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- IN-APP SUB INPUT MODAL OVERLAY -->
            <Grid x:Name="XraySubOverlay" Grid.RowSpan="2" Background="#B0000000" Visibility="Collapsed" Panel.ZIndex="998" MouseLeftButtonDown="XraySubOverlay_MouseLeftButtonDown">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="360" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20,18" MouseLeftButtonDown="XraySubModal_MouseLeftButtonDown">
                    <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#000000" Opacity="0.7"/></Border.Effect>
                    <StackPanel x:Name="XraySubModalStack">
                        <Grid Margin="0,0,0,14">
                            <TextBlock x:Name="XraySubTitleText" Text="🔗 Add Xray Subscription Link" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="XraySubCancel_Click">
                                <Path Data="M18 6L6 18M6 6l12 12" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="2" Stretch="Uniform" Width="12" Height="12"/>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="XraySubNameHintText" Text="Subscription / Group Name (Optional):" Foreground="{DynamicResource SubTextBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="XraySubNameInput" Height="34" Padding="8,6" Margin="0,0,0,10" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" FontSize="11.5" VerticalContentAlignment="Center"/>
                        <TextBlock x:Name="XraySubHintText" Text="Enter subscription link or node URL:" Foreground="{DynamicResource SubTextBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="XraySubUrlInput" Grid.Column="0" Height="34" Padding="8,6" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" FontSize="11.5" VerticalContentAlignment="Center" KeyDown="XraySubUrlInput_KeyDown"/>
                            <Button Grid.Column="1" x:Name="XraySubPasteBtn" Content="📋 Paste" Style="{StaticResource ActionBtn}" Padding="10,0" Height="34" Margin="6,0,0,0" FontSize="11" Click="XraySubPaste_Click"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="XraySubSubmitBtn" Content="Save &amp; Import" Style="{StaticResource PrimaryActionBtn}" Height="36" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0" Click="XraySubSubmit_Click"/>
                            <Button Grid.Column="1" x:Name="XraySubCancelBtn" Content="Cancel" Style="{StaticResource ActionBtn}" Height="36" FontSize="12" Margin="6,0,0,0" Click="XraySubCancel_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- IN-APP SHARE MODAL OVERLAY -->
            <Grid x:Name="XrayShareOverlay" Grid.RowSpan="2" Background="#B0000000" Visibility="Collapsed" Panel.ZIndex="998" MouseLeftButtonDown="XrayShareOverlay_MouseLeftButtonDown">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="340" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20,18" MouseLeftButtonDown="XrayShareModal_MouseLeftButtonDown">
                    <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#000000" Opacity="0.7"/></Border.Effect>
                    <StackPanel x:Name="XrayShareModalStack">
                        <Grid Margin="0,0,0,12">
                            <TextBlock x:Name="XrayShareTitleText" Text="📱 Share Connection" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="XrayShareClose_Click">
                                <Path Data="M18 6L6 18M6 6l12 12" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="2" Stretch="Uniform" Width="12" Height="12"/>
                            </Button>
                        </Grid>
                        <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <Border Background="#1E293B" CornerRadius="4" Padding="5,1" Margin="0,0,6,0"><TextBlock x:Name="XrayShareProtoBadge" Text="VLESS" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/></Border>
                                    <TextBlock x:Name="XrayShareAliasText" Text="Server Name" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                                <TextBlock x:Name="XrayShareAddressText" Text="1.2.3.4:443" FontWeight="SemiBold" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="10" Padding="10" Margin="0,0,0,12" HorizontalAlignment="Center">
                            <Image x:Name="XrayShareQrImage" Width="150" Height="150" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Border>
                        <TextBlock x:Name="XrayShareHintText" Text="Scan with camera or mobile VPN app" Foreground="{DynamicResource SubTextBrush}" FontWeight="SemiBold" FontSize="10.5" TextAlignment="Center" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="XrayShareCopyBtn" Content="📋 Copy Link" Style="{StaticResource PrimaryActionBtn}" Height="34" FontSize="12" Margin="0,0,6,0" Click="XrayShareCopyBtn_Click"/>
                            <Button Grid.Column="1" x:Name="XrayShareCloseBtn" Content="Close" Style="{StaticResource ActionBtn}" Height="34" Padding="14,0" FontSize="12" Click="XrayShareClose_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- IN-APP MESSAGE MODAL OVERLAY -->
            <Grid x:Name="InAppMessageOverlay" Grid.RowSpan="2" Background="#B0000000" Visibility="Collapsed" Panel.ZIndex="1000" MouseLeftButtonDown="InAppMsgOverlay_Dismiss">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="330" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20,18" MouseLeftButtonDown="InAppMsgBox_MouseLeftButtonDown">
                    <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#000000" Opacity="0.7"/></Border.Effect>
                    <StackPanel x:Name="InAppMessageModalStack">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock x:Name="InAppMsgIcon" Text="ℹ" FontSize="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="InAppMsgTitle" Text="System Message" Foreground="{DynamicResource TextBrush}" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="InAppMsgText" Text="Message" Foreground="{DynamicResource SubTextBrush}" FontSize="12" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,16"/>
                        <Button x:Name="InAppMsgOkBtn" Content="OK" Style="{StaticResource PrimaryActionBtn}" Height="34" Width="100" HorizontalAlignment="Center" FontSize="12" Click="InAppMsgOverlay_Dismiss"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- IN-APP MANUAL XRAY ADD MODAL OVERLAY -->
            <Grid x:Name="XrayManualAddOverlay" Grid.RowSpan="2" Background="#B0000000" Visibility="Collapsed" Panel.ZIndex="1000" MouseLeftButtonDown="XrayManualAddOverlay_MouseLeftButtonDown">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="430" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20,18" MouseLeftButtonDown="XrayManualAddModal_MouseLeftButtonDown">
                    <Border.Effect><DropShadowEffect BlurRadius="35" ShadowDepth="0" Color="#000000" Opacity="0.75"/></Border.Effect>
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="XrayManualAddTitle" Text="افزودن دستی کانفیگ Xray" Foreground="{DynamicResource TextBrush}" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="XrayManualCancel_Click">
                                <Path Data="M18 6L6 18M6 6l12 12" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="2" Stretch="Uniform" Width="12" Height="12"/>
                            </Button>
                        </Grid>

                        <!-- Row 1: Alias Name & Protocol -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="نام سرور (Alias):" Foreground="{DynamicResource SubTextBrush}" FontWeight="SemiBold" FontSize="10.5" Margin="0,0,0,3"/>
                                <TextBox x:Name="XrayManualNameInput" Height="30" Padding="8,4" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" FontSize="11" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="پروتکل:" Foreground="{DynamicResource SubTextBrush}" FontWeight="SemiBold" FontSize="10.5" Margin="0,0,0,3"/>
                                <ComboBox x:Name="XrayManualProtoCombo" Height="30" FontSize="11" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" SelectedIndex="0">
                                    <ComboBoxItem Content="VLESS"/>
                                    <ComboBoxItem Content="VMess"/>
                                    <ComboBoxItem Content="Trojan"/>
                                    <ComboBoxItem Content="Shadowsocks"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Address & Port -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="آدرس سرور / هاست:" Foreground="{DynamicResource SubTextBrush}" FontWeight="SemiBold" FontSize="10.5" Margin="0,0,0,3"/>
                                <TextBox x:Name="XrayManualAddressInput" Height="30" Padding="8,4" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" FontSize="11" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="پورت:" Foreground="{DynamicResource SubTextBrush}" FontWeight="SemiBold" FontSize="10.5" Margin="0,0,0,3"/>
                                <TextBox x:Name="XrayManualPortInput" Text="443" Height="30" Padding="8,4" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" FontSize="11" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 3: UUID / Password -->
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="UUID / رمز عبور (Password):" Foreground="{DynamicResource SubTextBrush}" FontWeight="SemiBold" FontSize="10.5" Margin="0,0,0,3"/>
                            <TextBox x:Name="XrayManualUuidInput" Height="30" Padding="8,4" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" FontSize="11" FontFamily="Consolas" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Row 4: Transport & SNI & Path -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="نوع انتقال:" Foreground="{DynamicResource SubTextBrush}" FontWeight="SemiBold" FontSize="10.5" Margin="0,0,0,3"/>
                                <ComboBox x:Name="XrayManualTransportCombo" Height="30" FontSize="11" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" SelectedIndex="0">
                                    <ComboBoxItem Content="ws"/>
                                    <ComboBoxItem Content="tcp"/>
                                    <ComboBoxItem Content="grpc"/>
                                    <ComboBoxItem Content="httpupgrade"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SNI / هاست جعلی:" Foreground="{DynamicResource SubTextBrush}" FontWeight="SemiBold" FontSize="10.5" Margin="0,0,0,3"/>
                                <TextBox x:Name="XrayManualSniInput" Height="30" Padding="8,4" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" FontSize="11" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="مسیر (Path):" Foreground="{DynamicResource SubTextBrush}" FontWeight="SemiBold" FontSize="10.5" Margin="0,0,0,3"/>
                                <TextBox x:Name="XrayManualPathInput" Text="/" Height="30" Padding="8,4" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" FontSize="11" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Action Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="XrayManualSubmitBtn" Content="✓ افزودن و ذخیره" Style="{StaticResource PrimaryActionBtn}" Height="36" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0" Click="XrayManualSubmit_Click"/>
                            <Button Grid.Column="1" x:Name="XrayManualCancelBtn" Content="انصراف" Style="{StaticResource ActionBtn}" Height="36" FontSize="12" Margin="6,0,0,0" Click="XrayManualCancel_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- SLEEK FROSTED EXIT & NETWORK CLEANUP MODAL OVERLAY -->
            <Grid x:Name="AppExitOverlay" Grid.RowSpan="2" Background="#C0000000" Visibility="Collapsed" Panel.ZIndex="1001" MouseLeftButtonDown="AppExitOverlay_MouseLeftButtonDown">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="390" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="22,20">
                    <Border.Effect><DropShadowEffect BlurRadius="35" ShadowDepth="0" Color="#000000" Opacity="0.8"/></Border.Effect>
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🚪" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ExitModalTitle" Text="خروج از برنامه NETFASTVIP" Foreground="{DynamicResource TextBrush}" FontSize="14.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="ExitModalCancel_Click">
                                <Path Data="M18 6L6 18M6 6l12 12" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="2" Stretch="Uniform" Width="12" Height="12"/>
                            </Button>
                        </Grid>

                        <TextBlock x:Name="ExitModalDesc" Text="آیا از خروج کامل از برنامه اطمینان دارید؟&#x0a;با انتخاب پاکسازی، تمام پروسس‌های VPN و تنظیمات کارت‌های شبکه پاکسازی و به حالت اولیه بازگردانده می‌شوند."
                                   Foreground="{DynamicResource SubTextBrush}" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,18" LineHeight="17"/>

                        <StackPanel>
                            <!-- Option 1: Clean Exit (Recommended) -->
                            <Button x:Name="ExitModalCleanupBtn" Style="{StaticResource PrimaryActionBtn}" Height="38" Margin="0,0,0,8" Click="ExitModalCleanup_Click" ToolTip="بستن تمام سرویس‌ها، ریست آداپتورها و بازگردانی DNS">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🛡️" FontSize="13" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="ExitModalCleanupText" Text="خروج و پاکسازی کامل شبکه" FontSize="11.5" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Option 2: Quick Exit -->
                                <Button Grid.Column="0" x:Name="ExitModalQuickBtn" Content="⚡ خروج سریع" Style="{StaticResource ActionBtn}" Height="34" FontSize="11" Click="ExitModalQuick_Click"/>
                                <!-- Option 3: Cancel -->
                                <Button Grid.Column="2" x:Name="ExitModalCancelBtn" Content="انصراف" Style="{StaticResource ActionBtn}" Height="34" FontSize="11" Click="ExitModalCancel_Click"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- SLEEK FROSTED LANGUAGE RESTART MODAL OVERLAY -->
            <Grid x:Name="LangRestartOverlay" Grid.RowSpan="2" Background="#C0000000" Visibility="Collapsed" Panel.ZIndex="1002" MouseLeftButtonDown="LangRestartOverlay_MouseLeftButtonDown">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="380" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="22,20">
                    <Border.Effect><DropShadowEffect BlurRadius="35" ShadowDepth="0" Color="#000000" Opacity="0.8"/></Border.Effect>
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🌐" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LangModalTitle" Text="تغییر زبان برنامه" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="LangModalCancel_Click">
                                <Path Data="M18 6L6 18M6 6l12 12" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="2" Stretch="Uniform" Width="12" Height="12"/>
                            </Button>
                        </Grid>

                        <TextBlock x:Name="LangModalDesc" Text="برای اعمال کامل زبان جدید و تنظیمات چیدمان، برنامه نیاز به راه‌اندازی مجدد دارد.&#x0a;اکنون راه‌اندازی مجدد شود؟"
                                   Foreground="{DynamicResource SubTextBrush}" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,18" LineHeight="17"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Option 1: Restart Now -->
                            <Button Grid.Column="0" x:Name="LangModalRestartBtn" Content="✓ راه‌اندازی مجدد" Style="{StaticResource PrimaryActionBtn}" Height="36" FontSize="11.5" FontWeight="SemiBold" Click="LangModalRestart_Click"/>
                            <!-- Option 2: Cancel (revert selection) -->
                            <Button Grid.Column="2" x:Name="LangModalCancelBtn" Content="انصراف" Style="{StaticResource ActionBtn}" Height="36" FontSize="11" Click="LangModalCancel_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
