<Window x:Class="SmartVpn.XrayCore.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ویرایش کانکشن" Height="560" Width="470"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        FontFamily="./Fonts/#Vazirmatn, Segoe UI, Tahoma" FontSize="12.5"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>
        <Style x:Key="DlgBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DlgBtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}">
            <!-- مشخصات اصلی -->
            <TabItem Header="مشخصات اصلی">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="نام سرور (Alias):" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" Margin="0,5" Foreground="{DynamicResource SubTextBrush}"/>
                    <TextBox Text="{Binding Alias}" Grid.Row="0" Grid.Column="1" Margin="0,5"/>

                    <TextBlock Text="آدرس سرور:" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" Margin="0,5" Foreground="{DynamicResource SubTextBrush}"/>
                    <TextBox Text="{Binding Address}" Grid.Row="1" Grid.Column="1" Margin="0,5"/>

                    <TextBlock Text="پورت:" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0" Margin="0,5" Foreground="{DynamicResource SubTextBrush}"/>
                    <TextBox Text="{Binding Port}" Grid.Row="2" Grid.Column="1" Margin="0,5"/>

                    <TextBlock Text="شناسه کاربری (UUID):" VerticalAlignment="Center" Grid.Row="3" Grid.Column="0" Margin="0,5" Foreground="{DynamicResource SubTextBrush}"/>
                    <TextBox Text="{Binding UserId}" Grid.Row="3" Grid.Column="1" Margin="0,5"/>

                    <TextBlock Text="Flow:" VerticalAlignment="Center" Grid.Row="4" Grid.Column="0" Margin="0,5" Foreground="{DynamicResource SubTextBrush}"/>
                    <TextBox Text="{Binding Flow}" Grid.Row="4" Grid.Column="1" Margin="0,5"/>
                </Grid>
            </TabItem>
            
            <!-- شبکه و انتقال -->
            <TabItem Header="شبکه و انتقال">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="نوع شبکه (Network):" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" Margin="0,5" Foreground="{DynamicResource SubTextBrush}"/>
                    <ComboBox SelectedValue="{Binding Network}" SelectedValuePath="Content" Grid.Row="0" Grid.Column="1" Margin="0,5">
                        <ComboBoxItem Content="tcp"/>
                        <ComboBoxItem Content="kcp"/>
                        <ComboBoxItem Content="ws"/>
                        <ComboBoxItem Content="http"/>
                        <ComboBoxItem Content="grpc"/>
                    </ComboBox>

                    <TextBlock Text="Host:" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" Margin="0,5" Foreground="{DynamicResource SubTextBrush}"/>
                    <TextBox Text="{Binding Host}" Grid.Row="1" Grid.Column="1" Margin="0,5"/>

                    <TextBlock Text="Path:" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0" Margin="0,5" Foreground="{DynamicResource SubTextBrush}"/>
                    <TextBox Text="{Binding Path}" Grid.Row="2" Grid.Column="1" Margin="0,5"/>
                    
                    <TextBlock Text="gRPC ServiceName:" VerticalAlignment="Center" Grid.Row="3" Grid.Column="0" Margin="0,5" Foreground="{DynamicResource SubTextBrush}"/>
                    <TextBox Text="{Binding ServiceName}" Grid.Row="3" Grid.Column="1" Margin="0,5"/>
                </Grid>
            </TabItem>

            <!-- رمزنگاری و TLS -->
            <TabItem Header="رمزنگاری و TLS">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="نوع TLS:" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" Margin="0,5" Foreground="{DynamicResource SubTextBrush}"/>
                    <ComboBox SelectedValue="{Binding Tls}" SelectedValuePath="Content" Grid.Row="0" Grid.Column="1" Margin="0,5">
                        <ComboBoxItem Content="none"/>
                        <ComboBoxItem Content="tls"/>
                        <ComboBoxItem Content="reality"/>
                    </ComboBox>

                    <TextBlock Text="SNI:" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" Margin="0,5" Foreground="{DynamicResource SubTextBrush}"/>
                    <TextBox Text="{Binding Sni}" Grid.Row="1" Grid.Column="1" Margin="0,5"/>

                    <TextBlock Text="ALPN:" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0" Margin="0,5" Foreground="{DynamicResource SubTextBrush}"/>
                    <TextBox Text="{Binding Alpn}" Grid.Row="2" Grid.Column="1" Margin="0,5"/>

                    <TextBlock Text="Fingerprint:" VerticalAlignment="Center" Grid.Row="3" Grid.Column="0" Margin="0,5" Foreground="{DynamicResource SubTextBrush}"/>
                    <TextBox Text="{Binding Fingerprint}" Grid.Row="3" Grid.Column="1" Margin="0,5"/>

                    <TextBlock Text="Public Key:" VerticalAlignment="Center" Grid.Row="4" Grid.Column="0" Margin="0,5" Foreground="{DynamicResource SubTextBrush}"/>
                    <TextBox Text="{Binding PublicKey}" Grid.Row="4" Grid.Column="1" Margin="0,5"/>
                    
                    <TextBlock Text="Short ID:" VerticalAlignment="Center" Grid.Row="5" Grid.Column="0" Margin="0,5" Foreground="{DynamicResource SubTextBrush}"/>
                    <TextBox Text="{Binding ShortId}" Grid.Row="5" Grid.Column="1" Margin="0,5"/>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
            <Button Content="ذخیره تنظیمات" Style="{StaticResource DlgBtnPrimary}" MinWidth="95" IsDefault="True" Click="OK_Click" Margin="0,0,8,0"/>
            <Button Content="انصراف" Style="{StaticResource DlgBtn}" MinWidth="80" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
