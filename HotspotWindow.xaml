<Window x:Class="SmartVpn.HotspotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="هات‌اسپات هوشمند و ایمن" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" FlowDirection="RightToLeft"
        FontFamily="./Fonts/#Vazirmatn, Vazirmatn, Segoe UI, Tahoma"
        WindowStyle="ToolWindow" Closing="Window_Closing" Loaded="Window_Loaded">
    
    <Window.Resources>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Padding="22,20,22,25">
        <StackPanel>
            <TextBlock Text="اشتراک‌گذاری امن اینترنت (هات‌اسپات)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,5" HorizontalAlignment="Center"/>
            <TextBlock x:Name="VpnStatusBadge" Text="وضعیت VPN: متصل نیست" FontSize="11" Foreground="#EF4444" Margin="0,0,0,15" HorizontalAlignment="Center" FontWeight="Bold"/>

            <TextBlock Text="🌐 کارت شبکه اینترنت (VPN):" Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="0,0,0,5" FontWeight="Bold"/>
            <ComboBox x:Name="SourceCombo" Margin="0,0,0,12" Height="36" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Center" Cursor="Hand"/>

            <TextBlock Text="🎯 کارت شبکه هات‌اسپات (Wi-Fi Direct):" Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="0,0,0,5" FontWeight="Bold"/>
            <ComboBox x:Name="TargetCombo" Margin="0,0,0,18" Height="36" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Center" Cursor="Hand"/>
            

            <Border x:Name="RasWarningBorder" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,15" Visibility="Collapsed">
                <TextBlock Foreground="#B45309" FontSize="11" TextWrapping="Wrap" LineHeight="18" TextAlignment="Justify">
                    <Run Text="توجه:" FontWeight="Bold"/>
                    <Run Text="استفاده از پروتکل‌های ویندوزی (IKEv2, SSTP, L2TP) برای هات‌اسپات پیشنهاد نمی‌شود زیرا ویندوز نمی‌تواند آن‌ها را به صورت خودکار به اشتراک بگذارد و نیازمند تنظیم دستی است. پیشنهاد اکید استفاده از WireGuard است."/>
                </TextBlock>
            </Border>
            <UniformGrid Columns="2" Margin="0,0,0,15">
                <Button x:Name="BtnStart" Content="🚀 روشن کردن هات‌اسپات" Style="{StaticResource ActionBtn}"
                        Background="#3B82F6" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="13" Height="42" Margin="0,0,4,0"
                        IsEnabled="False" Click="BtnStart_Click"/>

                <Button x:Name="BtnStop" Content="⏹ توقف و قطع" Style="{StaticResource ActionBtn}"
                        Background="#EF4444" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="13" Height="42" Margin="4,0,0,0"
                        IsEnabled="False" Click="BtnStop_Click"/>
            </UniformGrid>

            <TextBlock x:Name="StatusText" Text="منتظر اتصال پایدار VPN..." Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
            <Button x:Name="BtnTutorial" Content="💡 راهنمای اشتراک‌گذاری دستی اینترنت (مخصوص IKEv2/L2TP/SSTP)" Visibility="Collapsed" Background="#FEF3C7" Foreground="#B45309" BorderBrush="#F59E0B" BorderThickness="1" Cursor="Hand" Margin="0,0,0,15" Padding="5,8" Click="BtnTutorial_Click" FontWeight="Bold" FontSize="11">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Border x:Name="InfoContainer" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="نام شبکه (SSID):" Foreground="{DynamicResource SubTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DisplaySsidText" Text="-" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="Bold" FontFamily="Consolas" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="رمز عبور (Password):" Foreground="{DynamicResource SubTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DisplayPassText" Text="-" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="Bold" FontFamily="Consolas" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <Border x:Name="QrContainer" Background="White" CornerRadius="10" Padding="12" Visibility="Collapsed" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="📱 اسکن برای اتصال سریع" Foreground="#0F172A" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                    <Image x:Name="QrImage" Width="145" Height="145" Stretch="Uniform"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>






